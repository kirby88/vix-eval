+    def _patch_reader(self, flows_per_file):
+        """Return a context manager that patches FlowReader to yield given flows."""
+        readers = iter(flows_per_file)
+
+        class FakeReader:
+            def __init__(self, file_handle):
+                self._flows = next(readers)
+
+            def stream(self):
+                return iter(self._flows)
+
+        return patch.object(export_flows, "FlowReader", new=FakeReader)
