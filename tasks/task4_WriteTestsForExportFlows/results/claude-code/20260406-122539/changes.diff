+class TestCountWhitespaceStats:
+    def test_empty_string(self):
+        r = export_flows.count_whitespace_stats("")
+        assert r == {"line_returns_count": 0, "unnecessary_space_count": 0, "total_chars": 0}
+
+    def test_no_whitespace(self):
+        r = export_flows.count_whitespace_stats("hello")
+        assert r["line_returns_count"] == 0
+        assert r["unnecessary_space_count"] == 0
+        assert r["total_chars"] == 5
+
+    def test_newlines_only(self):
+        r = export_flows.count_whitespace_stats("a\nb\nc")
+        assert r["line_returns_count"] == 2
+        assert r["unnecessary_space_count"] == 0
+
+    def test_double_space(self):
+        r = export_flows.count_whitespace_stats("a  b")
+        assert r["unnecessary_space_count"] == 1  # run of 2: 2-1=1
+
+    def test_triple_space(self):
+        r = export_flows.count_whitespace_stats("a   b")
+        assert r["unnecessary_space_count"] == 2  # run of 3: 3-1=2
+
+    def test_two_separate_runs(self):
+        r = export_flows.count_whitespace_stats("a  b  c")
+        assert r["unnecessary_space_count"] == 2  # two runs of 2
+
+    def test_single_space_not_counted(self):
+        r = export_flows.count_whitespace_stats("a b c")
+        assert r["unnecessary_space_count"] == 0
+
+    def test_mixed_newlines_and_spaces(self):
+        r = export_flows.count_whitespace_stats("a  b\nc  d\n")
+        assert r["line_returns_count"] == 2
+        assert r["unnecessary_space_count"] == 2
+
+    def test_total_chars_is_len(self):
+        text = "hello\n"
+        r = export_flows.count_whitespace_stats(text)
+        assert r["total_chars"] == len(text)
+
