+class TestSanitizePath:
+    def test_simple_path(self):
+        assert export_flows.sanitize_path("/v1/messages") == "v1_messages"
+
+    def test_strips_query_string(self):
+        assert export_flows.sanitize_path("/v1/messages?foo=bar") == "v1_messages"
+
+    def test_replaces_slashes(self):
+        assert export_flows.sanitize_path("/a/b/c") == "a_b_c"
+
+    def test_strips_leading_trailing_underscores(self):
+        assert export_flows.sanitize_path("/foo/") == "foo"
+
+    def test_removes_special_chars(self):
+        result = export_flows.sanitize_path("/v1/mes$ages!")
+        assert "$" not in result
+        assert "!" not in result
+
+    def test_keeps_hyphens_and_digits(self):
+        assert export_flows.sanitize_path("/v1-api/abc-123") == "v1-api_abc-123"
+
+    def test_truncates_to_80_chars(self):
+        long_path = "/a" + "b" * 100
+        result = export_flows.sanitize_path(long_path)
+        assert len(result) <= 80
+
+    def test_empty_string(self):
+        assert export_flows.sanitize_path("") == ""
+
+    def test_query_only(self):
+        result = export_flows.sanitize_path("?foo=bar")
+        assert result == ""
