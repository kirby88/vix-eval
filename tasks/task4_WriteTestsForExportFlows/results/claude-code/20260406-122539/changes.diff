+class TestMain:
+    def test_main_calls_all_pipeline_functions(self):
+        import contextlib
+        funcs = [
+            "redact_flow_files",
+            "export_flows",
+            "extract_usage",
+            "export_parsed_responses",
+            "extract_prompts",
+            "calculate_costs",
+            "extract_source_attribution",
+            "summarize_usage",
+        ]
+        mocks = {f: MagicMock() for f in funcs}
+
+        with contextlib.ExitStack() as stack:
+            mock_parse = stack.enter_context(patch("argparse.ArgumentParser.parse_args"))
+            mock_parse.return_value = MagicMock(
+                input_directory="/tmp/in",
+                output_directory="/tmp/out",
+            )
+            stack.enter_context(patch("os.makedirs"))
+            for f in funcs:
+                stack.enter_context(patch.object(export_flows, f, mocks[f]))
+            export_flows.main()
+
+        for f in funcs:
+            mocks[f].assert_called_once()
+
+    def test_main_accepts_custom_directories(self):
+        custom_in = "/custom/input"
+        custom_out = "/custom/output"
+
+        with patch("argparse.ArgumentParser.parse_args") as mock_parse, \
+             patch.object(export_flows, "redact_flow_files") as m_redact, \
+             patch.object(export_flows, "export_flows") as m_export, \
+             patch.object(export_flows, "extract_usage"), \
+             patch.object(export_flows, "export_parsed_responses"), \
+             patch.object(export_flows, "extract_prompts"), \
+             patch.object(export_flows, "calculate_costs"), \
+             patch.object(export_flows, "extract_source_attribution"), \
+             patch.object(export_flows, "summarize_usage"), \
+             patch("os.makedirs"):
+            mock_parse.return_value = MagicMock(
+                input_directory=custom_in,
+                output_directory=custom_out,
+            )
+            export_flows.main()
+
+        m_redact.assert_called_once_with(custom_in)
+        m_export.assert_called_once_with(custom_in, custom_out)
