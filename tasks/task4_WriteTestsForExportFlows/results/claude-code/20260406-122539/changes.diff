+"""Comprehensive test suite for export_flows.py.
+
+mitmproxy is mocked at the sys.modules level before import so that
+the module-level `from mitmproxy.io import ...` succeeds without the
+real library installed.
+"""
+
+import hashlib
+import json
+import os
+import sys
+from unittest.mock import MagicMock, patch
+
+# ---------------------------------------------------------------------------
+# Stub mitmproxy BEFORE importing export_flows
+# ---------------------------------------------------------------------------
+
+class _FakeFlowReadException(Exception):
+    """Real exception class so `except FlowReadException` clauses work."""
+
+
+_mock_mitmproxy = MagicMock()
+_mock_io = MagicMock()
+_mock_http = MagicMock()
+_mock_exceptions = MagicMock()
+_mock_exceptions.FlowReadException = _FakeFlowReadException
+
+sys.modules.setdefault("mitmproxy", _mock_mitmproxy)
+sys.modules.setdefault("mitmproxy.io", _mock_io)
+sys.modules.setdefault("mitmproxy.http", _mock_http)
+sys.modules.setdefault("mitmproxy.exceptions", _mock_exceptions)
+
+import export_flows  # noqa: E402 – must come after sys.modules patching
+
+# Patch the imported names so except/isinstance clauses resolve correctly.
+export_flows.FlowReadException = _FakeFlowReadException
+
+
+# ---------------------------------------------------------------------------
+# A concrete HTTPFlow replacement so isinstance() checks work
+# ---------------------------------------------------------------------------
+
+class _RealHTTPFlow:
+    """Minimal stand-in for mitmproxy.http.HTTPFlow."""
+
+
+export_flows.HTTPFlow = _RealHTTPFlow  # type: ignore[assignment]
+
+
+# ---------------------------------------------------------------------------
+# Helper to build a mock flow instance
+# ---------------------------------------------------------------------------
+
+def _make_flow(
+    method="POST",
+    url="https://api.anthropic.com/v1/messages",
+    body_text='{"messages": []}',
+    response_code=200,
+    response_reason="OK",
+    response_body="",
+    req_headers=None,
+    resp_headers=None,
+    req_timestamp=1000.0,
+    resp_timestamp=1001.5,
+):
+    """Return a MagicMock that passes isinstance(_RealHTTPFlow) checks.
+
+    We use a plain MagicMock (no spec) so attributes are freely settable,
+    and manually override __class__ to make isinstance checks pass.
+    """
+    flow = MagicMock()
+    flow.__class__ = _RealHTTPFlow
+
+    flow.request.method = method
+    flow.request.pretty_url = url
+    flow.request.get_text.return_value = body_text
+    flow.request.timestamp_start = req_timestamp
+    flow.request.headers.fields = req_headers or []
+
+    flow.response.status_code = response_code
+    flow.response.reason = response_reason
+    flow.response.get_text.return_value = response_body
+    flow.response.timestamp_end = resp_timestamp
+    flow.response.headers.fields = resp_headers or []
+
+    return flow
+
+
