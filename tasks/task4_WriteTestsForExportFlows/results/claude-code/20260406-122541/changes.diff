+class TestSystemPromptHash:
+    def test_cc_agent_uses_index_2(self):
+        body = {
+            "system": [
+                {"type": "text", "text": "zero"},
+                {"type": "text", "text": "one"},
+                {"type": "text", "text": "two"},
+            ]
+        }
+        h = ef._system_prompt_hash(body, "cc")
+        import hashlib
+        expected = hashlib.sha256("two".encode()).hexdigest()[:12]
+        assert h == expected
+
+    def test_vix_agent_uses_index_0(self):
+        body = {"system": [{"type": "text", "text": "first"}]}
+        h = ef._system_prompt_hash(body, "vix")
+        import hashlib
+        expected = hashlib.sha256("first".encode()).hexdigest()[:12]
+        assert h == expected
+
+    def test_no_system_returns_none(self):
+        assert ef._system_prompt_hash({}, "cc") is None
+
+    def test_empty_system_list(self):
+        assert ef._system_prompt_hash({"system": []}, "cc") is None
+
+    def test_index_out_of_bounds(self):
+        body = {"system": [{"type": "text", "text": "only"}]}
+        # cc uses index 2, but list has only 1 element
+        assert ef._system_prompt_hash(body, "cc") is None
+
+    def test_empty_text_returns_none(self):
+        body = {"system": [{"type": "text", "text": ""}]}
+        assert ef._system_prompt_hash(body, "vix") is None
+
+    def test_unknown_agent_defaults_to_index_0(self):
+        body = {"system": [{"type": "text", "text": "hello"}]}
+        h = ef._system_prompt_hash(body, "unknown_agent")
+        assert h is not None
