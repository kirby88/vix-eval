+class TestSummarizeUsage:
+    def _create_agent_dir(self, base, agent_name, steps):
+        """Create a fake agent directory with numbered step/request dirs.
+        steps: list of dicts {step: int, req: int, usage: dict}
+        """
+        agent_dir = base / agent_name
+        agent_dir.mkdir()
+        for item in steps:
+            d = agent_dir / str(item["step"]) / str(item["req"])
+            d.mkdir(parents=True, exist_ok=True)
+            (d / "usage.json").write_text(json.dumps(item["usage"]))
