+def _make_response_sse(stop_reason="end_turn", usage=None, extra_events=None):
+    """Build a minimal SSE response_raw.txt string."""
+    if usage is None:
+        usage = {"input_tokens": 10, "output_tokens": 5}
+    lines = [
+        "HTTP/1.1 200 OK",
+        "",
+        "content-type: text/event-stream",
+        "",
+        'data: {"type":"message_start","message":{"usage":{"input_tokens":10}}}',
+        'data: {"type":"content_block_start","index":0,"content_block":{"type":"text","name":""}}',
+        'data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"Hello"}}',
+        'data: {"type":"content_block_stop","index":0}',
+        f'data: {{"type":"message_delta","delta":{{"stop_reason":"{stop_reason}"}},"usage":{json.dumps(usage)}}}',
+        'data: {"type":"message_stop"}',
+    ]
+    if extra_events:
+        lines.extend(extra_events)
+    return "\n".join(lines)
+
+
+def _make_response_json(stop_reason="end_turn"):
+    """Build a minimal non-streaming JSON response_raw.txt string."""
+    msg = {
+        "type": "message",
+        "role": "assistant",
+        "content": [{"type": "text", "text": "Hello world"}],
+        "stop_reason": stop_reason,
+        "usage": {"input_tokens": 10, "output_tokens": 5},
+    }
+    return f"HTTP/1.1 200 OK\n\ncontent-type: application/json\n\n{json.dumps(msg)}"
+
