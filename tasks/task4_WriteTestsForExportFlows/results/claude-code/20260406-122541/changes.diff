+
+class TestAttributeTokens:
+    def _pricing(self):
+        return {"input": 3e-6, "cache_write": 3.75e-6, "cache_read": 0.30e-6, "output": 15e-6}
+
+    def _usage(self, input_t=100, cw_t=50, cr_t=20, output_t=30):
+        return {
+            "cost": {
+                "input": {"tokens": input_t, "dollars": input_t * 3e-6},
+                "cache_write": {"tokens": cw_t, "dollars": cw_t * 3.75e-6},
+                "cache_read": {"tokens": cr_t, "dollars": cr_t * 0.30e-6},
+                "output": {"tokens": output_t, "dollars": output_t * 15e-6},
+                "total": {"tokens": input_t + cw_t + cr_t + output_t, "dollars": 0.0},
+            }
+        }
+
+    def test_proportional_output_attribution(self):
+        input_sources = {"total_chars": 1000, "tool_results": {}, "tool_calls": {}}
+        output_sources = {"llm_text": 80, "tool_calls": {"Write": 20}}
+        usage = self._usage()
+        result = ef.attribute_tokens(input_sources, output_sources, usage, self._pricing())
+        out = result["output"]
+        assert "llm_text" in out
+        assert "tool_calls" in out
+        # LLM text gets 80% of output tokens
+        assert out["llm_text"]["tokens"] == round(30 * 0.8)
+
+    def test_zero_total_chars_skips_input(self):
+        input_sources = {"total_chars": 0, "tool_results": {"Read": {"cache_write_chars": 10, "cache_read_chars": 0}}}
+        output_sources = {"llm_text": 0, "tool_calls": {}}
+        usage = self._usage()
+        result = ef.attribute_tokens(input_sources, output_sources, usage, self._pricing())
+        assert result["input"] == {}
+
+    def test_zero_output_tokens_skips_output(self):
+        input_sources = {"total_chars": 500, "tool_results": {}, "tool_calls": {}}
+        output_sources = {"llm_text": 100, "tool_calls": {}}
+        usage = self._usage(output_t=0)
+        result = ef.attribute_tokens(input_sources, output_sources, usage, self._pricing())
+        assert result["output"] == {}
+
+    def test_input_tool_results_attributed(self):
+        input_sources = {
+            "total_chars": 1000,
+            "tool_results": {"Read": {"cache_write_chars": 200, "cache_read_chars": 300}},
+            "tool_calls": {},
+        }
+        output_sources = {"llm_text": 100, "tool_calls": {}}
+        usage = self._usage(input_t=100, cw_t=50, cr_t=20)
+        result = ef.attribute_tokens(input_sources, output_sources, usage, self._pricing())
+        assert "tool_results" in result["input"]
+        assert "Read" in result["input"]["tool_results"]
+
+    def test_no_pricing_skips_input(self):
+        input_sources = {"total_chars": 1000, "tool_results": {"Read": {"cache_write_chars": 100, "cache_read_chars": 0}}}
+        output_sources = {"llm_text": 50, "tool_calls": {}}
+        usage = self._usage()
+        result = ef.attribute_tokens(input_sources, output_sources, usage, None)
+        assert result["input"] == {}
+
