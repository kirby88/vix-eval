+class TestCountWhitespaceStats:
+    def test_empty_string(self):
+        r = ef.count_whitespace_stats("")
+        assert r == {"line_returns_count": 0, "unnecessary_space_count": 0, "total_chars": 0}
+
+    def test_newlines_only(self):
+        r = ef.count_whitespace_stats("a\nb\nc")
+        assert r["line_returns_count"] == 2
+        assert r["unnecessary_space_count"] == 0
+        assert r["total_chars"] == 5
+
+    def test_unnecessary_spaces(self):
+        # "a  b" has one run of 2 spaces → 1 unnecessary space
+        r = ef.count_whitespace_stats("a  b   c")
+        assert r["unnecessary_space_count"] == 1 + 2  # 2-space run: 1, 3-space run: 2
+
+    def test_combined(self):
+        r = ef.count_whitespace_stats("hello\nworld  test")
+        assert r["line_returns_count"] == 1
+        assert r["unnecessary_space_count"] == 1
+        assert r["total_chars"] == len("hello\nworld  test")
+
+    def test_single_space_not_counted(self):
+        r = ef.count_whitespace_stats("a b c")
+        assert r["unnecessary_space_count"] == 0
