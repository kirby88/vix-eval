+class TestWriteRequest:
+    def _make_flow(self, method="POST", url="https://api.example.com/v1/messages", body=None, headers=None):
+        flow = MagicMock()
+        req = MagicMock()
+        req.method = method
+        req.pretty_url = url
+        # Use explicit sentinel: None means use default JSON, "" means truly empty
+        req.get_text.return_value = '{"model":"claude-sonnet-4-6"}' if body is None else body
+        # Headers mock
+        if headers is None:
+            headers = [("content-type", "application/json")]
+        hdr = MagicMock()
+        hdr.fields = [(k.encode(), v.encode()) for k, v in headers]
+        req.headers = hdr
+        flow.request = req
+        return flow
+
+    def test_creates_request_headers_txt(self, tmp_path):
+        flow = self._make_flow()
+        ef.write_request(flow, str(tmp_path))
+        hdr_file = tmp_path / "request_headers.txt"
+        assert hdr_file.exists()
+        content = hdr_file.read_text()
+        assert "POST https://api.example.com/v1/messages" in content
+
+    def test_creates_request_json_pretty_printed(self, tmp_path):
+        flow = self._make_flow(body='{"model":"claude-sonnet-4-6"}')
+        ef.write_request(flow, str(tmp_path))
+        req_file = tmp_path / "request.json"
+        assert req_file.exists()
+        parsed = json.loads(req_file.read_text())
+        assert parsed["model"] == "claude-sonnet-4-6"
+
+    def test_non_json_body_written_raw(self, tmp_path):
+        flow = self._make_flow(body="not json at all")
+        ef.write_request(flow, str(tmp_path))
+        req_file = tmp_path / "request.json"
+        assert req_file.exists()
+        assert req_file.read_text().strip() == "not json at all"
+
+    def test_empty_body_no_request_json(self, tmp_path):
+        flow = self._make_flow(body="")
+        ef.write_request(flow, str(tmp_path))
+        assert not (tmp_path / "request.json").exists()
