dle empty string\n2. `MagicMock(spec=ef.HTTPFlow)` blocks `request`/`response` attributes (they're instance attrs, not class attrs)"},{"type":"tool_use","id":"toolu_014XWA5N3FJ9f88M8jDBQgF8","name":"Edit","input":{"replace_all":false,"file_path":"/workspace/test_export_flows.py","old_string":"    def _make_flow(self, method=\"POST\", url=\"https://api.example.com/v1/messages\", body=None, headers=None):\n        flow = MagicMock()\n        req = MagicMock()\n        req.method = method\n        req.pretty_url = url\n        req.get_text.return_value = body or '{\"model\":\"claude-sonnet-4-6\"}'\n        # Headers mock\n        if headers is None:\n            headers = [(\"content-type\", \"application/json\")]\n        hdr = MagicMock()\n        hdr.fields = [(k.encode(), v.encode()) for k, v in headers]\n        req.headers = hdr\n        flow.request = req\n        return flow","new_string":"    def _make_flow(self, method=\"POST\", url=\"https://api.example.com/v1/messages\", body=None, headers=None):\n        flow = MagicMock()\n        req = MagicMock()\n        req.method = method\n        req.pretty_url = url\n        # Use explicit sentinel: None means use default JSON, \"\" means truly empty\n        req.get_text.return_value = '{\"model\":\"claude-sonnet-4-6\"}' if body is None else body\n        # Headers mock\n        if headers is None:\n            headers = [(\"content-type\", \"application/json\")]\n        hdr = MagicMock()\n        hdr.fields = [(k.encode(), v.encode()) for k, v in headers]\n        req.headers = hdr\n        flow.request = req\n        return flow"}}]},{"role":"user","content":[{"tool_use_id":"toolu_014XWA5N3FJ9f88M8jDBQgF8","type":"tool_result","content":"The file /workspace/test_export_flows.py has been updated successfully."}]},{"role":"assistant","content":[{"type":"text","text":"Now fix the `TestRedactFlowFiles.test_redacts_api_key_header` - the `spec=ef.HTTPFlow` blocks attribute access:"},{"type":"tool_use","id":"toolu_016