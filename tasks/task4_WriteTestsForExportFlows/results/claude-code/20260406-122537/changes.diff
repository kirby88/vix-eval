+                    ],
+                },
+            ]
+        }
+
+    def _write_response(self, tmp_path, write_fp="/test/write.py", content="new code"):
+        sse = make_sse_stream(tool_uses=[("Write", {"file_path": write_fp, "content": content})])
+        p = tmp_path / "response_raw.txt"
+        p.write_text(sse)
+        return str(p)
