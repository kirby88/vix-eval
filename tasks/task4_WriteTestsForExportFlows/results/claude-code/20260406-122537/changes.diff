+"""conftest.py: inject mitmproxy stubs before any module import, then expose shared fixtures."""
+
+import sys
+import os
+import types
+import json
+import pytest
+
+# ---------------------------------------------------------------------------
+# Inject mitmproxy stubs into sys.modules BEFORE export_flows is imported.
+# This must run at import time of conftest.py (i.e., before any test collection).
+# ---------------------------------------------------------------------------
+
+
+class _FakeFlowReadException(Exception):
+    pass
+
+
+class _FakeHTTPFlow:
+    """Minimal stand-in for mitmproxy.http.HTTPFlow."""
+    pass
+
+
+class _FakeFlowReader:
+    def __init__(self, f):
+        pass
+
+    def stream(self):
+        return iter([])
+
+
+class _FakeFlowWriter:
+    def __init__(self, f):
+        pass
+
+    def add(self, flow):
+        pass
+
+
+_mitmproxy_pkg = types.ModuleType("mitmproxy")
+_mitmproxy_io = types.ModuleType("mitmproxy.io")
+_mitmproxy_io.FlowReader = _FakeFlowReader
+_mitmproxy_io.FlowWriter = _FakeFlowWriter
+_mitmproxy_exceptions = types.ModuleType("mitmproxy.exceptions")
+_mitmproxy_exceptions.FlowReadException = _FakeFlowReadException
+_mitmproxy_http = types.ModuleType("mitmproxy.http")
+_mitmproxy_http.HTTPFlow = _FakeHTTPFlow
+
+sys.modules.setdefault("mitmproxy", _mitmproxy_pkg)
+sys.modules.setdefault("mitmproxy.io", _mitmproxy_io)
+sys.modules.setdefault("mitmproxy.exceptions", _mitmproxy_exceptions)
+sys.modules.setdefault("mitmproxy.http", _mitmproxy_http)
+
+# Add workspace root to path so `import export_flows` works
+_WORKSPACE = os.path.normpath(os.path.join(os.path.dirname(__file__), "..", ".."))
+if _WORKSPACE not in sys.path:
+    sys.path.insert(0, _WORKSPACE)
+
+# Expose stub classes so tests can reference them
+FAKE_HTTPFlow = _FakeHTTPFlow
+FAKE_FlowReadException = _FakeFlowReadException
+
+
+# ---------------------------------------------------------------------------
+# Shared helper classes
+# ---------------------------------------------------------------------------
+
+
+class FakeHeaders:
+    """Minimal stand-in for mitmproxy Headers with .fields and .get()."""
+
+    def __init__(self, fields=None):
+        # fields: list of (bytes, bytes) tuples
+        self.fields = fields or []
+        self._map = {k.lower(): v for k, v in self.fields}
+
+    def get(self, key, default=None):
+        if isinstance(key, str):
+            key = key.encode()
+        return self._map.get(key.lower(), default)
+
+    def __setitem__(self, key, value):
+        if isinstance(key, str):
+            key = key.encode()
+        self._map[key.lower()] = value
+        # Update fields list
+        self.fields = [(k, v) if k.lower() != key.lower() else (key, value)
+                       for k, v in self.fields]
+        if key.lower() not in [k.lower() for k, _ in self.fields]:
+            self.fields.append((key, value))
+
+
+class FakeRequest:
+    def __init__(self, url="https://api.anthropic.com/v1/messages",
+                 body_dict=None, body_text=None, method="POST",
+                 headers=None):
+        self.method = method
+        self.pretty_url = url
+        self.timestamp_start = 1700000000.0
+        if headers is not None:
+            self.headers = headers
+        else:
+            self.headers = FakeHeaders([
+                (b"content-type", b"application/json"),
+            ])
+        if body_text is not None:
+            self._body = body_text
+        elif body_dict is not None:
+            self._body = json.dumps(body_dict)
+        else:
+            self._body = ""
+
+    def get_text(self, strict=False):
+        return self._body
+
+
+class FakeResponse:
+    def __init__(self, text="", status_code=200, reason="OK", headers=None):
+        self.status_code = status_code
+        self.reason = reason
+        self.timestamp_end = 1700000001.5
+        if headers is not None:
+            self.headers = headers
+        else:
+            self.headers = FakeHeaders([(b"content-type", b"text/event-stream")])
+        self._text = text
+
+    def get_text(self, strict=False):
+        return self._text
+
+
