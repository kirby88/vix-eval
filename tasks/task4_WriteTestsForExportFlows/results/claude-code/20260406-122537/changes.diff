+# ---------------------------------------------------------------------------
+# TestSystemPromptHash
+# ---------------------------------------------------------------------------
+
+
+class TestSystemPromptHash:
+    def _body(self, system_blocks):
+        return {"system": system_blocks}
+
+    def test_cc_uses_index_2(self, ef):
+        blocks = [
+            {"type": "text", "text": "block0"},
+            {"type": "text", "text": "block1"},
+            {"type": "text", "text": "target_block"},
+        ]
+        result = ef._system_prompt_hash(self._body(blocks), "cc")
+        expected = hashlib.sha256("target_block".encode()).hexdigest()[:12]
+        assert result == expected
+
+    def test_vix_uses_index_0(self, ef):
+        blocks = [{"type": "text", "text": "vix_prompt"}]
+        result = ef._system_prompt_hash(self._body(blocks), "vix")
+        expected = hashlib.sha256("vix_prompt".encode()).hexdigest()[:12]
+        assert result == expected
+
+    def test_unknown_agent_defaults_to_index_0(self, ef):
+        blocks = [{"type": "text", "text": "default_prompt"}]
+        result = ef._system_prompt_hash(self._body(blocks), "other_agent")
+        expected = hashlib.sha256("default_prompt".encode()).hexdigest()[:12]
+        assert result == expected
+
+    def test_index_out_of_bounds_returns_none(self, ef):
+        # cc uses index 2; if system has only 1 block -> None
+        blocks = [{"type": "text", "text": "only_one"}]
+        assert ef._system_prompt_hash(self._body(blocks), "cc") is None
+
+    def test_no_system_key_returns_none(self, ef):
+        assert ef._system_prompt_hash({"messages": []}, "cc") is None
+
+    def test_empty_system_list_returns_none(self, ef):
+        assert ef._system_prompt_hash(self._body([]), "vix") is None
+
+    def test_empty_text_returns_none(self, ef):
+        blocks = [{"type": "text", "text": ""}]
+        assert ef._system_prompt_hash(self._body(blocks), "vix") is None
+
+    def test_returns_12_char_hex(self, ef):
+        blocks = [{"type": "text", "text": "some prompt text"}]
+        result = ef._system_prompt_hash(self._body(blocks), "vix")
+        assert result is not None
+        assert len(result) == 12
+        assert all(c in "0123456789abcdef" for c in result)
+
+    def test_deterministic(self, ef):
+        blocks = [{"type": "text", "text": "deterministic"}]
+        r1 = ef._system_prompt_hash(self._body(blocks), "vix")
+        r2 = ef._system_prompt_hash(self._body(blocks), "vix")
+        assert r1 == r2
+
+    def test_different_texts_different_hashes(self, ef):
+        b1 = [{"type": "text", "text": "prompt_a"}]
+        b2 = [{"type": "text", "text": "prompt_b"}]
+        assert ef._system_prompt_hash(self._body(b1), "vix") != ef._system_prompt_hash(self._body(b2), "vix")
