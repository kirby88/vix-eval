+# ---------------------------------------------------------------------------
+# TestSummarizeUsage
+# ---------------------------------------------------------------------------
+
+
+class TestSummarizeUsage:
+    def _make_usage_json(self, model="claude-sonnet-4-5", input_tokens=100, output_tokens=50,
+                          duration_ms=500, request_start=1700000000.0, response_end=1700000001.0,
+                          by_source=None, read_file_whitespace=None, file_ops=None):
+        usage = {
+            "model": model,
+            "cost": {
+                "input": {"tokens": input_tokens, "dollars": input_tokens * 3e-6},
+                "cache_write": {"tokens": 0, "dollars": 0.0},
+                "cache_read": {"tokens": 0, "dollars": 0.0},
+                "output": {"tokens": output_tokens, "dollars": output_tokens * 15e-6},
+                "total": {"tokens": input_tokens + output_tokens,
+                          "dollars": (input_tokens * 3e-6 + output_tokens * 15e-6)},
+            },
+            "timing": {
+                "duration_ms": duration_ms,
+                "request_start": request_start,
+                "response_end": response_end,
+            },
+        }
+        if by_source:
+            usage["by_source"] = by_source
+        if read_file_whitespace:
+            usage["read_file_whitespace"] = read_file_whitespace
+        if file_ops:
+            usage["file_ops"] = file_ops
+        return usage
+
+    def _setup_agent(self, base, agent_name, steps):
+        """steps: list of list of usage dicts (one list per step)."""
+        agent_dir = base / agent_name
+        for step_i, reqs in enumerate(steps, start=1):
+            for req_i, usage in enumerate(reqs, start=1):
+                req_dir = agent_dir / str(step_i) / str(req_i)
+                req_dir.mkdir(parents=True)
+                (req_dir / "usage.json").write_text(json.dumps(usage))
+        return agent_dir
+
+    def test_writes_usage_json(self, ef, tmp_path):
+        u = self._make_usage_json()
+        self._setup_agent(tmp_path, "vix", [[u]])
+        ef.summarize_usage(str(tmp_path))
+        assert (tmp_path / "vix" / "usage.json").exists()
+
+    def test_request_count(self, ef, tmp_path):
+        u1 = self._make_usage_json(input_tokens=100)
+        u2 = self._make_usage_json(input_tokens=200)
+        self._setup_agent(tmp_path, "vix", [[u1, u2]])
+        ef.summarize_usage(str(tmp_path))
+        summary = json.loads((tmp_path / "vix" / "usage.json").read_text())
+        assert summary["total"]["request_count"] == 2
+
+    def test_by_model_aggregation(self, ef, tmp_path):
+        u1 = self._make_usage_json(model="claude-sonnet-4-5", input_tokens=100)
+        u2 = self._make_usage_json(model="claude-haiku-4-5", input_tokens=50)
+        self._setup_agent(tmp_path, "vix", [[u1, u2]])
+        ef.summarize_usage(str(tmp_path))
+        summary = json.loads((tmp_path / "vix" / "usage.json").read_text())
+        assert "claude-sonnet-4-5" in summary["by_model"]
+        assert "claude-haiku-4-5" in summary["by_model"]
+
+    def test_by_step_aggregation(self, ef, tmp_path):
+        u1 = self._make_usage_json(input_tokens=100)
+        u2 = self._make_usage_json(input_tokens=200)
+        self._setup_agent(tmp_path, "vix", [[u1], [u2]])
+        ef.summarize_usage(str(tmp_path))
+        summary = json.loads((tmp_path / "vix" / "usage.json").read_text())
+        assert "1" in summary["by_step"]
+        assert "2" in summary["by_step"]
