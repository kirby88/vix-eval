+    """Factory fixture: returns a function that creates mock HTTPFlow instances."""
+    def _make(url="https://api.anthropic.com/v1/messages",
+              body_dict=None, body_text=None,
+              response_text="", has_response=True,
+              method="POST", req_headers=None, resp_headers=None):
+        flow = _FakeHTTPFlow.__new__(_FakeHTTPFlow)
+        flow.request = FakeRequest(url, body_dict=body_dict, body_text=body_text,
+                                   method=method, headers=req_headers)
+        if has_response:
+            flow.response = FakeResponse(response_text, headers=resp_headers)
+        else:
+            flow.response = None
+        return flow
+
+    return _make
