+class TestCategorizeInputSources:
+    def _multi_turn_body(self):
+        """3 messages: user0 (tool_result), assistant1 (tool_use), user2 (tool_result - LAST)."""
+        return {
+            "messages": [
+                {
+                    "role": "user",
+                    "content": [
+                        {"type": "tool_result", "tool_use_id": "early_id",
+                         "content": "early result text"}
+                    ],
+                },
+                {
+                    "role": "assistant",
+                    "content": [
+                        {"type": "tool_use", "id": "new_id", "name": "Read",
+                         "input": {"file_path": "/x.py"}}
+                    ],
+                },
+                {
+                    "role": "user",
+                    "content": [
+                        {"type": "tool_result", "tool_use_id": "new_id",
+                         "content": "last user result text"}
+                    ],
+                },
+            ]
+        }
+
+    def test_last_user_message_is_cache_write(self, ef):
+        body = self._multi_turn_body()
+        result = ef.categorize_input_sources(body)
+        # "new_id" -> Read tool; last user msg -> cache_write
+        read_tr = result["tool_results"].get("Read", {})
+        assert read_tr.get("cache_write_chars", 0) > 0
+        assert read_tr.get("cache_read_chars", 0) == 0
+
+    def test_earlier_user_messages_are_cache_read(self, ef):
+        body = self._multi_turn_body()
+        result = ef.categorize_input_sources(body)
+        unknown_tr = result["tool_results"].get("unknown", {})
+        assert unknown_tr.get("cache_read_chars", 0) > 0
+        assert unknown_tr.get("cache_write_chars", 0) == 0
+
+    def test_second_to_last_assistant_tool_use_is_cache_write(self, ef):
+        # 5-message: user, assistant(early), user, assistant(second-to-last), user(last)
+        body = {
+            "messages": [
+                {"role": "user", "content": "hi"},
+                {"role": "assistant", "content": [
+                    {"type": "tool_use", "id": "early", "name": "Write",
+                     "input": {"file_path": "/f.py"}}
+                ]},
+                {"role": "user", "content": [
+                    {"type": "tool_result", "tool_use_id": "early", "content": "ok"}
+                ]},
+                {"role": "assistant", "content": [
+                    {"type": "tool_use", "id": "recent", "name": "Read",
+                     "input": {"file_path": "/g.py"}}
+                ]},
+                {"role": "user", "content": [
+                    {"type": "tool_result", "tool_use_id": "recent", "content": "ok2"}
+                ]},
+            ]
+        }
+        result = ef.categorize_input_sources(body)
+        # second-to-last assistant (index 3) -> cache_write for tool_use
+        read_tc = result["tool_calls"].get("Read", {})
+        assert read_tc.get("cache_write_chars", 0) > 0
+
+    def test_earlier_assistant_tool_use_is_cache_read(self, ef):
+        body = {
+            "messages": [
+                {"role": "user", "content": "hi"},
+                {"role": "assistant", "content": [
+                    {"type": "tool_use", "id": "early", "name": "Write",
+                     "input": {"file_path": "/f.py"}}
+                ]},
+                {"role": "user", "content": [
+                    {"type": "tool_result", "tool_use_id": "early", "content": "ok"}
+                ]},
+                {"role": "assistant", "content": [
+                    {"type": "tool_use", "id": "recent", "name": "Read",
+                     "input": {"file_path": "/g.py"}}
+                ]},
+                {"role": "user", "content": [
+                    {"type": "tool_result", "tool_use_id": "recent", "content": "ok2"}
+                ]},
+            ]
+        }
+        result = ef.categorize_input_sources(body)
+        # early assistant (index 1) -> cache_read for tool_use
+        write_tc = result["tool_calls"].get("Write", {})
+        assert write_tc.get("cache_read_chars", 0) > 0
+
+    def test_total_chars_equals_json_dumps(self, ef):
+        body = self._multi_turn_body()
+        result = ef.categorize_input_sources(body)
+        assert result["total_chars"] == len(json.dumps(body))
+
+    def test_empty_messages(self, ef):
+        body = {"messages": []}
+        result = ef.categorize_input_sources(body)
+        assert result["tool_results"] == {}
+        assert result["tool_calls"] == {}
+
+    def test_non_list_content_skipped(self, ef):
+        # String content in user message should not crash
+        body = {
+            "messages": [
+                {"role": "user", "content": "plain string"},
+            ]
+        }
+        result = ef.categorize_input_sources(body)
+        assert result["tool_results"] == {}
