+"""Comprehensive pytest test suite for export_flows.py.
+
+Targets ≥80% code coverage. mitmproxy stubs are injected by conftest.py before
+this module is imported, so `import export_flows` succeeds even without mitmproxy.
+"""
+
+import hashlib
+import json
+import os
+import sys
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+# conftest.py already set up sys.path and stub modules; import the module under test
+# at module-level so @pytest.mark.parametrize can reference its attributes.
+import export_flows as _ef
+
+# Pull in conftest helpers for use in test helpers
+from conftest import FakeHeaders, FakeRequest, FakeResponse, FAKE_HTTPFlow, FAKE_FlowReadException
+
+
+# ---------------------------------------------------------------------------
+# Helpers / builders used across multiple test classes
+# ---------------------------------------------------------------------------
+
+
+def make_sse_response(stop_reason="end_turn", usage=None, extra_lines=""):
+    """Build a minimal SSE response string with a message_delta event."""
+    if usage is None:
+        usage = {"input_tokens": 100, "output_tokens": 50,
+                 "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0}
+    delta_payload = json.dumps({
+        "type": "message_delta",
+        "delta": {"stop_reason": stop_reason, "stop_sequence": None},
+        "usage": usage,
+    })
+    return f"data: {delta_payload}\n{extra_lines}"
+
+
+def make_non_streaming_response(stop_reason="end_turn", usage=None, content=None):
+    """Build a minimal non-streaming JSON response."""
+    if usage is None:
+        usage = {"input_tokens": 100, "output_tokens": 50,
+                 "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0}
+    if content is None:
+        content = [{"type": "text", "text": "Hello world"}]
+    msg = {
+        "type": "message",
+        "stop_reason": stop_reason,
+        "usage": usage,
+        "content": content,
+        "model": "claude-sonnet-4-5",
+    }
+    return json.dumps(msg)
+
+
+def write_files(dirpath, request_body=None, usage=None, response_raw=None):
+    """Write request.json, usage.json, response_raw.txt to dirpath."""
+    if request_body is not None:
+        with open(os.path.join(dirpath, "request.json"), "w") as f:
+            json.dump(request_body, f)
+            f.write("\n")
+    if usage is not None:
+        with open(os.path.join(dirpath, "usage.json"), "w") as f:
+            json.dump(usage, f)
+            f.write("\n")
+    if response_raw is not None:
+        with open(os.path.join(dirpath, "response_raw.txt"), "w") as f:
+            f.write(response_raw)
+
+
+def make_sse_stream(text_chunks=None, tool_uses=None):
+    """Build SSE stream lines for content blocks.
+
+    text_chunks: list of str — will be emitted as text_delta events for block index 0
+    tool_uses: list of (name, input_dict) — emitted at subsequent indices
+    """
+    lines = []
+    idx = 0
+
+    if text_chunks:
+        lines.append(f'data: {json.dumps({"type": "content_block_start", "index": idx, "content_block": {"type": "text", "text": ""}})}')
+        for chunk in text_chunks:
+            lines.append(f'data: {json.dumps({"type": "content_block_delta", "index": idx, "delta": {"type": "text_delta", "text": chunk}})}')
+        lines.append(f'data: {json.dumps({"type": "content_block_stop", "index": idx})}')
+        idx += 1
+
+    for (name, input_dict) in (tool_uses or []):
+        partial = json.dumps(input_dict)
+        lines.append(f'data: {json.dumps({"type": "content_block_start", "index": idx, "content_block": {"type": "tool_use", "id": f"tu_{idx}", "name": name}})}')
+        lines.append(f'data: {json.dumps({"type": "content_block_delta", "index": idx, "delta": {"type": "input_json_delta", "partial_json": partial}})}')
+        lines.append(f'data: {json.dumps({"type": "content_block_stop", "index": idx})}')
+        idx += 1
+
+    return "\n".join(lines)
+
