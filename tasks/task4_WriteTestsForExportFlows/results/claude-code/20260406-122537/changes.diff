+class TestAttributeTokens:
+    def _pricing(self):
+        return {"input": 3e-6, "cache_write": 3.75e-6, "cache_read": 0.30e-6, "output": 15e-6}
+
+    def _usage(self, input_tokens=1000, cache_write=200, cache_read=500, output_tokens=100):
+        return {
+            "cost": {
+                "input": {"tokens": input_tokens, "dollars": input_tokens * 3e-6},
+                "cache_write": {"tokens": cache_write, "dollars": cache_write * 3.75e-6},
+                "cache_read": {"tokens": cache_read, "dollars": cache_read * 0.30e-6},
+                "output": {"tokens": output_tokens, "dollars": output_tokens * 15e-6},
+                "total": {"tokens": input_tokens + cache_write + cache_read + output_tokens,
+                          "dollars": 0.0},
+            }
+        }
+
+    def test_zero_total_chars_empty_input(self, ef):
+        result = ef.attribute_tokens(
+            {"total_chars": 0, "tool_results": {}, "tool_calls": {}},
+            {"llm_text": 100, "tool_calls": {}},
+            self._usage(),
+            self._pricing(),
+        )
+        assert result["input"] == {}
+
+    def test_zero_output_tokens_empty_output(self, ef):
+        result = ef.attribute_tokens(
+            {"total_chars": 1000, "tool_results": {"Read": {"cache_write_chars": 100, "cache_read_chars": 0}}, "tool_calls": {}},
+            {"llm_text": 0, "tool_calls": {}},
+            self._usage(output_tokens=0),
+            self._pricing(),
+        )
+        assert result["output"] == {}
+
+    def test_none_pricing_empty_input(self, ef):
+        result = ef.attribute_tokens(
+            {"total_chars": 1000, "tool_results": {"Read": {"cache_write_chars": 500, "cache_read_chars": 500}}, "tool_calls": {}},
+            {"llm_text": 100, "tool_calls": {}},
+            self._usage(),
+            None,
+        )
+        assert result["input"] == {}
+
+    def test_proportional_output_attribution(self, ef):
+        output_sources = {"llm_text": 500, "tool_calls": {"Write": 500}}
+        usage = self._usage(output_tokens=100)
+        result = ef.attribute_tokens(
+            {"total_chars": 1000, "tool_results": {}, "tool_calls": {}},
+            output_sources,
+            usage,
+            self._pricing(),
+        )
+        # 50/50 split
+        llm = result["output"]["llm_text"]
+        assert llm["tokens"] == 50
+        assert llm["chars"] == 500
+
+    def test_output_total_in_tool_calls(self, ef):
+        output_sources = {"llm_text": 100, "tool_calls": {"Write": 900}}
+        usage = self._usage(output_tokens=100)
+        result = ef.attribute_tokens(
+            {"total_chars": 1000, "tool_results": {}, "tool_calls": {}},
+            output_sources,
+            usage,
+            self._pricing(),
+        )
+        assert "__total" in result["output"]["tool_calls"]
+
+    def test_input_tool_results_attributed(self, ef):
+        input_sources = {
+            "total_chars": 1000,
+            "tool_results": {"Read": {"cache_write_chars": 500, "cache_read_chars": 0}},
+            "tool_calls": {},
+        }
+        result = ef.attribute_tokens(input_sources, {"llm_text": 0, "tool_calls": {}},
+                                     self._usage(), self._pricing())
+        assert "tool_results" in result["input"]
+        assert "Read" in result["input"]["tool_results"]
+        assert result["input"]["tool_results"]["Read"]["chars"] == 500
+
+    def test_input_tool_calls_attributed(self, ef):
+        input_sources = {
+            "total_chars": 1000,
+            "tool_results": {},
+            "tool_calls": {"Write": {"cache_write_chars": 200, "cache_read_chars": 0}},
+        }
+        result = ef.attribute_tokens(input_sources, {"llm_text": 0, "tool_calls": {}},
+                                     self._usage(), self._pricing())
+        assert "tool_calls" in result["input"]
+        assert "Write" in result["input"]["tool_calls"]
