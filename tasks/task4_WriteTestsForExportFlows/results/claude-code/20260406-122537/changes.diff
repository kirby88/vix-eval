+# ---------------------------------------------------------------------------
+# TestCountWhitespaceStats
+# ---------------------------------------------------------------------------
+
+
+class TestCountWhitespaceStats:
+    def test_empty_string(self, ef):
+        r = ef.count_whitespace_stats("")
+        assert r == {"line_returns_count": 0, "unnecessary_space_count": 0, "total_chars": 0}
+
+    def test_single_newline(self, ef):
+        r = ef.count_whitespace_stats("\n")
+        assert r["line_returns_count"] == 1
+        assert r["unnecessary_space_count"] == 0
+        assert r["total_chars"] == 1
+
+    def test_double_spaces(self, ef):
+        r = ef.count_whitespace_stats("a  b")
+        assert r["unnecessary_space_count"] == 1
+
+    def test_triple_spaces(self, ef):
+        r = ef.count_whitespace_stats("a   b")
+        assert r["unnecessary_space_count"] == 2
+
+    def test_single_space_not_counted(self, ef):
+        r = ef.count_whitespace_stats("a b")
+        assert r["unnecessary_space_count"] == 0
+
+    def test_multiple_runs_accumulated(self, ef):
+        # Two runs: "  " (1 excess) + "    " (3 excess) = 4
+        r = ef.count_whitespace_stats("a  b    c")
+        assert r["unnecessary_space_count"] == 4
+
+    def test_total_chars_accurate(self, ef):
+        text = "hello\nworld  test"
+        r = ef.count_whitespace_stats(text)
+        assert r["total_chars"] == len(text)
+
+    def test_only_spaces(self, ef):
+        r = ef.count_whitespace_stats("     ")
+        assert r["unnecessary_space_count"] == 4
+        assert r["line_returns_count"] == 0
+
+    def test_combined(self, ef):
+        r = ef.count_whitespace_stats("a\nb  c\n  d")
+        assert r["line_returns_count"] == 2  # two \n characters
+        assert r["unnecessary_space_count"] == 2  # "  c" and "  d" each contribute 1
+
