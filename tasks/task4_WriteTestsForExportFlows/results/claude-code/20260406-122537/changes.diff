+class TestExtractReadFileWhitespace:
+    def _body_with_read(self, tool_use_id, tool_name, result_content, mode=None):
+        inp = {"file_path": "/test.py"}
+        if mode:
+            inp["mode"] = mode
+        return {
+            "messages": [
+                {
+                    "role": "assistant",
+                    "content": [
+                        {"type": "tool_use", "id": tool_use_id,
+                         "name": tool_name, "input": inp}
+                    ],
+                },
+                {
+                    "role": "user",
+                    "content": [
+                        {"type": "tool_result", "tool_use_id": tool_use_id,
+                         "content": result_content}
+                    ],
+                },
+            ]
+        }
+
+    def test_read_file_string_content(self, ef):
+        text = "hello\nworld  test"
+        body = self._body_with_read("id1", "read_file", text)
+        ws = ef.extract_read_file_whitespace(body)
+        expected = ef.count_whitespace_stats(text)
+        assert ws == expected
+
+    def test_read_file_list_content(self, ef):
+        text = "line1\nline2"
+        body = self._body_with_read("id1", "read_file",
+                                    [{"type": "text", "text": text}])
+        ws = ef.extract_read_file_whitespace(body)
+        expected = ef.count_whitespace_stats(text)
+        assert ws == expected
+
+    def test_ignores_non_read_tools(self, ef):
+        body = self._body_with_read("id1", "Write", "some content")
+        ws = ef.extract_read_file_whitespace(body)
+        assert ws["total_chars"] == 0
+
+    def test_read_file_compressed_tool(self, ef):
+        text = "compressed content\n"
+        body = self._body_with_read("id1", "read_file", text, mode="compress")
+        ws = ef.extract_read_file_whitespace(body)
+        assert ws["total_chars"] == len(text)
+
+    def test_Read_tool_name(self, ef):
+        text = "Read tool result"
+        body = self._body_with_read("id1", "Read", text)
+        ws = ef.extract_read_file_whitespace(body)
+        assert ws["total_chars"] == len(text)
+
+    def test_accumulates_multiple_reads(self, ef):
+        body = {
+            "messages": [
+                {
+                    "role": "assistant",
+                    "content": [
+                        {"type": "tool_use", "id": "id1", "name": "read_file",
+                         "input": {"file_path": "/a.py"}},
+                        {"type": "tool_use", "id": "id2", "name": "read_file",
+                         "input": {"file_path": "/b.py"}},
+                    ],
+                },
+                {
+                    "role": "user",
+                    "content": [
+                        {"type": "tool_result", "tool_use_id": "id1",
