+        assert "2" in summary["by_step"]
+        assert summary["by_step"]["1"]["cost"]["input"]["tokens"] == 100
+        assert summary["by_step"]["2"]["cost"]["input"]["tokens"] == 200
+
+    def test_by_model_aggregation(self, tmp_path):
+        u1 = self._make_usage(model="claude-sonnet-4-6", input_t=100)
