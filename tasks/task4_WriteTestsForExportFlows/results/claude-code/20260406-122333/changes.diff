+def make_headers_mock(fields):
+    """Return a mock headers object with .fields = [(bytes, bytes), ...]."""
+    h = MagicMock()
+    h.fields = fields
+    return h
+
+
+def make_mock_flow(
+    method="POST",
+    url="https://api.anthropic.com/v1/messages",
+    body='{"model":"claude-sonnet-4-6","messages":[]}',
+    req_headers=None,
+    status=200,
+    reason="OK",
+    response_body="",
+    resp_headers=None,
+    req_ts=1000.0,
+    resp_ts=2000.0,
+    no_response=False,
+):
+    flow = MagicMock()
+    flow.request.method = method
+    flow.request.pretty_url = url
+    flow.request.headers = make_headers_mock(req_headers or [])
+    flow.request.get_text.return_value = body
+    flow.request.timestamp_start = req_ts
+
+    if no_response:
+        flow.response = None
+    else:
+        flow.response.status_code = status
+        flow.response.reason = reason
+        flow.response.headers = make_headers_mock(resp_headers or [])
+        flow.response.get_text.return_value = response_body
+        flow.response.timestamp_end = resp_ts
+    return flow
+
