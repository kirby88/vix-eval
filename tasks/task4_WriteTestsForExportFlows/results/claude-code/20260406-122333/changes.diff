+class TestCountWhitespaceStats:
+    def test_empty_string(self):
+        r = count_whitespace_stats("")
+        assert r == {"line_returns_count": 0, "unnecessary_space_count": 0, "total_chars": 0}
+
+    def test_newlines_only(self):
+        r = count_whitespace_stats("\n\n\n")
+        assert r["line_returns_count"] == 3
+        assert r["unnecessary_space_count"] == 0
+        assert r["total_chars"] == 3
+
+    def test_single_space_not_counted(self):
+        r = count_whitespace_stats("a b c")
+        assert r["unnecessary_space_count"] == 0
+
+    def test_double_space_counts_one(self):
+        r = count_whitespace_stats("a  b")
+        assert r["unnecessary_space_count"] == 1
+
+    def test_four_spaces_counts_three(self):
+        r = count_whitespace_stats("    ")
+        assert r["unnecessary_space_count"] == 3
+
+    def test_two_runs(self):
+        # "  " gives 1, "   " gives 2 → total 3
+        r = count_whitespace_stats("a  b   c")
+        assert r["unnecessary_space_count"] == 3
+
+    def test_total_chars(self):
+        r = count_whitespace_stats("hello")
+        assert r["total_chars"] == 5
+
+    def test_mixed_content(self):
+        r = count_whitespace_stats("line1\nline2  extra\n")
+        assert r["line_returns_count"] == 2
+        assert r["unnecessary_space_count"] == 1
+        assert r["total_chars"] == 19
