+    def test_timing_wall_clock_computed(self, tmp_path):
+        u1 = self._make_usage(req_start=1000.0, resp_end=2000.0, duration_ms=1000000)
+        u2 = self._make_usage(req_start=1500.0, resp_end=3000.0, duration_ms=1500000)
+        self._make_agent_dir(tmp_path, "vix", [[u1, u2]])
+        summarize_usage(str(tmp_path))
+        summary = json.loads((tmp_path / "vix" / "usage.json").read_text())
+        timing = summary["total"]["timing"]
+        # wall_clock_ms = (max_resp_end - min_req_start) * 1000
