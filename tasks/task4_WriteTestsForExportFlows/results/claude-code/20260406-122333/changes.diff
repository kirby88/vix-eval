+class TestSummarizeUsage:
+    def _make_agent_dir(self, base, agent_name, steps):
+        """Create agent/step/request/usage.json structure.
+
+        steps: list of lists of usage dicts (outer = step, inner = requests in that step)
+        """
+        agent_dir = base / agent_name
+        for step_idx, requests in enumerate(steps, 1):
+            for req_idx, usage in enumerate(requests, 1):
+                req_dir = agent_dir / str(step_idx) / str(req_idx)
+                req_dir.mkdir(parents=True)
+                (req_dir / "usage.json").write_text(json.dumps(usage))
+        return agent_dir
+
+    def _make_usage(self, model="claude-sonnet-4-6", input_t=100, output_t=50,
+                    req_start=1000.0, resp_end=2000.0, duration_ms=1000000):
+        return {
+            "model": model,
+            "cost": {
+                "input": {"tokens": input_t, "dollars": input_t * 3e-6},
+                "cache_write": {"tokens": 0, "dollars": 0.0},
+                "cache_read": {"tokens": 0, "dollars": 0.0},
+                "output": {"tokens": output_t, "dollars": output_t * 15e-6},
+                "total": {"tokens": input_t + output_t, "dollars": (input_t * 3e-6 + output_t * 15e-6)},
+            },
+            "timing": {
+                "request_start": req_start,
+                "response_end": resp_end,
+                "duration_ms": duration_ms,
+            },
+        }
+
+    def test_creates_usage_json_for_agent(self, tmp_path):
+        usage = self._make_usage()
+        self._make_agent_dir(tmp_path, "vix", [[usage]])
+        summarize_usage(str(tmp_path))
+        summary_path = tmp_path / "vix" / "usage.json"
+        assert summary_path.exists()
+
+    def test_summary_has_correct_structure(self, tmp_path):
+        usage = self._make_usage()
+        self._make_agent_dir(tmp_path, "vix", [[usage]])
+        summarize_usage(str(tmp_path))
+        summary = json.loads((tmp_path / "vix" / "usage.json").read_text())
+        assert summary["title"] == "vix"
+        assert "by_model" in summary
+        assert "by_step" in summary
+        assert "total" in summary
+        assert "color" in summary
+
+    def test_known_agent_color(self, tmp_path):
+        usage = self._make_usage()
+        self._make_agent_dir(tmp_path, "vix", [[usage]])
+        summarize_usage(str(tmp_path))
+        summary = json.loads((tmp_path / "vix" / "usage.json").read_text())
+        assert summary["color"] == AGENT_COLORS["vix"]
+
+    def test_unknown_agent_gets_md5_color(self, tmp_path):
+        usage = self._make_usage()
+        self._make_agent_dir(tmp_path, "mystery_agent", [[usage]])
+        summarize_usage(str(tmp_path))
+        summary = json.loads((tmp_path / "mystery_agent" / "usage.json").read_text())
+        assert summary["color"].startswith("#")
+        assert len(summary["color"]) == 7
+
+    def test_aggregates_multiple_requests(self, tmp_path):
+        u1 = self._make_usage(input_t=100, output_t=50)
+        u2 = self._make_usage(input_t=200, output_t=80)
+        self._make_agent_dir(tmp_path, "vix", [[u1, u2]])
+        summarize_usage(str(tmp_path))
+        summary = json.loads((tmp_path / "vix" / "usage.json").read_text())
+        total = summary["total"]
+        assert total["request_count"] == 2
+        assert total["cost"]["input"]["tokens"] == 300
+        assert total["cost"]["output"]["tokens"] == 130
+
+    def test_by_step_aggregation(self, tmp_path):
+        u1 = self._make_usage(input_t=100)
