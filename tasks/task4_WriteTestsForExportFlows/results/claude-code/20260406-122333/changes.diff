+class TestAttributeTokens:
+    def _make_usage(self, input_t=100, cw_t=50, cr_t=30, output_t=20,
+                    out_dollars=0.0003):
+        return {
+            "cost": {
+                "input": {"tokens": input_t, "dollars": input_t * 3e-6},
+                "cache_write": {"tokens": cw_t, "dollars": cw_t * 3.75e-6},
+                "cache_read": {"tokens": cr_t, "dollars": cr_t * 0.30e-6},
+                "output": {"tokens": output_t, "dollars": round(out_dollars, 6)},
+            }
+        }
+
+    def _pricing(self):
+        return {"input": 3e-6, "cache_write": 3.75e-6, "cache_read": 0.30e-6, "output": 15e-6}
+
+    def test_output_distributed_proportionally(self):
+        usage = self._make_usage(output_t=100, out_dollars=0.0015)
+        input_sources = {"total_chars": 1000, "tool_results": {}, "tool_calls": {}}
+        output_sources = {"llm_text": 80, "tool_calls": {"Write": 20}}
+        result = attribute_tokens(input_sources, output_sources, usage, self._pricing())
+        llm = result["output"]["llm_text"]
+        assert llm["tokens"] == 80  # 80% of 100
+        assert llm["chars"] == 80
+        tc = result["output"]["tool_calls"]
+        assert "__total" in tc
+        assert tc["Write"]["tokens"] == 20
+
+    def test_zero_total_chars_skips_input(self):
+        usage = self._make_usage()
+        input_sources = {"total_chars": 0, "tool_results": {"Read": {"cache_write_chars": 10, "cache_read_chars": 0}}, "tool_calls": {}}
+        output_sources = {"llm_text": 0, "tool_calls": {}}
+        result = attribute_tokens(input_sources, output_sources, usage, self._pricing())
+        assert result["input"] == {}
+
+    def test_zero_output_chars_skips_output(self):
+        usage = self._make_usage()
+        input_sources = {"total_chars": 1000, "tool_results": {}, "tool_calls": {}}
+        output_sources = {"llm_text": 0, "tool_calls": {}}
+        result = attribute_tokens(input_sources, output_sources, usage, self._pricing())
+        assert result["output"] == {}
+
+    def test_input_tool_results_attributed(self):
+        usage = self._make_usage(input_t=100, cw_t=0, cr_t=0)
+        input_sources = {
+            "total_chars": 1000,
+            "tool_results": {"Read": {"cache_write_chars": 200, "cache_read_chars": 100}},
+            "tool_calls": {},
+        }
+        output_sources = {"llm_text": 0, "tool_calls": {}}
+        result = attribute_tokens(input_sources, output_sources, usage, self._pricing())
+        assert "tool_results" in result["input"]
+        read_entry = result["input"]["tool_results"]["Read"]
+        assert read_entry["chars"] == 300
+
+    def test_empty_tool_results_not_in_output(self):
+        usage = self._make_usage()
