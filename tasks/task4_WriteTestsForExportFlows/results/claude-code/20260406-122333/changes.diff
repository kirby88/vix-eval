+class TestFormatHeaders:
+    def test_regular_header(self):
+        # format_headers does f"{k}: {v}" where k, v are bytes → shows bytes repr
+        headers = make_headers_mock([(b"content-type", b"application/json")])
+        result = format_headers(headers)
+        assert "content-type" in result
+        assert "application/json" in result
+
+    def test_redacts_x_api_key(self):
+        headers = make_headers_mock([(b"x-api-key", b"sk-secret123")])
+        result = format_headers(headers)
+        assert "REDACTED" in result
+        assert "sk-secret123" not in result
+
+    def test_redacts_authorization(self):
+        headers = make_headers_mock([(b"authorization", b"Bearer tok")])
+        result = format_headers(headers)
+        assert "REDACTED" in result
+        assert "Bearer tok" not in result
+
+    def test_multiple_headers(self):
+        headers = make_headers_mock([
+            (b"content-type", b"application/json"),
+            (b"x-api-key", b"secret"),
+            (b"accept", b"*/*"),
+        ])
+        result = format_headers(headers)
+        lines = result.split("\n")
+        assert len(lines) == 3
+        assert "REDACTED" in lines[1]
+        assert "application/json" in lines[0]
+
+    def test_empty_headers(self):
+        headers = make_headers_mock([])
+        assert format_headers(headers) == ""
