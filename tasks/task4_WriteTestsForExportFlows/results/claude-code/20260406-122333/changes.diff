+class TestWriteRequest:
+    def test_creates_request_headers_txt(self, tmp_path):
+        flow = make_mock_flow(
+            method="POST",
+            url="https://api.anthropic.com/v1/messages",
+            body='{"model":"claude-sonnet-4-6"}',
+            req_headers=[(b"content-type", b"application/json")],
+        )
+        write_request(flow, str(tmp_path))
+        headers_file = tmp_path / "request_headers.txt"
+        assert headers_file.exists()
+        content = headers_file.read_text()
+        assert "POST https://api.anthropic.com/v1/messages" in content
+        # format_headers uses f"{k}: {v}" with bytes, so check both key and value appear
+        assert "content-type" in content
+        assert "application/json" in content
+
+    def test_creates_request_json_pretty_printed(self, tmp_path):
+        flow = make_mock_flow(body='{"model":"claude-sonnet-4-6"}')
+        write_request(flow, str(tmp_path))
+        req_json = tmp_path / "request.json"
+        assert req_json.exists()
+        parsed = json.loads(req_json.read_text())
+        assert parsed["model"] == "claude-sonnet-4-6"
+
+    def test_raw_fallback_for_invalid_json(self, tmp_path):
+        flow = make_mock_flow(body="not-json-body")
+        write_request(flow, str(tmp_path))
+        req_json = tmp_path / "request.json"
+        assert req_json.exists()
