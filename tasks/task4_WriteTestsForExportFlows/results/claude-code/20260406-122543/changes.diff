+class TestAttributeTokens:
+    PRICING = {"input": 3e-6, "cache_write": 3.75e-6, "cache_read": 0.3e-6, "output": 15e-6}
+
+    def _usage(self, input_tok=100, cw_tok=50, cr_tok=20, out_tok=30):
+        return {
+            "cost": {
+                "input": {"tokens": input_tok, "dollars": input_tok * self.PRICING["input"]},
+                "cache_write": {"tokens": cw_tok, "dollars": cw_tok * self.PRICING["cache_write"]},
+                "cache_read": {"tokens": cr_tok, "dollars": cr_tok * self.PRICING["cache_read"]},
+                "output": {"tokens": out_tok, "dollars": out_tok * self.PRICING["output"]},
+            }
+        }
+
+    def test_zero_total_chars_skips_input_attribution(self):
+        # total_chars=0 prevents INPUT attribution; output is still attributed
+        result = export_flows.attribute_tokens(
+            {"total_chars": 0, "tool_results": {}, "tool_calls": {}},
+            {"llm_text": 10, "tool_calls": {}},
+            self._usage(out_tok=30),
+            self.PRICING,
+        )
+        assert result["input"] == {}  # no input attribution
+        assert "llm_text" in result["output"]  # output still computed
+
+    def test_zero_total_chars_and_zero_output_fully_empty(self):
+        result = export_flows.attribute_tokens(
+            {"total_chars": 0, "tool_results": {}, "tool_calls": {}},
+            {"llm_text": 0, "tool_calls": {}},
+            self._usage(out_tok=0),
+            self.PRICING,
+        )
+        assert result == {"input": {}, "output": {}}
+
+    def test_none_pricing_skips_input_attribution(self):
+        # pricing=None prevents INPUT attribution; output is still attributed if chars > 0
+        result = export_flows.attribute_tokens(
+            {"total_chars": 100, "tool_results": {"Read": {"cache_write_chars": 50, "cache_read_chars": 50}}, "tool_calls": {}},
+            {"llm_text": 0, "tool_calls": {}},
+            self._usage(out_tok=0),  # no output tokens → no output section
+            None,
+        )
+        assert result == {"input": {}, "output": {}}
+
+    def test_normal_input_attribution(self):
+        result = export_flows.attribute_tokens(
+            {
+                "total_chars": 1000,
+                "tool_results": {"Read": {"cache_write_chars": 500, "cache_read_chars": 500}},
+                "tool_calls": {},
+            },
+            {"llm_text": 0, "tool_calls": {}},
+            self._usage(input_tok=100, cw_tok=0, cr_tok=0, out_tok=0),
+            self.PRICING,
+        )
+        assert "tool_results" in result["input"]
+        assert "Read" in result["input"]["tool_results"]
+        entry = result["input"]["tool_results"]["Read"]
+        assert entry["chars"] == 1000
+        assert entry["tokens"] > 0
+
+    def test_output_attribution_llm_text_only(self):
+        usage = {"cost": {"output": {"tokens": 100, "dollars": 100 * 15e-6}}}
+        result = export_flows.attribute_tokens(
+            {"total_chars": 200, "tool_results": {}, "tool_calls": {}},
+            {"llm_text": 500, "tool_calls": {}},
+            usage,
+            self.PRICING,
+        )
+        assert "llm_text" in result["output"]
+        assert result["output"]["llm_text"]["tokens"] == 100
+
+    def test_output_attribution_mixed(self):
+        usage = {"cost": {"output": {"tokens": 200, "dollars": 0.003}}}
+        result = export_flows.attribute_tokens(
+            {"total_chars": 100, "tool_results": {}, "tool_calls": {}},
