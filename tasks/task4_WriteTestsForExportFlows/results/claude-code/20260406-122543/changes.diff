+
+    def test_tool_use_in_second_to_last_is_cache_write(self):
+        body = {
+            "messages": [
+                {"role": "user", "content": [{"type": "text", "text": "hi"}]},
+                {
+                    "role": "assistant",
+                    "content": [{"type": "tool_use", "id": "t1", "name": "Read", "input": {}}],
+                },
+                {
+                    "role": "user",
+                    "content": [{"type": "tool_result", "tool_use_id": "t1", "content": "data"}],
+                },
+            ]
+        }
+        result = export_flows.categorize_input_sources(body)
+        # second-to-last message (index 1 = assistant) → cache_write for tool_use
