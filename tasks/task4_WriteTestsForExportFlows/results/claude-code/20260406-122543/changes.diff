+"""Comprehensive test suite for export_flows.py.
+
+Mocks mitmproxy at import time so the module loads without the real library.
+Uses pytest tmp_path for filesystem-dependent tests.
+"""
+
+import json
+import os
+import sys
+from unittest.mock import MagicMock, patch, mock_open, call
+import pytest
+
+# ---------------------------------------------------------------------------
+# Mock mitmproxy before importing the module under test.
+# FlowReadException and HTTPFlow must be real Python classes so that
+# isinstance() and except clauses work correctly inside export_flows.py.
+# ---------------------------------------------------------------------------
+
+class _MockFlowReadException(Exception):
+    """Real exception used in place of mitmproxy.exceptions.FlowReadException."""
+
+
+class _MockHTTPFlow:
+    """Real class used in place of mitmproxy.http.HTTPFlow for isinstance checks."""
+
+
+_mitmproxy_exceptions_mock = MagicMock()
+_mitmproxy_exceptions_mock.FlowReadException = _MockFlowReadException
+
+_mitmproxy_http_mock = MagicMock()
+_mitmproxy_http_mock.HTTPFlow = _MockHTTPFlow
+
+sys.modules.setdefault("mitmproxy", MagicMock())
+sys.modules.setdefault("mitmproxy.io", MagicMock())
+sys.modules.setdefault("mitmproxy.exceptions", _mitmproxy_exceptions_mock)
+sys.modules.setdefault("mitmproxy.http", _mitmproxy_http_mock)
+
+# Ensure /workspace is importable
+sys.path.insert(0, "/workspace")
+import export_flows  # noqa: E402  (import after sys.modules setup)
+
+# These now point to the real classes defined above
+FlowReadException = export_flows.FlowReadException  # _MockFlowReadException
+HTTPFlow = export_flows.HTTPFlow  # _MockHTTPFlow
+
+
+# ---------------------------------------------------------------------------
+# Helpers
+# ---------------------------------------------------------------------------
+
+class MockHeaders:
+    """Minimal mitmproxy-like headers object."""
+
+    def __init__(self, fields):
+        # fields: list of (bytes_key, bytes_value)
+        self.fields = fields
+
+    def get(self, key, default=None):
+        if isinstance(key, str):
+            key = key.encode()
+        for k, v in self.fields:
+            if k.lower() == key.lower():
+                return v
+        return default
+
+    def __setitem__(self, key, value):
+        if isinstance(key, str):
+            key = key.encode()
+        for i, (k, _) in enumerate(self.fields):
+            if k.lower() == key.lower():
+                self.fields[i] = (k, value)
+                return
+        self.fields.append((key, value))
+
+
+def make_flow(
+    method="POST",
+    url="https://api.anthropic.com/v1/messages",
+    request_body=None,
+    request_headers=None,
+    response_status=200,
+    response_reason="OK",
+    response_body="",
+    response_headers=None,
+    request_ts=1000.0,
+    response_ts=1001.5,
+    response=True,
+):
+    """Build a minimal mock HTTPFlow."""
+    flow = MagicMock()
+    flow.__class__ = HTTPFlow  # enables isinstance(flow, HTTPFlow) → True
+
+    req = MagicMock()
+    req.method = method
+    req.pretty_url = url
+    req.headers = MockHeaders(request_headers or [(b"content-type", b"application/json")])
+    req.get_text.return_value = request_body if request_body is not None else ""
+    req.timestamp_start = request_ts
+    flow.request = req
+
+    if response:
+        resp = MagicMock()
+        resp.status_code = response_status
+        resp.reason = response_reason
+        resp.headers = MockHeaders(response_headers or [])
+        resp.get_text.return_value = response_body
+        resp.timestamp_end = response_ts
+        flow.response = resp
+    else:
+        flow.response = None
+
+    return flow
+
