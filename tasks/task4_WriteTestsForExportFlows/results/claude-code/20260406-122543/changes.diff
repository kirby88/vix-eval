+# ===========================================================================
+# summarize_usage
+# ===========================================================================
+
+class TestSummarizeUsage:
+    def _make_usage(self, model="claude-sonnet-4-6", input_tok=100, output_tok=50, timing=None):
+        cost = {
+            "input": {"tokens": input_tok, "dollars": input_tok * 3e-6},
+            "cache_write": {"tokens": 0, "dollars": 0.0},
+            "cache_read": {"tokens": 0, "dollars": 0.0},
+            "output": {"tokens": output_tok, "dollars": output_tok * 15e-6},
+            "total": {"tokens": input_tok + output_tok, "dollars": (input_tok * 3e-6 + output_tok * 15e-6)},
+        }
+        usage = {"model": model, "cost": cost}
+        if timing:
+            usage["timing"] = timing
+        return usage
+
+    def _setup_agent(self, tmp_path, agent_name, steps):
+        """steps: list of lists of usage dicts (step → requests)"""
+        agent_dir = tmp_path / agent_name
+        for step_idx, requests in enumerate(steps, 1):
+            for req_idx, usage in enumerate(requests, 1):
+                req_dir = agent_dir / str(step_idx) / str(req_idx)
+                req_dir.mkdir(parents=True)
+                (req_dir / "usage.json").write_text(json.dumps(usage))
+        return agent_dir
+
+    def test_creates_summary_file(self, tmp_path):
+        usage = self._make_usage()
+        self._setup_agent(tmp_path, "vix", [[usage]])
+        export_flows.summarize_usage(str(tmp_path))
+        summary_file = tmp_path / "vix" / "usage.json"
+        assert summary_file.exists()
+        summary = json.loads(summary_file.read_text())
+        assert summary["title"] == "vix"
+        assert summary["color"] == export_flows.AGENT_COLORS["vix"]
+
+    def test_skips_dirs_without_numbered_subdirs(self, tmp_path):
+        # A directory with only non-numbered subdirs should be skipped
+        agent_dir = tmp_path / "random_dir"
+        (agent_dir / "not_numbered").mkdir(parents=True)
+        export_flows.summarize_usage(str(tmp_path))
+        assert not (agent_dir / "usage.json").exists()
+
+    def test_aggregates_multiple_requests(self, tmp_path, capsys):
+        u1 = self._make_usage(input_tok=100, output_tok=50)
+        u2 = self._make_usage(input_tok=200, output_tok=100)
+        self._setup_agent(tmp_path, "cc", [[u1, u2]])
+        export_flows.summarize_usage(str(tmp_path))
+        summary = json.loads((tmp_path / "cc" / "usage.json").read_text())
+        assert summary["total"]["request_count"] == 2
+        assert summary["total"]["cost"]["input"]["tokens"] == 300
+        assert summary["color"] == export_flows.AGENT_COLORS["cc"]
+
+    def test_aggregates_by_model(self, tmp_path):
+        u1 = self._make_usage(model="claude-sonnet-4-6", input_tok=100)
+        u2 = self._make_usage(model="claude-opus-4-5", input_tok=50)
+        self._setup_agent(tmp_path, "agent", [[u1, u2]])
+        export_flows.summarize_usage(str(tmp_path))
+        summary = json.loads((tmp_path / "agent" / "usage.json").read_text())
+        assert "claude-sonnet-4-6" in summary["by_model"]
+        assert "claude-opus-4-5" in summary["by_model"]
+
+    def test_aggregates_by_step(self, tmp_path):
+        u1 = self._make_usage(input_tok=100)
+        u2 = self._make_usage(input_tok=200)
+        self._setup_agent(tmp_path, "agent", [[u1], [u2]])  # 2 steps
+        export_flows.summarize_usage(str(tmp_path))
+        summary = json.loads((tmp_path / "agent" / "usage.json").read_text())
+        assert "1" in summary["by_step"]
+        assert "2" in summary["by_step"]
+
+    def test_wall_clock_time_computed(self, tmp_path):
+        timing1 = {"request_start": 1000.0, "response_end": 1002.0, "duration_ms": 2000}
+        timing2 = {"request_start": 1003.0, "response_end": 1005.5, "duration_ms": 2500}
+        u1 = self._make_usage(timing=timing1)
+        u2 = self._make_usage(timing=timing2)
+        self._setup_agent(tmp_path, "agent", [[u1, u2]])
+        export_flows.summarize_usage(str(tmp_path))
+        summary = json.loads((tmp_path / "agent" / "usage.json").read_text())
+        t = summary["total"]["timing"]
+        # wall clock = (max_response_end - min_request_start) * 1000
+        assert t["wall_clock_ms"] == round((1005.5 - 1000.0) * 1000)
+        assert t["avg_duration_ms"] == round((2000 + 2500) / 2)
+
