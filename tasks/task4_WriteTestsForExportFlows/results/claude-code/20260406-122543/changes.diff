+class TestCountWhitespaceStats:
+    def test_empty_string(self):
+        r = export_flows.count_whitespace_stats("")
+        assert r == {"line_returns_count": 0, "unnecessary_space_count": 0, "total_chars": 0}
+
+    def test_newlines(self):
+        r = export_flows.count_whitespace_stats("a\nb\nc")
+        assert r["line_returns_count"] == 2
+        assert r["total_chars"] == 5
+
+    def test_double_spaces_count_once(self):
+        r = export_flows.count_whitespace_stats("a  b")  # 2 spaces → 1 unnecessary
+        assert r["unnecessary_space_count"] == 1
+
+    def test_four_spaces(self):
+        r = export_flows.count_whitespace_stats("a    b")  # 4 spaces → 3 unnecessary
+        assert r["unnecessary_space_count"] == 3
+
+    def test_multiple_runs(self):
+        r = export_flows.count_whitespace_stats("a  b   c")  # 2+3 → 1+2=3
+        assert r["unnecessary_space_count"] == 3
+
+    def test_single_spaces_not_counted(self):
+        r = export_flows.count_whitespace_stats("a b c")
+        assert r["unnecessary_space_count"] == 0
+
+    def test_total_chars(self):
+        text = "hello world"
+        r = export_flows.count_whitespace_stats(text)
+        assert r["total_chars"] == len(text)
+
+    def test_mixed_content(self):
+        text = "line1\nline2  extra   spaces\n"
+        r = export_flows.count_whitespace_stats(text)
+        assert r["line_returns_count"] == 2
+        assert r["unnecessary_space_count"] == 1 + 2  # "  " and "   "
+        assert r["total_chars"] == len(text)
