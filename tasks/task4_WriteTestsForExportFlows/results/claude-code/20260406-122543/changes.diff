+class TestExtractStopReason:
+    def _sse_line(self, payload):
+        return f"data: {json.dumps(payload)}"
+
+    def test_sse_message_delta_compact(self):
+        raw = self._sse_line({"type": "message_delta", "delta": {"stop_reason": "end_turn"}})
+        assert export_flows.extract_stop_reason(raw) == "end_turn"
+
+    def test_sse_message_delta_spaced(self):
+        # Test the "type: " spaced variant via payload string
+        payload = '{"type": "message_delta", "delta": {"stop_reason": "max_tokens"}}'
+        raw = f"data: {payload}"
+        assert export_flows.extract_stop_reason(raw) == "max_tokens"
+
+    def test_sse_skips_null_stop_reason(self):
+        # Null stop_reason should not be returned
+        raw = (
+            self._sse_line({"type": "message_delta", "delta": {"stop_reason": None}}) + "\n"
+            + self._sse_line({"type": "message_delta", "delta": {"stop_reason": "tool_use"}})
+        )
+        assert export_flows.extract_stop_reason(raw) == "tool_use"
+
+    def test_non_streaming_fallback(self):
+        raw = json.dumps({"type": "message", "stop_reason": "end_turn", "content": []})
+        assert export_flows.extract_stop_reason(raw) == "end_turn"
+
+    def test_non_streaming_skips_null(self):
+        raw = json.dumps({"type": "message", "stop_reason": None, "content": []})
+        # Should fall through to unknown since stop_reason is falsy
+        assert export_flows.extract_stop_reason(raw) == "unknown"
+
+    def test_malformed_sse_json_skipped(self):
+        raw = "data: {not valid json}\ndata: " + json.dumps({"type": "message_delta", "delta": {"stop_reason": "end_turn"}})
+        assert export_flows.extract_stop_reason(raw) == "end_turn"
+
+    def test_no_matching_content_returns_unknown(self):
+        assert export_flows.extract_stop_reason("some random text") == "unknown"
+
+    def test_empty_string_returns_unknown(self):
+        assert export_flows.extract_stop_reason("") == "unknown"
+
+    def test_sse_takes_priority(self):
+        # Both SSE and non-streaming present → SSE wins
+        sse = self._sse_line({"type": "message_delta", "delta": {"stop_reason": "from_sse"}})
+        non_stream = json.dumps({"type": "message", "stop_reason": "from_non_stream"})
+        raw = sse + "\n" + non_stream
+        assert export_flows.extract_stop_reason(raw) == "from_sse"
+
+    def test_non_streaming_uses_last_message(self):
+        # Multiple message-type lines: should find the last one
+        line1 = json.dumps({"type": "message", "stop_reason": "first"})
+        line2 = json.dumps({"type": "other"})
+        line3 = json.dumps({"type": "message", "stop_reason": "last"})
+        raw = "\n".join([line1, line2, line3])
+        assert export_flows.extract_stop_reason(raw) == "last"
+
