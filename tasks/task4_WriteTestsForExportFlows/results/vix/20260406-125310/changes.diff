+class TestCountWhitespaceStats:
+    def test_empty_string(self):
+        result = count_whitespace_stats("")
+        assert result == {"line_returns_count": 0, "unnecessary_space_count": 0, "total_chars": 0}
+
+    def test_no_extra_whitespace(self):
+        result = count_whitespace_stats("hello world")
+        assert result["line_returns_count"] == 0
+        assert result["unnecessary_space_count"] == 0
+        assert result["total_chars"] == 11
+
+    def test_line_returns(self):
+        result = count_whitespace_stats("a\nb\nc")
+        assert result["line_returns_count"] == 2
+        assert result["total_chars"] == 5
+
+    def test_unnecessary_spaces(self):
+        # "a  b" has run of 2 → 1 unnecessary
+        result = count_whitespace_stats("a  b")
+        assert result["unnecessary_space_count"] == 1
+        # "a   b" has run of 3 → 2 unnecessary
+        result2 = count_whitespace_stats("a   b")
+        assert result2["unnecessary_space_count"] == 2
+
+    def test_mixed(self):
+        result = count_whitespace_stats("a  b\nc   d")
+        assert result["line_returns_count"] == 1
+        assert result["unnecessary_space_count"] == 1 + 2  # 2-space run + 3-space run
+
+    def test_single_spaces_not_counted(self):
+        result = count_whitespace_stats("a b c d")
+        assert result["unnecessary_space_count"] == 0
