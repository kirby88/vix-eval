+def make_sse_response(stop_reason="end_turn", usage=None, text="Hello", tool_calls=None):
+    """Build a minimal SSE response_raw.txt string."""
+    lines = ["200 OK", "", ""]
+    if text:
+        lines += [
+            'data: {"type":"content_block_start","index":0,"content_block":{"type":"text","text":""}}',
+            f'data: {{"type":"content_block_delta","index":0,"delta":{{"type":"text_delta","text":{json.dumps(text)}}}}}',
+            'data: {"type":"content_block_stop","index":0}',
+        ]
+    if tool_calls:
+        for idx, tc in enumerate(tool_calls, start=1):
+            name = tc.get("name", "unknown")
+            inp = tc.get("input", {})
+            inp_json = json.dumps(inp)
+            lines += [
+                f'data: {{"type":"content_block_start","index":{idx},"content_block":{{"type":"tool_use","name":{json.dumps(name)}}}}}',
+                f'data: {{"type":"content_block_delta","index":{idx},"delta":{{"type":"input_json_delta","partial_json":{json.dumps(inp_json)}}}}}',
+                f'data: {{"type":"content_block_stop","index":{idx}}}',
+            ]
+    usage_payload = usage or {"output_tokens": 5, "input_tokens": 10}
+    lines.append(
+        f'data: {{"type":"message_delta","delta":{{"stop_reason":{json.dumps(stop_reason)}}},"usage":{json.dumps(usage_payload)}}}'
+    )
+    return "\n".join(lines)
+
+
+def make_flow_file(path, flows):
+    """Write a list of HTTPFlow objects to a .flow file at path."""
+    with open(path, "wb") as f:
+        writer = FlowWriter(f)
+        for flow in flows:
+            writer.add(flow)
+
+
+def make_simple_flow(url="https://api.anthropic.com/v1/messages", body=None, response_body=None,
+                     api_key=None, stop_reason="tool_use"):
+    """Create a simple HTTPFlow for testing."""
+    f = tflow.tflow(resp=tutils.tresp())
+    f.request.method = "POST"
+    f.request.url = url
+    if body is not None:
+        text = json.dumps(body) if isinstance(body, dict) else body
+        f.request.set_text(text)
+    if api_key:
+        f.request.headers[b"x-api-key"] = api_key.encode()
+    if response_body is not None:
+        f.response.set_text(response_body)
+    return f
