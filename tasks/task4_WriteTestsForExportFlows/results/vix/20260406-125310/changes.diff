+# TestSystemPromptHash
+# ---------------------------------------------------------------------------
+
+class TestSystemPromptHash:
+    def _body(self, system_list):
+        return {"system": system_list}
+
+    def test_cc_uses_index_2(self):
+        body = self._body([
+            {"type": "text", "text": "index0"},
+            {"type": "text", "text": "index1"},
+            {"type": "text", "text": "index2"},
+        ])
+        h = _system_prompt_hash(body, "cc")
+        expected = hashlib.sha256("index2".encode()).hexdigest()[:12]
+        assert h == expected
+
+    def test_vix_uses_index_0(self):
+        body = self._body([{"type": "text", "text": "index0"}, {"type": "text", "text": "other"}])
+        h = _system_prompt_hash(body, "vix")
+        expected = hashlib.sha256("index0".encode()).hexdigest()[:12]
+        assert h == expected
+
+    def test_unknown_agent_uses_index_0(self):
+        body = self._body([{"type": "text", "text": "index0"}])
+        h = _system_prompt_hash(body, "unknown_agent")
+        expected = hashlib.sha256("index0".encode()).hexdigest()[:12]
+        assert h == expected
+
+    def test_no_system_returns_none(self):
+        assert _system_prompt_hash({}, "cc") is None
+
+    def test_index_out_of_range_returns_none(self):
+        # cc uses index 2, but only 1 element
+        body = self._body([{"type": "text", "text": "only"}])
+        assert _system_prompt_hash(body, "cc") is None
+
+    def test_empty_text_returns_none(self):
+        body = self._body([{"type": "text", "text": ""}])
+        assert _system_prompt_hash(body, "vix") is None
+
+    def test_hash_is_12_chars(self):
+        body = self._body([{"type": "text", "text": "hello"}])
+        h = _system_prompt_hash(body, "vix")
+        assert len(h) == 12
+
+    def test_different_texts_produce_different_hashes(self):
+        b1 = self._body([{"type": "text", "text": "abc"}])
+        b2 = self._body([{"type": "text", "text": "xyz"}])
+        assert _system_prompt_hash(b1, "vix") != _system_prompt_hash(b2, "vix")
+
