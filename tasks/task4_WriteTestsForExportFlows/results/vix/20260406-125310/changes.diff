+# ---------------------------------------------------------------------------
+# TestSummarizeUsage
+# ---------------------------------------------------------------------------
+
+class TestSummarizeUsage:
+    def _make_usage(self, model="claude-opus-4", input_tok=100, output_tok=50):
+        pricing = MODEL_PRICING[model]
+        return {
+            "model": model,
+            "cost": {
+                "input": {"tokens": input_tok, "dollars": round(input_tok * pricing["input"], 6)},
+                "cache_write": {"tokens": 0, "dollars": 0.0},
+                "cache_read": {"tokens": 0, "dollars": 0.0},
+                "output": {"tokens": output_tok, "dollars": round(output_tok * pricing["output"], 6)},
+                "total": {"tokens": input_tok + output_tok, "dollars": round(input_tok * pricing["input"] + output_tok * pricing["output"], 6)},
+            },
+            "timing": {"request_start": 1000.0, "response_end": 1001.0, "duration_ms": 1000},
+        }
+
+    def _setup_agent(self, base, agent, steps_reqs):
+        """steps_reqs: list of (step, req, usage_dict)"""
+        agent_dir = base / agent
+        for step, req, usage in steps_reqs:
+            d = agent_dir / str(step) / str(req)
+            d.mkdir(parents=True, exist_ok=True)
+            (d / "usage.json").write_text(json.dumps(usage))
+        return agent_dir
+
+    def test_creates_summary_per_agent(self, tmp_path, capsys):
+        agent_dir = self._setup_agent(tmp_path, "vix", [
+            (1, 1, self._make_usage()),
+            (1, 2, self._make_usage()),
+        ])
+        summarize_usage(str(tmp_path))
+        summary_path = agent_dir / "usage.json"
+        assert summary_path.exists()
+        data = json.loads(summary_path.read_text())
+        assert data["total"]["request_count"] == 2
+        assert data["title"] == "vix"
+
+    def test_uses_known_agent_color(self, tmp_path, capsys):
+        self._setup_agent(tmp_path, "vix", [(1, 1, self._make_usage())])
+        summarize_usage(str(tmp_path))
+        data = json.loads((tmp_path / "vix" / "usage.json").read_text())
+        assert data["color"] == "#7B2FBE"
+
+    def test_uses_generated_color_for_unknown_agent(self, tmp_path, capsys):
+        self._setup_agent(tmp_path, "my_custom_agent", [(1, 1, self._make_usage())])
+        summarize_usage(str(tmp_path))
+        data = json.loads((tmp_path / "my_custom_agent" / "usage.json").read_text())
+        color = data["color"]
+        assert color.startswith("#")
+        assert len(color) == 7
+
+    def test_skips_non_directory_entries(self, tmp_path, capsys):
+        # A plain file at the top level should be ignored
+        (tmp_path / "somefile.txt").write_text("not a dir")
+        self._setup_agent(tmp_path, "vix", [(1, 1, self._make_usage())])
+        summarize_usage(str(tmp_path))
+        captured = capsys.readouterr()
+        assert "Summarized usage for 1 agent types" in captured.out
+
+    def test_skips_dirs_without_numbered_subdirs(self, tmp_path, capsys):
+        agent_dir = tmp_path / "emptyagent"
+        agent_dir.mkdir()
+        (agent_dir / "somesubdir").mkdir()  # non-numeric name
+        summarize_usage(str(tmp_path))
+        captured = capsys.readouterr()
+        assert "Summarized usage for 0 agent types" in captured.out
+
+    def test_by_step_aggregation(self, tmp_path, capsys):
+        self._setup_agent(tmp_path, "vix", [
+            (1, 1, self._make_usage(input_tok=100, output_tok=50)),
+            (2, 1, self._make_usage(input_tok=200, output_tok=100)),
+        ])
+        summarize_usage(str(tmp_path))
+        data = json.loads((tmp_path / "vix" / "usage.json").read_text())
+        assert "1" in data["by_step"]
+        assert "2" in data["by_step"]
+        assert data["by_step"]["1"]["request_count"] == 1
+        assert data["by_step"]["2"]["request_count"] == 1
+
+    def test_timing_finalized(self, tmp_path, capsys):
+        self._setup_agent(tmp_path, "vix", [(1, 1, self._make_usage())])
+        summarize_usage(str(tmp_path))
+        data = json.loads((tmp_path / "vix" / "usage.json").read_text())
+        t = data["total"]["timing"]
+        assert "wall_clock_ms" in t
+        assert "avg_duration_ms" in t
+        assert "min_request_start" not in t
+        assert "max_response_end" not in t
