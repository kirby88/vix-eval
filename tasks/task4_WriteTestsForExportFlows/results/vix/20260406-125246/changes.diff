+# ---------------------------------------------------------------------------
+# TestAttributeTokens
+# ---------------------------------------------------------------------------
+
+class TestAttributeTokens:
+    def _pricing(self):
+        return {"input": 5e-6, "cache_write": 6.25e-6, "cache_read": 0.5e-6, "output": 25e-6}
+
+    def _usage(self, input_tok=0, cw_tok=0, cr_tok=0, output_tok=0, output_dollars=0.0):
+        return {
+            "cost": {
+                "input": {"tokens": input_tok, "dollars": input_tok * 5e-6},
+                "cache_write": {"tokens": cw_tok, "dollars": cw_tok * 6.25e-6},
+                "cache_read": {"tokens": cr_tok, "dollars": cr_tok * 0.5e-6},
+                "output": {"tokens": output_tok, "dollars": output_dollars},
+            }
+        }
+
+    def test_output_token_distribution(self):
+        input_sources = {"total_chars": 0, "tool_results": {}, "tool_calls": {}}
+        output_sources = {"llm_text": 50, "tool_calls": {"Write": 50}}
+        usage = self._usage(output_tok=100, output_dollars=0.0025)
+        result = export_flows.attribute_tokens(input_sources, output_sources, usage, self._pricing())
+        llm = result["output"]["llm_text"]
+        tc = result["output"]["tool_calls"]
+        assert llm["tokens"] == 50
+        assert tc["__total"]["tokens"] == 50
+
+    def test_zero_total_chars_skips_input(self):
+        input_sources = {"total_chars": 0, "tool_results": {"Read": {"cache_write_chars": 10, "cache_read_chars": 0}}, "tool_calls": {}}
+        output_sources = {"llm_text": 0, "tool_calls": {}}
+        usage = self._usage(input_tok=100)
+        result = export_flows.attribute_tokens(input_sources, output_sources, usage, self._pricing())
+        assert result["input"] == {}
+
+    def test_zero_output_chars_skips_output(self):
+        input_sources = {"total_chars": 200, "tool_results": {}, "tool_calls": {}}
+        output_sources = {"llm_text": 0, "tool_calls": {}}
+        usage = self._usage(output_tok=50, output_dollars=0.001)
+        result = export_flows.attribute_tokens(input_sources, output_sources, usage, self._pricing())
+        assert result["output"] == {}
+
+    def test_no_pricing_skips_input(self):
+        input_sources = {"total_chars": 200, "tool_results": {"Read": {"cache_write_chars": 100, "cache_read_chars": 100}}, "tool_calls": {}}
+        output_sources = {"llm_text": 0, "tool_calls": {}}
+        usage = self._usage(input_tok=100)
+        result = export_flows.attribute_tokens(input_sources, output_sources, usage, None)
+        assert result["input"] == {}
+
+    def test_input_proportional_distribution(self):
+        input_sources = {
+            "total_chars": 1000,
+            "tool_results": {"Read": {"cache_write_chars": 500, "cache_read_chars": 0}},
+            "tool_calls": {},
+        }
+        output_sources = {"llm_text": 0, "tool_calls": {}}
+        usage = self._usage(input_tok=200, cw_tok=0, cr_tok=0)
+        pricing = self._pricing()
+        result = export_flows.attribute_tokens(input_sources, output_sources, usage, pricing)
+        read_entry = result["input"]["tool_results"]["Read"]
+        assert read_entry["tokens"] == 100  # 200 * 500/1000
