+def make_mock_headers(fields_list):
+    headers = MagicMock()
+    headers.fields = [(k.encode() if isinstance(k, str) else k,
+                       v.encode() if isinstance(v, str) else v)
+                      for k, v in fields_list]
+    return headers
+
+
+def make_mock_flow(method="POST", url="https://api.anthropic.com/v1/messages",
+                   body="{}", status_code=200, reason="OK",
+                   response_body="", req_timestamp=1000.0, resp_timestamp=2000.0,
+                   req_headers=None, resp_headers=None):
+    flow = MagicMock()
+    flow.__class__ = export_flows.HTTPFlow
+    flow.request.method = method
+    flow.request.pretty_url = url
+    flow.request.get_text.return_value = body
+    flow.request.timestamp_start = req_timestamp
+    flow.request.headers = make_mock_headers(req_headers or [("content-type", "application/json")])
+    flow.response.status_code = status_code
+    flow.response.reason = reason
+    flow.response.get_text.return_value = response_body
+    flow.response.timestamp_end = resp_timestamp
+    flow.response.headers = make_mock_headers(resp_headers or [("content-type", "application/json")])
+    return flow
+
+
+def make_sse_response(events):
+    """Build a fake response_raw.txt string from a list of SSE event dicts."""
+    lines = ["200 OK", "", "content-type: text/event-stream", ""]
+    for event in events:
+        lines.append(f"data: {json.dumps(event)}")
+        lines.append("")
+    return "\n".join(lines)
