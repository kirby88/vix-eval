+# ---------------------------------------------------------------------------
+# TestSystemPromptHash
+# ---------------------------------------------------------------------------
+
+class TestSystemPromptHash:
+    def _body(self, system_blocks):
+        return {"system": system_blocks}
+
+    def test_cc_agent_uses_index_2(self):
+        body = self._body([
+            {"type": "text", "text": "zero"},
+            {"type": "text", "text": "one"},
+            {"type": "text", "text": "two_cc"},
+        ])
+        result = export_flows._system_prompt_hash(body, "cc")
+        expected = hashlib.sha256("two_cc".encode()).hexdigest()[:12]
+        assert result == expected
+
+    def test_vix_agent_uses_index_0(self):
+        body = self._body([{"type": "text", "text": "vix_prompt"}])
+        result = export_flows._system_prompt_hash(body, "vix")
+        expected = hashlib.sha256("vix_prompt".encode()).hexdigest()[:12]
+        assert result == expected
+
+    def test_unknown_agent_defaults_to_index_0(self):
+        body = self._body([{"type": "text", "text": "default_prompt"}])
+        result = export_flows._system_prompt_hash(body, "unknown_agent")
+        expected = hashlib.sha256("default_prompt".encode()).hexdigest()[:12]
+        assert result == expected
+
+    def test_index_out_of_bounds_returns_none(self):
+        # cc needs index 2 but only 1 block exists
+        body = self._body([{"type": "text", "text": "only_one"}])
+        assert export_flows._system_prompt_hash(body, "cc") is None
+
+    def test_no_system_key_returns_none(self):
+        assert export_flows._system_prompt_hash({}, "cc") is None
+
+    def test_empty_system_list_returns_none(self):
+        assert export_flows._system_prompt_hash({"system": []}, "vix") is None
+
+    def test_empty_text_returns_none(self):
+        body = self._body([{"type": "text", "text": ""}])
+        assert export_flows._system_prompt_hash(body, "vix") is None
+
+    def test_hash_is_12_char_hex(self):
+        body = self._body([{"type": "text", "text": "some text"}])
+        result = export_flows._system_prompt_hash(body, "vix")
+        assert len(result) == 12
+        int(result, 16)  # must be valid hex
+
