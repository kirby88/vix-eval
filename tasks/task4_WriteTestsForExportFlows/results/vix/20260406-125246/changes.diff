+# ---------------------------------------------------------------------------
+# TestSummarizeUsage
+# ---------------------------------------------------------------------------
+
+class TestSummarizeUsage:
+    def _make_usage(self, tmp_path, agent, step, req, usage_data):
+        d = tmp_path / agent / str(step) / str(req)
+        d.mkdir(parents=True)
+        (d / "usage.json").write_text(json.dumps(usage_data))
+
+    def _basic_usage(self, model="claude-opus-4-5", input_tok=100, output_tok=50,
+                     request_start=1000.0, response_end=2000.0):
+        return {
+            "model": model,
+            "cost": {
+                "input": {"tokens": input_tok, "dollars": round(input_tok * 5e-6, 6)},
+                "cache_write": {"tokens": 0, "dollars": 0.0},
+                "cache_read": {"tokens": 0, "dollars": 0.0},
+                "output": {"tokens": output_tok, "dollars": round(output_tok * 25e-6, 6)},
+                "total": {"tokens": input_tok + output_tok, "dollars": round(input_tok * 5e-6 + output_tok * 25e-6, 6)},
+            },
+            "timing": {
+                "request_start": request_start,
+                "response_end": response_end,
+                "duration_ms": round((response_end - request_start) * 1000),
+            },
+        }
+
+    def test_creates_summary_usage_json(self, tmp_path):
+        self._make_usage(tmp_path, "cc", 1, 1, self._basic_usage())
+        export_flows.summarize_usage(str(tmp_path))
+        summary_path = tmp_path / "cc" / "usage.json"
+        assert summary_path.exists()
+
+    def test_summary_has_correct_request_count(self, tmp_path):
+        self._make_usage(tmp_path, "cc", 1, 1, self._basic_usage())
+        self._make_usage(tmp_path, "cc", 1, 2, self._basic_usage())
+        export_flows.summarize_usage(str(tmp_path))
+        summary = json.loads((tmp_path / "cc" / "usage.json").read_text())
+        assert summary["total"]["request_count"] == 2
+
+    def test_by_model_aggregated(self, tmp_path):
+        self._make_usage(tmp_path, "cc", 1, 1, self._basic_usage(model="claude-opus-4-5"))
+        self._make_usage(tmp_path, "cc", 1, 2, self._basic_usage(model="claude-haiku-3-5"))
+        export_flows.summarize_usage(str(tmp_path))
+        summary = json.loads((tmp_path / "cc" / "usage.json").read_text())
+        assert "claude-opus-4-5" in summary["by_model"]
+        assert "claude-haiku-3-5" in summary["by_model"]
+
+    def test_by_step_aggregated(self, tmp_path):
+        self._make_usage(tmp_path, "vix", 1, 1, self._basic_usage())
+        self._make_usage(tmp_path, "vix", 2, 1, self._basic_usage())
+        export_flows.summarize_usage(str(tmp_path))
+        summary = json.loads((tmp_path / "vix" / "usage.json").read_text())
+        assert "1" in summary["by_step"]
+        assert "2" in summary["by_step"]
+
+    def test_known_agent_color(self, tmp_path):
+        self._make_usage(tmp_path, "cc", 1, 1, self._basic_usage())
+        export_flows.summarize_usage(str(tmp_path))
+        summary = json.loads((tmp_path / "cc" / "usage.json").read_text())
+        assert summary["color"] == export_flows.AGENT_COLORS["cc"]
+
+    def test_unknown_agent_color_deterministic(self, tmp_path):
+        self._make_usage(tmp_path, "myagent", 1, 1, self._basic_usage())
+        export_flows.summarize_usage(str(tmp_path))
+        summary = json.loads((tmp_path / "myagent" / "usage.json").read_text())
+        assert summary["color"] == export_flows._agent_color("myagent")
+
+    def test_dir_without_numbered_subdirs_skipped(self, tmp_path):
+        nonstep_dir = tmp_path / "nonstep"
+        nonstep_dir.mkdir()
+        (nonstep_dir / "some_file.txt").write_text("hello")
+        export_flows.summarize_usage(str(tmp_path))
+        assert not (nonstep_dir / "usage.json").exists()
+
+    def test_wall_clock_ms_computed(self, tmp_path):
+        self._make_usage(tmp_path, "cc", 1, 1, self._basic_usage(request_start=1000.0, response_end=1005.0))
+        export_flows.summarize_usage(str(tmp_path))
+        summary = json.loads((tmp_path / "cc" / "usage.json").read_text())
+        assert summary["total"]["timing"]["wall_clock_ms"] == 5000
+
+    def test_avg_duration_ms_computed(self, tmp_path):
+        u1 = self._basic_usage(request_start=1000.0, response_end=2000.0)  # 1000s = 1000000ms
+        u2 = self._basic_usage(request_start=2000.0, response_end=3000.0)
+        self._make_usage(tmp_path, "cc", 1, 1, u1)
+        self._make_usage(tmp_path, "cc", 1, 2, u2)
+        export_flows.summarize_usage(str(tmp_path))
+        summary = json.loads((tmp_path / "cc" / "usage.json").read_text())
+        assert summary["total"]["timing"]["avg_duration_ms"] == 1000000
+
