+# ---------------------------------------------------------------------------
+# TestExtractUsage
+# ---------------------------------------------------------------------------
+
+class TestExtractUsage:
+    def _make_flow_dir(self, tmp_path, response_content, timing=None):
+        flow_dir = tmp_path / "agent" / "1" / "1"
+        flow_dir.mkdir(parents=True)
+        (flow_dir / "response_raw.txt").write_text(response_content)
+        if timing:
+            (flow_dir / "timing.json").write_text(json.dumps(timing))
+        return flow_dir
+
+    def test_sse_format_usage_extracted(self, tmp_path):
+        events = [
+            {"type": "message_start", "message": {}},
+            {"type": "message_delta", "delta": {"stop_reason": "end_turn"}, "usage": {
+                "input_tokens": 100, "output_tokens": 50
+            }},
+        ]
+        raw = make_sse_response(events)
+        flow_dir = self._make_flow_dir(tmp_path, raw)
+        export_flows.extract_usage(str(tmp_path))
+        usage = json.loads((flow_dir / "usage.json").read_text())
+        assert usage["input_tokens"] == 100
+        assert usage["output_tokens"] == 50
+
+    def test_non_streaming_json_usage(self, tmp_path):
+        msg = {"type": "message", "usage": {"input_tokens": 200, "output_tokens": 80}, "content": []}
+        raw = f"200 OK\n\n{json.dumps(msg)}"
+        flow_dir = self._make_flow_dir(tmp_path, raw)
+        export_flows.extract_usage(str(tmp_path))
+        usage = json.loads((flow_dir / "usage.json").read_text())
+        assert usage["input_tokens"] == 200
+        assert usage["output_tokens"] == 80
+
+    def test_timing_merged_and_file_removed(self, tmp_path):
+        events = [
+            {"type": "message_delta", "delta": {"stop_reason": "end_turn"}, "usage": {"input_tokens": 10, "output_tokens": 5}},
+        ]
+        raw = make_sse_response(events)
+        timing = {"request_start": 1000.0, "response_end": 2000.0}
+        flow_dir = self._make_flow_dir(tmp_path, raw, timing=timing)
+        export_flows.extract_usage(str(tmp_path))
+        usage = json.loads((flow_dir / "usage.json").read_text())
+        assert "timing" in usage
+        assert usage["timing"]["duration_ms"] == 1000000
+        assert not (flow_dir / "timing.json").exists()
+
+    def test_no_usage_skips_and_warns(self, tmp_path, capsys):
+        flow_dir = self._make_flow_dir(tmp_path, "200 OK\n\nno usage here")
+        export_flows.extract_usage(str(tmp_path))
+        captured = capsys.readouterr()
+        assert "Warning" in captured.out
+        assert not (flow_dir / "usage.json").exists()
+
+    def test_only_token_fields_kept(self, tmp_path):
+        events = [
+            {"type": "message_delta", "delta": {"stop_reason": "end_turn"}, "usage": {
+                "input_tokens": 10,
+                "output_tokens": 5,
+                "cache_creation_input_tokens": 3,
+                "cache_read_input_tokens": 2,
+                "extra_field": "should_be_removed",
+            }},
+        ]
+        raw = make_sse_response(events)
