+# TestCountWhitespaceStats
+# ---------------------------------------------------------------------------
+
+class TestCountWhitespaceStats:
+    def test_empty_string(self):
+        result = export_flows.count_whitespace_stats("")
+        assert result == {"line_returns_count": 0, "unnecessary_space_count": 0, "total_chars": 0}
+
+    def test_single_newlines(self):
+        result = export_flows.count_whitespace_stats("a\nb\nc")
+        assert result["line_returns_count"] == 2
+        assert result["unnecessary_space_count"] == 0
+        assert result["total_chars"] == 5
+
+    def test_multiple_consecutive_spaces(self):
+        result = export_flows.count_whitespace_stats("a  b   c")
+        # "  " -> 1, "   " -> 2
+        assert result["unnecessary_space_count"] == 3
+        assert result["line_returns_count"] == 0
+        assert result["total_chars"] == 8
+
+    def test_mixed_text(self):
+        text = "hello\nworld  foo   bar"
+        result = export_flows.count_whitespace_stats(text)
+        assert result["line_returns_count"] == 1
+        assert result["unnecessary_space_count"] == 3  # 1 + 2
+        assert result["total_chars"] == len(text)
+
+    def test_unicode_chars(self):
+        text = "héllo\nwörld"
+        result = export_flows.count_whitespace_stats(text)
+        assert result["line_returns_count"] == 1
+        assert result["total_chars"] == len(text)
+
+    def test_only_newlines(self):
+        result = export_flows.count_whitespace_stats("\n\n\n")
+        assert result["line_returns_count"] == 3
+        assert result["unnecessary_space_count"] == 0
+
+    def test_two_spaces(self):
+        result = export_flows.count_whitespace_stats("  ")
+        assert result["unnecessary_space_count"] == 1
+
