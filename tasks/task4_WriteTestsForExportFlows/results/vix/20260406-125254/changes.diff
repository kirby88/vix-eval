+# TestExtractStopReason
+# ---------------------------------------------------------------------------
+
+class TestExtractStopReason:
+    def _sse(self, payload):
+        return f"data: {json.dumps(payload)}\n"
+
+    def test_sse_message_delta_with_stop_reason(self):
+        content = self._sse({"type": "message_delta", "delta": {"stop_reason": "end_turn"}, "usage": {}})
+        assert export_flows.extract_stop_reason(content) == "end_turn"
+
+    def test_sse_message_delta_tool_use(self):
+        content = self._sse({"type": "message_delta", "delta": {"stop_reason": "tool_use"}, "usage": {}})
+        assert export_flows.extract_stop_reason(content) == "tool_use"
+
+    def test_sse_without_message_delta_falls_back(self):
+        content = self._sse({"type": "message_start", "message": {}})
+        assert export_flows.extract_stop_reason(content) == "unknown"
+
+    def test_non_streaming_json_message_type(self):
+        msg = json.dumps({"type": "message", "stop_reason": "end_turn", "content": []})
+        assert export_flows.extract_stop_reason(msg) == "end_turn"
+
+    def test_non_streaming_json_without_matching_type(self):
+        msg = json.dumps({"type": "other", "stop_reason": "end_turn"})
+        assert export_flows.extract_stop_reason(msg) == "unknown"
+
+    def test_empty_string_returns_unknown(self):
+        assert export_flows.extract_stop_reason("") == "unknown"
+
+    def test_malformed_json_skipped(self):
+        content = "data: {broken json}\ndata: " + json.dumps({"type": "message_delta", "delta": {"stop_reason": "end_turn"}})
+        assert export_flows.extract_stop_reason(content) == "end_turn"
+
+    def test_sse_takes_priority_over_non_streaming(self):
+        sse_line = self._sse({"type": "message_delta", "delta": {"stop_reason": "tool_use"}})
+        fallback_line = json.dumps({"type": "message", "stop_reason": "end_turn"})
+        content = sse_line + fallback_line
+        assert export_flows.extract_stop_reason(content) == "tool_use"
+
+    def test_sse_no_stop_reason_in_delta(self):
+        content = self._sse({"type": "message_delta", "delta": {}})
+        assert export_flows.extract_stop_reason(content) == "unknown"
+
