+# ---------------------------------------------------------------------------
+# TestSystemPromptHash
+# ---------------------------------------------------------------------------
+
+class TestSystemPromptHash:
+    def _body(self, system):
+        return {"system": system}
+
+    def test_system_key_absent(self):
+        assert export_flows._system_prompt_hash({}, "cc") is None
+
+    def test_system_empty_list(self):
+        assert export_flows._system_prompt_hash(self._body([]), "cc") is None
+
+    def test_index_out_of_bounds(self):
+        # cc uses index 2, but only 1 element
+        body = self._body([{"text": "hello"}])
+        assert export_flows._system_prompt_hash(body, "cc") is None
+
+    def test_text_is_empty_string(self):
+        body = self._body([{"text": ""}, {"text": ""}, {"text": ""}])
+        assert export_flows._system_prompt_hash(body, "cc") is None
+
+    def test_cc_agent_uses_index_2(self):
+        body = self._body([
+            {"text": "zero"},
+            {"text": "one"},
+            {"text": "two"},
+        ])
+        expected = hashlib.sha256("two".encode()).hexdigest()[:12]
+        assert export_flows._system_prompt_hash(body, "cc") == expected
+
+    def test_vix_agent_uses_index_0(self):
+        body = self._body([{"text": "zero"}, {"text": "one"}])
+        expected = hashlib.sha256("zero".encode()).hexdigest()[:12]
+        assert export_flows._system_prompt_hash(body, "vix") == expected
+
+    def test_unknown_agent_defaults_to_index_0(self):
+        body = self._body([{"text": "hello"}])
+        expected = hashlib.sha256("hello".encode()).hexdigest()[:12]
+        assert export_flows._system_prompt_hash(body, "other") == expected
+
+    def test_correct_sha256_prefix_length(self):
+        body = self._body([{"text": "abc"}])
+        result = export_flows._system_prompt_hash(body, "vix")
+        assert isinstance(result, str)
+        assert len(result) == 12
+
+    def test_different_text_produces_different_hash(self):
+        body1 = self._body([{"text": "aaa"}])
+        body2 = self._body([{"text": "bbb"}])
+        assert export_flows._system_prompt_hash(body1, "vix") != export_flows._system_prompt_hash(body2, "vix")
+
