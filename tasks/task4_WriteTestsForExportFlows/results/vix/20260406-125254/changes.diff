+# ---------------------------------------------------------------------------
+# Helpers
+# ---------------------------------------------------------------------------
+
+def _make_flow(method="POST", url="https://api.example.com/v1/messages",
+               request_body=None, response_body=None, response_status=200,
+               response_reason="OK"):
+    flow = _FakeHTTPFlow()
+    flow.request = MagicMock()
+    flow.request.method = method
+    flow.request.pretty_url = url
+    flow.request.timestamp_start = 1000.0
+    flow.request.headers = MagicMock()
+    flow.request.headers.fields = []
+    flow.request.get_text = MagicMock(return_value=request_body or "")
+    if response_body is not None:
+        flow.response = MagicMock()
+        flow.response.status_code = response_status
+        flow.response.reason = response_reason
+        flow.response.timestamp_end = 2000.0
+        flow.response.headers = MagicMock()
+        flow.response.headers.fields = []
+        flow.response.get_text = MagicMock(return_value=response_body)
+    else:
+        flow.response = None
+    return flow
