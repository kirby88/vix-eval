+# TestFormatHeaders
+# ---------------------------------------------------------------------------
+
+class TestFormatHeaders:
+    def _make_headers(self, fields):
+        h = MagicMock()
+        h.fields = fields
+        return h
+
+    def test_non_sensitive_header_passes_through(self):
+        h = self._make_headers([(b"content-type", b"application/json")])
+        result = export_flows.format_headers(h)
+        assert "content-type" in result
+        assert "application/json" in result
+
+    def test_x_api_key_redacted(self):
+        h = self._make_headers([(b"x-api-key", b"sk-secret")])
+        result = export_flows.format_headers(h)
+        assert "[REDACTED]" in result
+        assert "sk-secret" not in result
+
+    def test_authorization_redacted(self):
+        h = self._make_headers([(b"authorization", b"Bearer token")])
+        result = export_flows.format_headers(h)
+        assert "[REDACTED]" in result
+        assert "Bearer token" not in result
+
+    def test_mixed_headers(self):
+        h = self._make_headers([
+            (b"content-type", b"application/json"),
+            (b"x-api-key", b"sk-secret"),
+            (b"accept", b"*/*"),
+        ])
+        result = export_flows.format_headers(h)
+        assert "application/json" in result
+        assert "[REDACTED]" in result
+        assert "sk-secret" not in result
+        assert "*/*" in result
+
+    def test_empty_headers(self):
+        h = self._make_headers([])
+        result = export_flows.format_headers(h)
+        assert result == ""
+
+    def test_uppercase_header_key_not_redacted(self):
+        # The comparison is k.lower(), so uppercase bytes still get redacted
+        h = self._make_headers([(b"X-Api-Key", b"secret")])
+        result = export_flows.format_headers(h)
+        assert "[REDACTED]" in result
