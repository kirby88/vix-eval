+# ---------------------------------------------------------------------------
+# TestCountWhitespaceStats
+# ---------------------------------------------------------------------------
+
+class TestCountWhitespaceStats:
+    def test_empty_string(self):
+        result = export_flows.count_whitespace_stats("")
+        assert result == {"line_returns_count": 0, "unnecessary_space_count": 0, "total_chars": 0}
+
+    def test_single_line_no_extras(self):
+        result = export_flows.count_whitespace_stats("hello world")
+        assert result["line_returns_count"] == 0
+        assert result["unnecessary_space_count"] == 0
+        assert result["total_chars"] == 11
+
+    def test_multiple_newlines(self):
+        result = export_flows.count_whitespace_stats("a\nb\nc")
+        assert result["line_returns_count"] == 2
+        assert result["total_chars"] == 5
+
+    def test_consecutive_spaces(self):
+        # "a   b" has a run of 3 spaces -> len(run)-1 = 2 unnecessary
+        result = export_flows.count_whitespace_stats("a   b")
+        assert result["unnecessary_space_count"] == 2
+
+    def test_multiple_space_runs(self):
+        # "a  b  c" has two runs of 2 -> each contributes 1 unnecessary
+        result = export_flows.count_whitespace_stats("a  b  c")
+        assert result["unnecessary_space_count"] == 2
+
+    def test_mixed_newlines_and_spaces(self):
+        result = export_flows.count_whitespace_stats("a\n  b   c")
+        assert result["line_returns_count"] == 1
+        # "  b" is a run of 2, "   " is a run of 3 -> 1 + 2 = 3
+        assert result["unnecessary_space_count"] == 3
+
+    def test_only_spaces(self):
+        result = export_flows.count_whitespace_stats("     ")
+        # one run of 5 -> 4 unnecessary
+        assert result["unnecessary_space_count"] == 4
+        assert result["total_chars"] == 5
+
