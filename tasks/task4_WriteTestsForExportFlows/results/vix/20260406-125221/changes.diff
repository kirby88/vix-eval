+# ---------------------------------------------------------------------------
+# TestExtractStopReason
+# ---------------------------------------------------------------------------
+
+class TestExtractStopReason:
+    def test_sse_message_delta(self):
+        sse = _make_sse_lines(
+            {"type": "message_start", "message": {}},
+            {"type": "message_delta", "delta": {"stop_reason": "end_turn"}},
+        )
+        assert export_flows.extract_stop_reason(sse) == "end_turn"
+
+    def test_sse_multiple_events_only_delta_matters(self):
+        sse = _make_sse_lines(
+            {"type": "content_block_start", "index": 0, "content_block": {"type": "text"}},
+            {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "hi"}},
+            {"type": "content_block_stop", "index": 0},
+            {"type": "message_delta", "delta": {"stop_reason": "tool_use"}},
+        )
+        assert export_flows.extract_stop_reason(sse) == "tool_use"
+
+    def test_non_streaming_json(self):
+        msg = json.dumps({"type": "message", "stop_reason": "max_tokens", "content": []})
+        assert export_flows.extract_stop_reason(msg) == "max_tokens"
+
+    def test_no_relevant_data(self):
+        assert export_flows.extract_stop_reason("nothing here") == "unknown"
+
+    def test_malformed_json_skipped(self):
+        raw = "data: {broken json}\ndata: " + json.dumps({"type": "message_delta", "delta": {"stop_reason": "end_turn"}})
+        assert export_flows.extract_stop_reason(raw) == "end_turn"
+
+    def test_message_delta_without_stop_reason(self):
+        sse = _make_sse_lines(
+            {"type": "message_delta", "delta": {"stop_reason": None}},
+        )
+        # stop_reason is None so SSE path falls through; non-streaming fallback also has nothing
+        assert export_flows.extract_stop_reason(sse) == "unknown"
+
+    def test_sse_takes_precedence_over_non_streaming(self):
+        sse_part = _make_sse_lines({"type": "message_delta", "delta": {"stop_reason": "tool_use"}})
+        non_streaming = json.dumps({"type": "message", "stop_reason": "end_turn"})
+        combined = sse_part + "\n" + non_streaming
+        assert export_flows.extract_stop_reason(combined) == "tool_use"
+
