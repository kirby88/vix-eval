+# TestFormatHeaders
+# ---------------------------------------------------------------------------
+
+class TestFormatHeaders:
+    def _make_headers(self, fields):
+        h = MagicMock()
+        h.fields = fields
+        return h
+
+    def test_normal_header_returned_as_is(self):
+        headers = self._make_headers([(b"content-type", b"application/json")])
+        result = export_flows.format_headers(headers)
+        # format_headers uses f"{k}: {v}" with bytes objects, producing "b'...': b'...'" repr
+        assert "content-type" in result
+        assert "application/json" in result
+        assert "[REDACTED]" not in result
+
+    def test_x_api_key_redacted(self):
+        headers = self._make_headers([(b"x-api-key", b"secret-key-123")])
+        result = export_flows.format_headers(headers)
+        assert "[REDACTED]" in result
+        assert "secret-key-123" not in result
+
+    def test_authorization_redacted(self):
+        headers = self._make_headers([(b"authorization", b"Bearer token")])
+        result = export_flows.format_headers(headers)
+        assert "[REDACTED]" in result
+        assert "Bearer token" not in result
+
+    def test_mixed_headers_only_sensitive_redacted(self):
+        headers = self._make_headers([
+            (b"content-type", b"application/json"),
+            (b"x-api-key", b"secret"),
+            (b"accept", b"*/*"),
+        ])
+        result = export_flows.format_headers(headers)
+        assert "application/json" in result
+        assert "secret" not in result
+        assert "[REDACTED]" in result
+
