+# TestSystemPromptHash
+# ---------------------------------------------------------------------------
+
+class TestSystemPromptHash:
+    def _body(self, system):
+        return {"system": system}
+
+    def test_cc_uses_index_2(self):
+        system = [
+            {"type": "text", "text": "a"},
+            {"type": "text", "text": "b"},
+            {"type": "text", "text": "c"},
+        ]
+        result = export_flows._system_prompt_hash(self._body(system), "cc")
+        import hashlib
+        expected = hashlib.sha256("c".encode()).hexdigest()[:12]
+        assert result == expected
+
+    def test_vix_uses_index_0(self):
+        system = [{"type": "text", "text": "hello"}]
+        result = export_flows._system_prompt_hash(self._body(system), "vix")
+        import hashlib
+        expected = hashlib.sha256("hello".encode()).hexdigest()[:12]
+        assert result == expected
+
+    def test_unknown_agent_uses_index_0(self):
+        system = [{"type": "text", "text": "prompt"}]
+        result = export_flows._system_prompt_hash(self._body(system), "other")
+        import hashlib
+        expected = hashlib.sha256("prompt".encode()).hexdigest()[:12]
+        assert result == expected
+
+    def test_index_out_of_range(self):
+        # cc uses index 2 but list only has 2 elements
+        system = [{"type": "text", "text": "a"}, {"type": "text", "text": "b"}]
+        assert export_flows._system_prompt_hash(self._body(system), "cc") is None
+
+    def test_no_system_key(self):
+        assert export_flows._system_prompt_hash({}, "cc") is None
+
+    def test_empty_text(self):
+        system = [{"type": "text", "text": "a"}, {"type": "text", "text": "b"}, {"type": "text", "text": ""}]
+        assert export_flows._system_prompt_hash(self._body(system), "cc") is None
+
+    def test_returns_12_char_hex(self):
+        system = [{"type": "text", "text": "abc"}]
+        result = export_flows._system_prompt_hash(self._body(system), "vix")
+        assert isinstance(result, str)
+        assert len(result) == 12
+        assert all(c in "0123456789abcdef" for c in result)
+
