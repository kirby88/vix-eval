+        }
+
+    def test_zero_total_chars_skips_input(self):
+        input_sources = {"total_chars": 0, "tool_results": {"R": {"cache_write_chars": 10, "cache_read_chars": 0}}, "tool_calls": {}}
+        output_sources = {"llm_text": 0, "tool_calls": {}}
