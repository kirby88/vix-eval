+class TestSummarizeUsage:
+    def _make_agent_dir(self, tmp_path, agent_name, steps):
+        """
+        steps: list of list of usage dicts (step -> list of request usages)
+        """
+        agent_dir = tmp_path / agent_name
+        agent_dir.mkdir()
+        for step_idx, requests in enumerate(steps, start=1):
+            step_dir = agent_dir / str(step_idx)
+            step_dir.mkdir()
+            for req_idx, usage in enumerate(requests, start=1):
+                req_dir = step_dir / str(req_idx)
+                req_dir.mkdir()
+                (req_dir / "usage.json").write_text(json.dumps(usage))
+        return agent_dir
