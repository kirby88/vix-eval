+class TestSystemPromptHash:
+    def test_no_system_key_returns_none(self):
+        assert _system_prompt_hash({}, "vix") is None
+
+    def test_system_is_empty_list(self):
+        assert _system_prompt_hash({"system": []}, "vix") is None
+
+    def test_cc_agent_uses_index_2(self):
+        system = [
+            {"type": "text", "text": "block0"},
+            {"type": "text", "text": "block1"},
+            {"type": "text", "text": "block2"},
+        ]
+        expected = hashlib.sha256(b"block2").hexdigest()[:12]
+        assert _system_prompt_hash({"system": system}, "cc") == expected
+
+    def test_vix_agent_uses_index_0(self):
+        system = [{"type": "text", "text": "vix_prompt"}]
+        expected = hashlib.sha256(b"vix_prompt").hexdigest()[:12]
+        assert _system_prompt_hash({"system": system}, "vix") == expected
+
+    def test_index_out_of_range_returns_none(self):
+        system = [{"type": "text", "text": "only_one"}]
+        # cc uses index 2, which is out of range for a 1-element list
+        assert _system_prompt_hash({"system": system}, "cc") is None
+
+    def test_empty_text_returns_none(self):
+        system = [{"type": "text", "text": ""}]
+        assert _system_prompt_hash({"system": system}, "vix") is None
+
+    def test_hash_is_sha256_first_12_chars(self):
+        text = "some text"
+        system = [{"type": "text", "text": text}]
+        expected = hashlib.sha256(text.encode()).hexdigest()[:12]
+        assert _system_prompt_hash({"system": system}, "vix") == expected
