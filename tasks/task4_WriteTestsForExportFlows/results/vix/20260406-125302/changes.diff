+class TestAttributeTokens:
+    def _make_usage(self, input_t=1000, cw_t=500, cr_t=200, output_t=100):
+        pricing = ef.MODEL_PRICING["claude-opus-4"]
+        return {
+            "cost": {
+                "input": {"tokens": input_t, "dollars": round(input_t * pricing["input"], 6)},
+                "cache_write": {"tokens": cw_t, "dollars": round(cw_t * pricing["cache_write"], 6)},
+                "cache_read": {"tokens": cr_t, "dollars": round(cr_t * pricing["cache_read"], 6)},
+                "output": {
+                    "tokens": output_t,
+                    "dollars": round(output_t * pricing["output"], 6),
+                },
+            }
+        }
+
+    def test_proportional_distribution_verified(self):
+        pricing = ef.MODEL_PRICING["claude-opus-4"]
+        usage = self._make_usage(1000, 0, 0, 100)
+        input_sources = {
+            "total_chars": 1000,
+            "tool_results": {"Read": {"cache_write_chars": 500, "cache_read_chars": 0}},
+            "tool_calls": {},
+        }
+        output_sources = {"llm_text": 800, "tool_calls": {"Write": 200}}
+        result = attribute_tokens(input_sources, output_sources, usage, pricing)
+        assert "Read" in result["input"]["tool_results"]
+        assert "llm_text" in result["output"]
+        assert "tool_calls" in result["output"]
+
+    def test_total_chars_zero_skips_input_attribution(self):
+        pricing = ef.MODEL_PRICING["claude-opus-4"]
+        usage = self._make_usage(1000, 0, 0, 100)
+        input_sources = {"total_chars": 0, "tool_results": {"Read": {"cache_write_chars": 100, "cache_read_chars": 0}}, "tool_calls": {}}
+        output_sources = {"llm_text": 100, "tool_calls": {}}
+        result = attribute_tokens(input_sources, output_sources, usage, pricing)
+        assert result["input"] == {}
+
+    def test_output_tokens_zero_skips_output_attribution(self):
+        pricing = ef.MODEL_PRICING["claude-opus-4"]
+        usage = {
+            "cost": {
+                "input": {"tokens": 100, "dollars": 0.001},
+                "cache_write": {"tokens": 0, "dollars": 0.0},
+                "cache_read": {"tokens": 0, "dollars": 0.0},
+                "output": {"tokens": 0, "dollars": 0.0},
+            }
+        }
+        input_sources = {"total_chars": 1000, "tool_results": {}, "tool_calls": {}}
+        output_sources = {"llm_text": 0, "tool_calls": {}}
+        result = attribute_tokens(input_sources, output_sources, usage, pricing)
+        assert result["output"] == {}
+
+    def test_missing_pricing_skips_input_attribution(self):
