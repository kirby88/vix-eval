+class TestCountWhitespaceStats:
+    def test_empty_string(self):
+        r = count_whitespace_stats("")
+        assert r == {"line_returns_count": 0, "unnecessary_space_count": 0, "total_chars": 0}
+
+    def test_no_whitespace(self):
+        r = count_whitespace_stats("hello")
+        assert r == {"line_returns_count": 0, "unnecessary_space_count": 0, "total_chars": 5}
+
+    def test_only_newlines(self):
+        r = count_whitespace_stats("a\nb\nc")
+        assert r["line_returns_count"] == 2
+        assert r["unnecessary_space_count"] == 0
+        assert r["total_chars"] == 5
+
+    def test_only_double_spaces(self):
+        r = count_whitespace_stats("a  b")
+        assert r["unnecessary_space_count"] == 1
+
+    def test_mixed_newlines_and_extra_spaces(self):
+        r = count_whitespace_stats("a\n  b   c")
+        assert r["line_returns_count"] == 1
+        assert r["unnecessary_space_count"] == 1 + 2  # "  " -> 1 unnecessary, "   " -> 2
+
+    def test_triple_spaces(self):
+        r = count_whitespace_stats("a   b")
+        assert r["unnecessary_space_count"] == 2
