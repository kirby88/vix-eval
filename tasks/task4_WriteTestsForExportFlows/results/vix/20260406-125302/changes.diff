+def make_sse_response(events):
+    """Build a fake SSE response body string from a list of dicts."""
+    lines = []
+    for event in events:
+        lines.append(f"data: {json.dumps(event)}")
+    return "\n".join(lines)
+
+
+def make_flow_file(tmp_path, flows, filename="test.flow"):
+    """Write a list of HTTPFlow objects to a .flow file and return the path."""
+    flow_path = tmp_path / filename
+    with open(flow_path, "wb") as f:
+        writer = FlowWriter(f)
+        for flow in flows:
+            writer.add(flow)
+    return flow_path
+
+
+def make_api_flow(
+    path=b"/v1/messages",
+    body=None,
+    response_body=None,
+    req_headers=None,
+    timestamp_start=1000.0,
+    timestamp_end=1002.0,
+):
+    """Create an HTTPFlow with typical API-request shape."""
+    if body is None:
+        body = b'{"model":"claude-opus-4","messages":[]}'
+    if response_body is None:
+        response_body = b'data: {"type":"message_delta","delta":{"stop_reason":"end_turn"},"usage":{"output_tokens":5}}\n'
+    if req_headers is None:
+        req_headers = Headers(
+            [
+                (b"x-api-key", b"sk-test"),
+                (b"content-type", b"application/json"),
+                (b"content-length", str(len(body)).encode()),
+            ]
+        )
+    req = treq(
+        method=b"POST",
+        path=path,
+        headers=req_headers,
+        content=body,
+        timestamp_start=timestamp_start,
+        timestamp_end=timestamp_start + 0.5,
+    )
+    resp = tresp(
+        status_code=200,
+        content=response_body,
+        timestamp_start=timestamp_start + 0.5,
+        timestamp_end=timestamp_end,
+    )
+    return tflow(req=req, resp=resp)
+
