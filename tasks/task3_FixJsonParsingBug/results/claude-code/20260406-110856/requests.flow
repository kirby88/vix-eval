,7:headers;1618:40:4:Date,29:Mon, 06 Apr 2026 10:12:46 GMT,]52:12:Content-Type,32:text/event-stream; charset=utf-8,]31:17:Transfer-Encoding,7:chunked,]28:10:Connection,10:keep-alive,]28:13:Cache-Control,8:no-cache,]52:38:anthropic-ratelimit-input-tokens-limit,7:4000000,]56:42:anthropic-ratelimit-input-tokens-remaining,7:4000000,]66:38:anthropic-ratelimit-input-tokens-reset,20:2026-04-06T10:12:45Z,]52:39:anthropic-ratelimit-output-tokens-limit,6:800000,]56:43:anthropic-ratelimit-output-tokens-remaining,6:800000,]67:39:anthropic-ratelimit-output-tokens-reset,20:2026-04-06T10:12:45Z,]45:34:anthropic-ratelimit-requests-limit,4:4000,]49:38:anthropic-ratelimit-requests-remaining,4:3999,]62:34:anthropic-ratelimit-requests-reset,20:2026-04-06T10:12:45Z,]46:32:anthropic-ratelimit-tokens-limit,7:4800000,]50:36:anthropic-ratelimit-tokens-remaining,7:4800000,]60:32:anthropic-ratelimit-tokens-reset,20:2026-04-06T10:12:45Z,]46:10:request-id,28:req_011CZnLdJ5r6mTC98ndfxe8E,]77:25:strict-transport-security,44:max-age=31536000; includeSubDomains; preload,]69:25:anthropic-organization-id,36:19d39eaa-efb4-49e0-afe8-a7359703719a,]23:6:Server,10:cloudflare,]39:29:x-envoy-upstream-service-time,3:748,]45:13:server-timing,24:x-originResponse;dur=750,]29:15:cf-cache-status,7:DYNAMIC,]208:10:set-cookie,189:_cfuvid=Mp76Vdo2wxvmESJm3b6BBmxS3b.ETZPxowKJKEl3EWQ-1775470365.6670191-1.0.1.1-z623VyoghHlzdmX.3bC7K5sfAZiVAbVr2kdXTRmOFI8; HttpOnly; SameSite=None; Secure; Path=/; Domain=api.anthropic.com,]73:23:Content-Security-Policy,42:default-src 'none'; frame-ancestors 'none',]23:12:X-Robots-Tag,4:none,]33:6:CF-RAY,20:9e8004196d6217f5-DUB,]]12:http_version;8:HTTP/1.1,}7:request;3293:4:path;22:/v1/messages?beta=true,9:authority;0:,6:scheme;5:https,6:method;4:POST,4:port;3:443#4:host;17:api.anthropic.com;13:timestamp_end;18:1775470365.6227312^15:timestamp_start;18:1775470365.6220038^8:trailers;0:~7:content;2038:{"model":"claude-haiku-4-5-20251001","messages":[{"role":"user","content":[{"type":"text","text":"# Fix: EnumAccess::variant_seed must reject non-string JSON keys (issue #979)\n\n## Context\n\n`EnumAccess::variant_seed` in `src/de.rs` calls `seed.deserialize(&mut *self.de)` directly, which allows the underlying deserializer to accept any JSON value as an object member name (arrays, booleans, numbers, etc.). This violates the JSON spec and the contract that map keys must be strings.\n\nThe existing `MapAccess::next_key_seed` already handles this correctly: it peeks for `b'\"'` and returns `ErrorCode::KeyMustBeAString` if it's missing, then deserializes via the `MapKey` wrapper which enforces string-only parsing. `EnumAccess::variant_seed` needs the same treatment.\n\n**Note:** `MapKey` has a contract comment: \"Only deserialize from this after peeking a `\"` byte! Otherwise it may deserialize invalid JSON successfully.\" So we must peek first.\n\n## Files to modify\n\n- `src/de.rs` ‚Äî fix `variant_seed` in the `EnumAccess` impl for `VariantAccess`\n- `tests/regression/issue979.rs` ‚Äî new regression te"}]}],"system":[{"type":"text","text":"x-anthropic-billing-header: cc_version=2.1.92.0c0; cc_entrypoint=cli; cch=dc51e;"},{"type":"text","text":"You are Claude Code, Anthropic's official CLI for Claude."},{"type":"text","text":"Generate a short kebab-case name (2-4 words) that captures the main topic of this conversation. Use lowercase words separated by hyphens. Examples: \"fix-login-bug\", \"add-auth-feature\", \"refactor-api-client\", \"debug-test-failures\". Return JSON with a \"name\" field."}],"tools":[],"metadata":{"user_id":"{\"device_id\":\"65343aad5d16bab6cb161b512a230bbaec090853c2ca03abbb4f2f8e6751438a\",\"account_uuid\":\"\",\"session_id\":\"28450766-579f-4289-99ba-6584ba38a808\"}"},"max_tokens":32000,"temperature":1,"output_config":{"format":{"type":"json_schema","schema":{"type":"object","properties":{"name":{"type":"string"}},"required":["name"],"additionalProperties":false}}},"stream":true},7:headers;981:29:6:Accept,16:application/json,]31:13:Authorization,10:[REDACTED],]36:12:Content-Type,16:application/json,]51:10:User-Agent,33:claude-cli/2.1.92 (external, cli),]68:24:X-Claude-Code-Session-Id,36:28450766-579f-4289-99ba-6584ba38a808,]28:16:X-Stainless-Arch,5:arm64,]25:16:X-Stainless-Lang,2:js,]26:14:X-Stainless-OS,5:Linux,]40:27:X-Stainless-Package-Version,6:0.80.0,]31:23:X-Stainless-Retry-Count,1:0,]30:19:X-Stainless-Runtime,4:node,]41:27:X-Stainless-Runtime-Version,7:v24.3.0,]29:19:X-Stainless-Timeout,3:600,]173:14:anthropic-beta,150:interleaved-thinking-2025-05-14,redact-thinking-2026-02-12,context-management-2025-06-27,prompt-caching-scope-2026-01-05,structured-outputs-2025-12-15,]52:41:anthropic-dangerous-direct-browser-access,4:true,]35:17:anthropic-version,10:2023-06-01,]26:9:x-api-key,10:[REDACTED],]14:5:x-app,3:cli,]28:10:Connection,10:keep-alive,]28:4:Host,17:api.anthropic.com,]46:15:Accept-Encoding,23:gzip, deflate, br, zstd,]25:14:Content-Length,4:2038,]]12:http_version;8:HTTP/1.1,}6:backup;0:~17:timestamp_created;17:1775470365.622155^7:comment;0:;8:metadata;0:}6:marked;0:;9:is_replay;0:~11:intercepted;5:false!11:server_conn;4101:3:via;0:~19:timestamp_tcp_setup;18:1775470221.7612765^7:address;27:17:api.anthropic.com;3:443#]19:timestamp_tls_setup;18:1775470221.7891612^13:timestamp_end;0:~15:timestamp_start;18:1775470221.7322285^3:sni;17:api.anthropic.com;11:tls_version;7:TLSv1.3;11:cipher_list;0:]6:cipher;22:TLS_AES_256_GCM_SHA384;11:alpn_offers;0:]4:alpn;0:,16:certificate_list;3569:1318:-----BEGIN CERTIFICATE-----
