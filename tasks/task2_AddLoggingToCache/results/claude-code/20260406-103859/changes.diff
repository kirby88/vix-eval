+// TrackTracing.swift
+// Distributed tracing abstractions for the Track cache library.
+//
+// The library carries no hard dependency on any specific tracing SDK.
+// Consumers implement TrackTracer (and its associated types) using whatever
+// backend they prefer — OpenTelemetry, Jaeger, a custom logger, etc. — and
+// inject an instance via the `tracer` property on Cache, MemoryCache, or
+// DiskCache.
+
+import Foundation
+
+// MARK: - TrackSpanContext
+
+/// An opaque token representing a trace context.
+///
+/// Track never inspects the contents of a context — the concrete type is
+/// fully defined by the integrating tracing SDK. Passing a context to a
+/// cache method creates a child span under that context, enabling trace
+/// propagation across service boundaries and async hops.
+///
+/// Contexts must be value types (structs) so they can be safely captured by
+/// closures and passed across dispatch queue boundaries without aliasing.
+public protocol TrackSpanContext {}
+
+// MARK: - TrackSpanOutcome
+
+/// The outcome of a cache operation.
+///
+/// Defined as an extensible struct (rather than an enum) so integrators can
+/// introduce custom outcomes — e.g. `TrackSpanOutcome("partial_hit")` —
+/// without modifying the library source.
+public struct TrackSpanOutcome: Equatable {
+    public let value: String
+
+    public init(_ value: String) {
+        self.value = value
+    }
+
+    /// The key was found in the cache.
+    public static let hit     = TrackSpanOutcome("hit")
+    /// The key was not found in the cache.
+    public static let miss    = TrackSpanOutcome("miss")
+    /// The operation completed successfully.
+    public static let success = TrackSpanOutcome("success")
+    /// The operation failed (e.g. the cache instance was deallocated).
+    public static let failure = TrackSpanOutcome("failure")
+    /// One or more entries were removed during an eviction pass.
+    public static let evicted = TrackSpanOutcome("evicted")
+}
+
+// MARK: - TrackSpanAttributes
+
+/// The set of attributes recorded on a cache span.
+///
+/// All fields are optional except `cacheName` and `operation`.
+/// Attributes are recorded by calling `TrackSpan.setAttributes(_:)`, which
+/// may be called more than once on the same span as more information becomes
+/// available (e.g. the outcome is only known after the operation completes).
+public struct TrackSpanAttributes {
+    /// The name of the cache instance (disk cache folder name, or "MemoryCache").
+    public var cacheName: String
+
+    /// The logical operation: `"set"`, `"get"`, `"remove"`, `"removeAll"`,
+    /// or `"trim"`.
+    public var operation: String
+
+    /// The cache key targeted by this operation, if applicable.
+    public var key: String?
+
+    /// The result of the operation.
+    public var outcome: TrackSpanOutcome?
+
+    /// The byte size of the stored value.
+    ///
+    /// For DiskCache this is the allocated file size measured after archiving.
+    /// For MemoryCache this is the `cost` value supplied by the caller.
+    public var valueByteSize: UInt?
+
+    /// The cost explicitly passed by the caller at the time of `set`.
+    public var cost: UInt?
+
+    public init(
+        cacheName: String,
+        operation: String,
+        key: String? = nil,
+        outcome: TrackSpanOutcome? = nil,
+        valueByteSize: UInt? = nil,
+        cost: UInt? = nil
+    ) {
+        self.cacheName = cacheName
+        self.operation = operation
+        self.key = key
+        self.outcome = outcome
+        self.valueByteSize = valueByteSize
+        self.cost = cost
+    }
+}
+
+// MARK: - TrackSpan
+
+/// A single in-flight tracing span.
+///
+/// Spans are class-bound so they can be captured by async closures and
+/// retained across dispatch queue boundaries without being copied.
+///
+/// Lifecycle: created by `TrackTracer.startSpan`, updated with
+/// `setAttributes`, finished with `end`. Call `end` exactly once — further
+/// calls after `end` have implementation-defined behaviour.
+public protocol TrackSpan: AnyObject {
+    /// The context of this span. Pass this as the `context` argument of a
+    /// cache method to create a child span under the current span.
+    var spanContext: TrackSpanContext { get }
+
+    /// Record or update attributes on this span.
+    ///
+    /// May be called multiple times; later calls should merge or replace
+    /// fields from earlier calls.
+    func setAttributes(_ attributes: TrackSpanAttributes)
+
+    /// Mark the span as finished. Must be called exactly once.
+    func end()
+}
+
+// MARK: - TrackTracer
+
+/// A factory that creates tracing spans.
+///
+/// Inject a conforming instance into a cache via its `tracer` property to
+/// enable tracing. Because `TrackTracer` is class-bound, the cache holds a
+/// strong reference to it — the tracer's lifetime is at least as long as the
+/// cache it is injected into.
+///
+/// The library never creates a default `TrackTracer` — tracing is fully
+/// opt-in per cache instance.
+public protocol TrackTracer: AnyObject {
+    /// Start a new span, optionally as a child of `context`.
+    ///
+    /// - Parameters:
+    ///   - name: A human-readable name for the span (e.g. `"MemoryCache.set"`).
+    ///   - context: The parent context, or `nil` to create a root span.
+    ///   - attributes: Initial attributes known at span creation time.
+    /// - Returns: The new span. The caller is responsible for calling `end()`
+    ///   when the operation represented by the span completes.
+    func startSpan(
+        named name: String,
+        childOf context: TrackSpanContext?,
+        attributes: TrackSpanAttributes
+    ) -> TrackSpan
+}
