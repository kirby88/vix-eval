+//
+//  Tracing.swift
+//  Track
+//
+//  Distributed tracing support for the Track cache library.
+//  The library defines only protocols and a context carrier — it never
+//  imports any specific tracing SDK. Callers supply a concrete
+//  TraceBackend implementation (wrapping OpenTelemetry, Datadog, etc.)
+//  and pass a TraceContext per call. When traceContext is nil the entire
+//  tracing path is skipped with no overhead.
+//
+
+import Foundation
+
+// MARK: - Core Protocols
+
+/// Opaque carrier for an SDK-specific span context.
+/// Implementations hold whatever the backing SDK needs to propagate a
+/// span across boundaries. The library never inspects the contents —
+/// it only passes the value through when starting child spans.
+public protocol TraceSpanContext: AnyObject {}
+
+/// Represents a single unit of work recorded by the tracing backend.
+///
+/// - Thread safety: all methods must be safe to call from any thread;
+///   implementations are responsible for their own internal synchronisation.
+/// - Lifecycle: `end()` must be called exactly once per span.
+public protocol TraceSpan: AnyObject {
+    /// Attach a string-valued attribute to this span.
+    func setAttribute(_ key: String, stringValue value: String)
+    /// Attach an integer-valued attribute to this span.
+    func setAttribute(_ key: String, intValue value: Int)
+    /// The propagatable context of this span, used to start child spans.
+    var context: TraceSpanContext { get }
+    /// Mark the span as finished. Must be called exactly once.
+    func end()
+}
+
+/// Factory for creating spans. The library never imports any tracing SDK;
+/// callers provide a concrete implementation of this protocol.
+public protocol TraceBackend: AnyObject {
+    /// Start a new span with the given name.
+    /// - Parameters:
+    ///   - name: The operation name for this span.
+    ///   - parentContext: The parent span's context, or nil for a root span.
+    func startSpan(named name: String, parentContext: TraceSpanContext?) -> TraceSpan
+}
+
+// MARK: - Context Carrier
+
+/// Immutable value passed into every public cache API to carry the
+/// caller's trace context into the cache operation.
+///
+/// Usage:
+/// ```swift
+/// let ctx = TraceContext(parentContext: currentSpan.context, backend: myBackend)
+/// memoryCache.set(object: value, forKey: "key", traceContext: ctx)
+/// ```
+///
+/// **Thread safety**: `TraceContext` has only `let` properties and is safe
+/// to read from multiple threads simultaneously. It must appear explicitly
+/// in GCD closure capture lists — the library never stores it in
+/// queue-specific storage, which would leak context across concurrent ops.
+public final class TraceContext {
+    /// The parent span's context used when creating child spans. May be nil
+    /// when starting a new root trace.
+    public let parentContext: TraceSpanContext?
+    /// The backend used to create spans.
+    public let backend: TraceBackend
+
+    public init(parentContext: TraceSpanContext? = nil, backend: TraceBackend) {
+        self.parentContext = parentContext
+        self.backend = backend
+    }
+
+    /// Convenience: start a child span rooted at `parentContext`.
+    public func startChildSpan(named name: String) -> TraceSpan {
+        return backend.startSpan(named: name, parentContext: parentContext)
+    }
+}
+
+// MARK: - Outcome Values
+
+/// Standardised outcome labels recorded as `cache.outcome` span attributes.
+public enum TraceOutcome: String {
+    case hit      = "hit"
+    case miss     = "miss"
+    case set      = "set"
+    case removed  = "removed"
+    case evicted  = "evicted"
+}
+
+// MARK: - No-Op Implementations
+
+/// A `TraceSpanContext` that carries no data.
+public final class NoOpTraceSpanContext: TraceSpanContext {
+    public init() {}
+}
+
+/// A `TraceSpan` that discards every call. Used by `NoOpTraceBackend`.
+public final class NoOpTraceSpan: TraceSpan {
+    private let _context: TraceSpanContext = NoOpTraceSpanContext()
+    public var context: TraceSpanContext { return _context }
+    public init() {}
+    public func setAttribute(_ key: String, stringValue value: String) {}
+    public func setAttribute(_ key: String, intValue value: Int) {}
+    public func end() {}
+}
+
+/// A `TraceBackend` that creates `NoOpTraceSpan` instances.
+/// This is the default backend — when callers pass `traceContext = nil`
+/// no backend is invoked at all, making the nil-path truly zero-cost.
+public final class NoOpTraceBackend: TraceBackend {
+    public static let shared = NoOpTraceBackend()
+    private init() {}
+    public func startSpan(named name: String, parentContext: TraceSpanContext?) -> TraceSpan {
+        return NoOpTraceSpan()
+    }
+}
+
+// MARK: - Attribute Key Constants (internal)
+
+/// Fixed attribute key strings used across all cache classes.
+/// Kept internal so callers rely on the documented string values, not
+/// these symbols.
+enum TraceAttributeKey {
+    /// String: the cache's `name` property.
+    static let cacheName      = "cache.name"
+    /// String: "memory" | "disk" | "composite"
+    static let cacheType      = "cache.type"
+    /// String: the object key passed to the cache operation.
+    static let key            = "cache.key"
+    /// String: `TraceOutcome.rawValue`
+    static let outcome        = "cache.outcome"
+    /// Int: object cost (memory) or file size in bytes (disk).
+    static let byteSize       = "cache.byte_size"
+    /// Int: number of items evicted during a trim.
+    static let evictCount     = "cache.evict_count"
+    /// String: "count" | "cost" | "age"
+    static let trimStrategy   = "cache.trim_strategy"
+}
