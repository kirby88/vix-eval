+import Foundation
+
+// MARK: - Core Protocols
+
+/// Opaque carrier for an in-flight trace context (W3C traceparent, OpenTelemetry, etc.).
+/// The library never inspects the contents — it only passes this value as `parent`
+/// when starting child spans, so any backend can store whatever it needs here.
+public protocol TrackTraceContext: AnyObject {}
+
+/// A single timed unit of work within a trace.
+/// Attributes must be set before calling `end()`.
+public protocol TrackSpan: AnyObject {
+    /// Context representing this span; pass as `parent` to create child spans.
+    var context: TrackTraceContext { get }
+    func setAttribute(_ key: String, stringValue value: String)
+    func setAttribute(_ key: String, intValue value: Int)
+    func end()
+}
+
+/// Factory for creating spans. Inject one instance into a cache to enable tracing.
+/// The library ships only a no-op default; callers swap in their own implementation
+/// (OpenTelemetry, Datadog, custom, etc.) without any library recompilation.
+public protocol TrackTracer: AnyObject {
+    /// Start a new span. If `parent` is non-nil the span is a child of that context;
+    /// otherwise it starts a new root trace.
+    func startSpan(named name: String, parent: TrackTraceContext?) -> TrackSpan
+}
+
+// MARK: - No-op defaults
+
+/// No-op tracer used by default so the library operates with zero overhead when
+/// no tracing backend has been configured.
+public final class TrackNoopTracer: TrackTracer {
+    public static let shared = TrackNoopTracer()
+    private init() {}
+
+    public func startSpan(named name: String, parent: TrackTraceContext?) -> TrackSpan {
+        return TrackNoopSpan.shared
+    }
+}
+
+/// No-op span returned by `TrackNoopTracer`. All methods are empty; the context
+/// property returns a stable singleton so child-span creation never crashes.
+public final class TrackNoopSpan: TrackSpan {
+    public static let shared = TrackNoopSpan()
+    private static let _sharedContext = _TrackNoopContext()
+    private init() {}
+
+    public var context: TrackTraceContext { return TrackNoopSpan._sharedContext }
+    public func setAttribute(_ key: String, stringValue value: String) {}
+    public func setAttribute(_ key: String, intValue value: Int) {}
+    public func end() {}
+}
+
+private final class _TrackNoopContext: TrackTraceContext {}
+
+// MARK: - Span attribute key constants
+
+/// Standard attribute keys used on every span emitted by the Track library.
+public enum TrackSpanAttributes {
+    /// The cache's `name` property (e.g. "defaultTrackCache").
+    public static let cacheName    = "track.cache.name"
+    /// The key passed to the cache operation.
+    public static let cacheKey     = "track.cache.key"
+    /// The outcome of the operation — see `TrackSpanOutcome`.
+    public static let outcome      = "track.cache.outcome"
+    /// Which storage tier handled the operation: "memory", "disk", or "unified".
+    public static let layer        = "track.cache.layer"
+    /// Bytes returned by a read operation (0 on miss).
+    public static let bytesRead    = "track.cache.bytes_read"
+    /// Bytes consumed by a write operation (may be 0 if cost was not provided).
+    public static let bytesWritten = "track.cache.bytes_written"
+}
+
+// MARK: - Span outcome value constants
+
+/// Values recorded under `TrackSpanAttributes.outcome`.
+public enum TrackSpanOutcome {
+    /// A read found the requested key.
+    public static let hit     = "hit"
+    /// A read did not find the requested key.
+    public static let miss    = "miss"
+    /// An object was stored.
+    public static let set     = "set"
+    /// An object (or all objects) was removed.
+    public static let removed = "removed"
+    /// One or more objects were evicted by a trim operation.
+    public static let trimmed = "trimmed"
+}
