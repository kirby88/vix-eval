+import Foundation
+
+// MARK: - Public Protocols
+
+/**
+ Opaque trace context marker. Must be a class (reference type) so it can be safely
+ captured by GCD closures and shared across dispatch hops without copying.
+ Callers receive a TraceContext from their tracing SDK and pass it into cache operations.
+ */
+public protocol TraceContext: AnyObject {}
+
+/**
+ A live span representing a single cache operation.
+ Attributes should be set before calling end().
+ */
+public protocol TraceSpan: AnyObject {
+    func setAttribute(_ key: String, value: String)
+    func setAttribute(_ key: String, value: Int)
+    func setAttribute(_ key: String, value: UInt)
+    /// Marks the span as complete. Must be called exactly once.
+    func end()
+}
+
+/**
+ Backend-agnostic tracing provider. Implement this protocol with your SDK
+ (OpenTelemetry, Datadog, os_signpost, etc.) and register it via TraceProviderRegistry.
+
+ startSpan returns both the new span AND a child context. The child context is what
+ callers must pass when starting nested spans — it encodes the parent/child relationship.
+ The span itself is used for recording attributes and ending the operation.
+ */
+public protocol TraceProvider: AnyObject {
+    func startSpan(name: String, context: TraceContext?) -> (TraceSpan, TraceContext)
+}
+
+// MARK: - Registry
+
+/**
+ Global registry for the tracing backend.
+
+ Set TraceProviderRegistry.shared once at app startup before any cache operations:
+
+     TraceProviderRegistry.shared = MyOpenTelemetryProvider()
+
+ When no provider is set, all cache operations produce noop spans with zero overhead
+ beyond the registry nil-check.
+
+ Thread-safe for concurrent reads; write is expected only at app startup.
+ */
+public final class TraceProviderRegistry {
+    private static let _lock = NSLock()
+    private static var _provider: TraceProvider?
+
+    public static var shared: TraceProvider? {
+        get {
+            _lock.lock()
+            defer { _lock.unlock() }
+            return _provider
+        }
+        set {
+            _lock.lock()
+            defer { _lock.unlock() }
+            _provider = newValue
+        }
+    }
+
+    private init() {}
+}
+
+// MARK: - Internal Noop Implementations
+
+final class _NoopTraceContext: TraceContext {}
+
+final class _NoopSpan: TraceSpan {
+    func setAttribute(_ key: String, value: String) {}
+    func setAttribute(_ key: String, value: Int) {}
+    func setAttribute(_ key: String, value: UInt) {}
+    func end() {}
+}
+
+// MARK: - Internal Helper
+
+/**
+ Creates a new span under the given parent context using the registered provider.
+ Returns (NoopSpan, NoopContext) when no provider is registered — callers never
+ need to nil-check the result.
+
+ - parameter name: Span name (e.g. "track.memory.set")
+ - parameter context: Parent trace context from the caller, or nil for a root span.
+ - returns: A (span, childContext) tuple. Pass childContext into nested operations.
+ */
+internal func _trackStartSpan(_ name: String, context: TraceContext?) -> (TraceSpan, TraceContext) {
+    guard let provider = TraceProviderRegistry.shared else {
+        return (_NoopSpan(), _NoopTraceContext())
+    }
+    return provider.startSpan(name: name, context: context)
+}
