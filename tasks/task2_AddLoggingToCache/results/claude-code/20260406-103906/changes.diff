+import Foundation
+
+// MARK: - Core Protocols
+
+/// Opaque trace context passed by callers to link cache operations into an existing trace.
+/// Implement this in your tracer adapter — the library never inspects the contents.
+public protocol TrackSpanContext: AnyObject {}
+
+/// A single tracing span. Set attributes, then end it exactly once.
+public protocol TrackSpan: AnyObject {
+    func setAttribute(_ key: String, value: TrackSpanValue)
+    /// Set the outcome attribute and close the span. Do not use the span after calling this.
+    func end(outcome: TrackSpanOutcome)
+}
+
+/// Implement this on your `TrackSpan` conformance to enable parent-child span linking.
+/// The library casts `TrackSpan` to `TrackSpanContextSource` via `as?` to extract the
+/// child context. If your span does not conform, child spans will be created as root spans.
+public protocol TrackSpanContextSource: AnyObject {
+    var context: TrackSpanContext? { get }
+}
+
+/// Swappable tracing backend. Implement this and assign to `TrackTracing.tracer` at startup.
+public protocol TrackTracer: AnyObject {
+    /// Start a new span. Must always return a non-nil value.
+    /// - Parameters:
+    ///   - operation: Human-readable operation name from `TrackTracingOperation`.
+    ///   - parent: Parent context, or nil for a root span.
+    func startSpan(operation: String, parent: TrackSpanContext?) -> TrackSpan
+}
+
+// MARK: - Typed Attribute Values
+
+public enum TrackSpanValue: Equatable {
+    case string(String)
+    case int(Int)
+    case bool(Bool)
+    case double(Double)
+}
+
+// MARK: - Span Outcomes
+
+public enum TrackSpanOutcome: String {
+    case hit       // object found and returned
+    case miss      // object not found
+    case set       // object stored
+    case removed   // object explicitly removed
+    case trimmed   // objects removed by a trim policy
+    case evicted   // objects removed by a system event (memory warning, app background)
+    case error     // internal error (e.g. self was deallocated, archiving failed)
+}
+
+// MARK: - No-op Implementations
+
+/// A span that does nothing. Shared singleton avoids heap allocation when tracing is disabled.
+public final class NoOpSpan: TrackSpan {
+    public static let shared = NoOpSpan()
+    private init() {}
+    public func setAttribute(_ key: String, value: TrackSpanValue) {}
+    public func end(outcome: TrackSpanOutcome) {}
+}
+
+/// A tracer that produces only `NoOpSpan` instances. Default backend.
+public final class NoOpTracer: TrackTracer {
+    public static let shared = NoOpTracer()
+    private init() {}
+    public func startSpan(operation: String, parent: TrackSpanContext?) -> TrackSpan {
+        return NoOpSpan.shared
+    }
+}
+
+// MARK: - Global Configuration
+
+/// Global tracing configuration. Replace `tracer` once at app startup (before any cache use)
+/// with a real implementation. The write-once contract means no locking is required.
+public final class TrackTracing {
+    public static var tracer: TrackTracer = NoOpTracer.shared
+}
+
+// MARK: - Operation Name Constants
+
+public enum TrackTracingOperation {
+    public static let memorySet       = "track.memory_cache.set"
+    public static let memoryGet       = "track.memory_cache.get"
+    public static let memoryRemove    = "track.memory_cache.remove"
+    public static let memoryRemoveAll = "track.memory_cache.remove_all"
+    public static let memoryTrimCount = "track.memory_cache.trim.count"
+    public static let memoryTrimCost  = "track.memory_cache.trim.cost"
+    public static let memoryTrimAge   = "track.memory_cache.trim.age"
+    public static let diskSet         = "track.disk_cache.set"
+    public static let diskGet         = "track.disk_cache.get"
+    public static let diskRemove      = "track.disk_cache.remove"
+    public static let diskRemoveAll   = "track.disk_cache.remove_all"
+    public static let diskTrimCount   = "track.disk_cache.trim.count"
+    public static let diskTrimCost    = "track.disk_cache.trim.cost"
+    public static let diskTrimAge     = "track.disk_cache.trim.age"
+    public static let cacheSet        = "track.cache.set"
+    public static let cacheGet        = "track.cache.get"
+    public static let cacheRemove     = "track.cache.remove"
+    public static let cacheRemoveAll  = "track.cache.remove_all"
+}
+
+// MARK: - Attribute Key Constants
+
+public enum TrackTracingAttribute {
+    /// Cache instance identifier (e.g. "memory", "defaultTrackCache").
+    public static let cacheName       = "cache.name"
+    /// The key being operated on.
+    public static let cacheKey        = "cache.key"
+    /// Size of the object involved (bytes). May be 0 if cost was not provided.
+    public static let objectBytes     = "cache.object_bytes"
+    /// Total cache cost after the operation (bytes or units).
+    public static let totalCostBytes  = "cache.total_cost_bytes"
+    /// System event that triggered eviction: "memory_warning" or "app_background".
+    public static let evictionTrigger = "cache.eviction_trigger"
+    /// Limit value passed to a trim call.
+    public static let trimLimit       = "cache.trim_limit"
+    /// Trim dimension: "count", "cost", or "age".
+    public static let trimType        = "cache.trim_type"
+}
