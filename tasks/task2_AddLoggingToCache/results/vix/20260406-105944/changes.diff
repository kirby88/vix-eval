+import Foundation
+
+public protocol CacheSpan {
+    func setAttribute(key: String, value: String)
+    func setAttribute(key: String, value: Int)
+    func setAttribute(key: String, value: Bool)
+    func end()
+}
+
+public struct CacheSpanContext {
+    public let storage: AnyObject
+    public init(storage: AnyObject) {
+        self.storage = storage
+    }
+}
+
+public protocol CacheTracer {
+    func startSpan(name: String, context: CacheSpanContext?) -> (span: CacheSpan, context: CacheSpanContext)
+}
+
+final class NoOpSpan: CacheSpan {
+    func setAttribute(key: String, value: String) {}
+    func setAttribute(key: String, value: Int) {}
+    func setAttribute(key: String, value: Bool) {}
+    func end() {}
+}
+
+final class NoOpCacheTracer: CacheTracer {
+    private static let sharedSpan = NoOpSpan()
+    private static let sharedContext = CacheSpanContext(storage: NSObject())
+
+    func startSpan(name: String, context: CacheSpanContext?) -> (span: CacheSpan, context: CacheSpanContext) {
+        return (NoOpCacheTracer.sharedSpan, NoOpCacheTracer.sharedContext)
+    }
+}
+
+enum SpanAttribute {
+    static let cacheName = "cache.name"
+    static let key = "cache.key"
+    static let outcome = "cache.outcome"
+    static let bytes = "cache.bytes"
+    static let backend = "cache.backend"
+}
+
+enum SpanOutcome {
+    static let hit = "hit"
+    static let miss = "miss"
+    static let set = "set"
+    static let removed = "removed"
+    static let evicted = "evicted"
+}
