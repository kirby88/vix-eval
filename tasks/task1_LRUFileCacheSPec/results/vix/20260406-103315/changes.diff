--- /dev/null
+++ b/Sources/LRUFileCache/LRUFileCache.swift
@@ -0,0 +1,153 @@
+import Foundation
+
+public final class LRUFileCache {
+    private let config: LRUFileCacheConfig
+    private let cacheDirectory: URL
+    private let queue: DispatchQueue
+    private let index: LRUFileCacheIndex
+    private var evictionWorkItem: DispatchWorkItem?
+
+    public init(config: LRUFileCacheConfig, baseDirectory: URL) throws {
+        self.config = config
+        self.cacheDirectory = baseDirectory.appendingPathComponent(config.name, isDirectory: true)
+        self.queue = DispatchQueue(label: "com.lrufilecache.\(config.name)", qos: .userInitiated)
+
+        try FileManager.default.createDirectory(
+            at: cacheDirectory,
+            withIntermediateDirectories: true,
+            attributes: [.protectionKey: config.dataProtectionClass]
+        )
+
+        self.index = LRUFileCacheIndex(cacheDirectory: cacheDirectory, queue: queue)
+    }
+
+    // MARK: - Public API
+
+    public func add(key: String, data: Data) throws {
+        try queue.sync {
+            try _add(key: key, data: data)
+        }
+    }
+
+    public func update(key: String, data: Data) throws {
+        try add(key: key, data: data)
+    }
+
+    public func modify(key: String, data: Data) throws {
+        try queue.sync {
+            guard index.entries[key] != nil else {
+                throw LRUFileCacheError.keyNotFound(key)
+            }
+            try _add(key: key, data: data)
+        }
+    }
+
+    public func get(key: String) -> Data? {
+        queue.sync {
+            guard let entry = index.entries[key] else { return nil }
+            let fileURL = cacheDirectory.appendingPathComponent(entry.fileName)
+            guard let data = try? Data(contentsOf: fileURL) else {
+                index.remove(key: key)
+                index.save()
+                return nil
+            }
+            index.touch(key: key)
+            index.scheduleDebouncedSave(interval: config.evictionDebounceInterval)
+            return data
+        }
+    }
+
+    public func promote(key: String) throws {
+        try queue.sync {
+            guard index.entries[key] != nil else {
+                throw LRUFileCacheError.keyNotFound(key)
+            }
+            index.touch(key: key)
+            index.scheduleDebouncedSave(interval: config.evictionDebounceInterval)
+        }
+    }
+
+    // MARK: - Private helpers
+
+    private func _add(key: String, data: Data) throws {
+        ensureCacheDirectoryExists()
+
+        if let existing = index.entries[key] {
+            let oldURL = cacheDirectory.appendingPathComponent(existing.fileName)
+            moveToTmp(fileURL: oldURL)
+        }
+
+        let fileName = UUID().uuidString
+        let fileURL = cacheDirectory.appendingPathComponent(fileName)
+
+        try data.write(to: fileURL, options: .atomic)
+        try? FileManager.default.setAttributes(
+            [.protectionKey: config.dataProtectionClass],
+            ofItemAtPath: fileURL.path
+        )
+
+        let entry = IndexEntry(
+            key: key,
+            fileName: fileName,
+            lastAccessedDate: Date(),
+            byteSize: data.count
+        )
+        index.upsert(entry: entry)
+        index.save()
+        scheduleEviction()
+    }
+
+    private func ensureCacheDirectoryExists() {
+        if !FileManager.default.fileExists(atPath: cacheDirectory.path) {
+            try? FileManager.default.createDirectory(
+                at: cacheDirectory,
+                withIntermediateDirectories: true,
+                attributes: [.protectionKey: config.dataProtectionClass]
+            )
+        }
+    }
+
+    private func moveToTmp(fileURL: URL) {
+        let tmpDir = FileManager.default.temporaryDirectory
+        var destination = tmpDir.appendingPathComponent(fileURL.lastPathComponent)
+        if FileManager.default.fileExists(atPath: destination.path) {
+            destination = tmpDir.appendingPathComponent("\(UUID().uuidString)_\(fileURL.lastPathComponent)")
+        }
+        try? FileManager.default.moveItem(at: fileURL, to: destination)
+    }
+
+    private func scheduleEviction() {
+        evictionWorkItem?.cancel()
+        let item = DispatchWorkItem { [weak self] in
+            self?.performEviction()
+        }
+        evictionWorkItem = item
+        DispatchQueue.global(qos: .background).asyncAfter(
+            deadline: .now() + config.evictionDebounceInterval,
+            execute: item
+        )
+    }
+
+    private func performEviction() {
+        let toEvict: [IndexEntry] = queue.sync {
+            index.entriesExceedingLimits(
+                maxCount: config.maxEntryCount,
+                maxBytes: config.maxTotalBytes
+            )
+        }
+
+        guard !toEvict.isEmpty else { return }
+
+        for entry in toEvict {
+            let fileURL = cacheDirectory.appendingPathComponent(entry.fileName)
+            moveToTmp(fileURL: fileURL)
+        }
+
+        queue.sync {
+            for entry in toEvict {
+                index.remove(key: entry.key)
+            }
+            index.save()
+        }
+    }
+}
