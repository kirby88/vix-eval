diff --git a/Sources/LRUFileCache/LRUFileCacheIndex.swift b/Sources/LRUFileCache/LRUFileCacheIndex.swift
new file mode 100644
index 0000000..e5d2ea4
--- /dev/null
+++ b/Sources/LRUFileCache/LRUFileCacheIndex.swift
@@ -0,0 +1,94 @@
+import Foundation
+
+struct IndexEntry: Codable {
+    let key: String
+    var fileName: String
+    var lastAccessedDate: Date
+    var byteSize: Int
+}
+
+final class LRUFileCacheIndex {
+    private(set) var entries: [String: IndexEntry] = [:]
+    private(set) var totalBytes: Int = 0
+
+    private let indexFileURL: URL
+    private var debouncedSaveWorkItem: DispatchWorkItem?
+    private let queue: DispatchQueue
+
+    init(cacheDirectory: URL, queue: DispatchQueue) {
+        self.indexFileURL = cacheDirectory.appendingPathComponent("index.json")
+        self.queue = queue
+        load()
+    }
+
+    private func load() {
+        guard let data = try? Data(contentsOf: indexFileURL) else { return }
+        guard let decoded = try? JSONDecoder().decode([IndexEntry].self, from: data) else { return }
+        for entry in decoded {
+            entries[entry.key] = entry
+        }
+        totalBytes = entries.values.reduce(0) { $0 + $1.byteSize }
+    }
+
+    func save() {
+        let list = Array(entries.values)
+        guard let data = try? JSONEncoder().encode(list) else { return }
+        try? data.write(to: indexFileURL, options: .atomic)
+    }
+
+    func scheduleDebouncedSave(interval: TimeInterval) {
+        debouncedSaveWorkItem?.cancel()
+        let item = DispatchWorkItem { [weak self] in
+            self?.queue.sync {
+                self?.save()
+            }
+        }
+        debouncedSaveWorkItem = item
+        DispatchQueue.global(qos: .utility).asyncAfter(deadline: .now() + interval, execute: item)
+    }
+
+    func upsert(entry: IndexEntry) {
+        if let existing = entries[entry.key] {
+            totalBytes -= existing.byteSize
+        }
+        entries[entry.key] = entry
+        totalBytes += entry.byteSize
+    }
+
+    func remove(key: String) {
+        if let existing = entries[key] {
+            totalBytes -= existing.byteSize
+            entries.removeValue(forKey: key)
+        }
+    }
+
+    func touch(key: String) {
+        entries[key]?.lastAccessedDate = Date()
+    }
+
+    func entriesExceedingLimits(maxCount: Int, maxBytes: Int) -> [IndexEntry] {
+        let overCount = entries.count - maxCount
+        let overBytes = totalBytes - maxBytes
+        guard overCount > 0 || overBytes > 0 else { return [] }
+
+        let sorted = entries.values.sorted { $0.lastAccessedDate < $1.lastAccessedDate }
+
+        var toEvict: [IndexEntry] = []
+        var removedCount = 0
+        var removedBytes = 0
+
+        for entry in sorted {
+            let stillOverCount = (entries.count - removedCount) > maxCount
+            let stillOverBytes = (totalBytes - removedBytes) > maxBytes
+            if stillOverCount || stillOverBytes {
+                toEvict.append(entry)
+                removedCount += 1
+                removedBytes += entry.byteSize
+            } else {
+                break
+            }
+        }
+
+        return toEvict
+    }
+}
