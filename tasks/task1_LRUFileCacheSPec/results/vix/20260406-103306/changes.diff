@@ -0,0 +1,23 @@
+import Foundation
+
+public struct CacheConfiguration {
+    public let name: String
+    public let maxEntryCount: Int
+    public let maxTotalBytes: Int
+    public let evictionDebounce: Duration
+    public let dataProtection: FileProtectionType
+
+    public init(
+        name: String,
+        maxEntryCount: Int,
+        maxTotalBytes: Int,
+        evictionDebounce: Duration = .seconds(1),
+        dataProtection: FileProtectionType = .complete
+    ) {
+        self.name = name
+        self.maxEntryCount = maxEntryCount
+        self.maxTotalBytes = maxTotalBytes
+        self.evictionDebounce = evictionDebounce
+        self.dataProtection = dataProtection
+    }
+}
