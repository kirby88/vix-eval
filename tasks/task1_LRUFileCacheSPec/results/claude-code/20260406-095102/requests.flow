truct + FileProtectionType default\n  CacheEntry.swift           # Codable index entry (key, filename, sizeBytes, dates)\n  FileHasher.swift           # SHA256(key) ‚Üí 64-char hex filename\n  CacheIndex.swift           # In-memory [String: CacheEntry] dict + eviction logic\n  Internal/\n    DebounceTask.swift        # Cancel-and-recreate debounce helper (@unchecked Sendable)\n  DiskCache.swift            # Public actor ‚Äî all public API methods\nTests/DiskCacheTests/\n  Helpers/TempDirectoryFixture.swift\n  DiskCacheTests.swift\n  E"}]}],"system":[{"type":"text","text":"x-anthropic-billing-header: cc_version=2.1.92.83c; cc_entrypoint=cli; cch=43d79;"},{"type":"text","text":"You are Claude Code, Anthropic's official CLI for Claude."},{"type":"text","text":"Generate a short kebab-case name (2-4 words) that captures the main topic of this conversation. Use lowercase words separated by hyphens. Examples: \"fix-login-bug\", \"add-auth-feature\", \"refactor-api-client\", \"debug-test-failures\". Return JSON with a \"name\" field."}],"tools":[],"metadata":{"user_id":"{\"device_id\":\"85fe1ca69d83f76ee3f5aedf498cd6009ee4d950524f69ea7521519e2e1a785c\",\"account_uuid\":\"\",\"session_id\":\"81396ac5-5393-4b77-89aa-7320577bcd3a\"}"},"max_tokens":32000,"temperature":1,"output_config":{"format":{"type":"json_schema","schema":{"type":"object","properties":{"name":{"type":"string"}},"required":["name"],"additionalProperties":false}}},"stream":true},7:headers;981:29:6:Accept,16:application/json,]31:13:Authorization,10:[REDACTED],]36:12:Content-Type,16:application/json,]51:10:User-Agent,33:claude-cli/2.1.92 (external, cli),]68:24:X-Claude-Code-Session-Id,36:81396ac5-5393-4b77-89aa-7320577bcd3a,]28:16:X-Stainless-Arch,5:arm64,]25:16:X-Stainless-Lang,2:js,]26:14:X-Stainless-OS,5:Linux,]40:27:X-Stainless-Package-Version,6:0.80.0,]31:23:X-Stainless-Retry-Count,1:0,]30:19:X-Stainless-Runtime,4:node,]41:27:X-Stainless-Runtime-Version,7:v24.3.0,]29:19:X-Stainless-Timeout,3:600,]173:14:an