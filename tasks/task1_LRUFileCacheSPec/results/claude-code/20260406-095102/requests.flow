event: content_block_delta
data: {"type":"content_block_delta","index":23,"delta":{"type":"citations_delta","citation":{"type":"web_search_result_location","cited_text":"In Swift 6.1 and earlier, when you called a nonisolated async function from the main actor, it would hop to a background thread. Even if it didn‚Äôt nee...","url":"https://blog.dominicrodemer.com/approachable-concurrency-in-swift-6-2/","title":"Swift 6.2's Approachable Concurrency: What Actually Changes - Dominic Rodemer's Blog","encrypted_index":"EpMBCioIDhgCIiQxOWQzOWVhYS1lZmI0LTQ5ZTAtYWZlOC1hNzM1OTcwMzcxOWESDNF4x/nCGwwg727KSxoMc3/Y3LHc/e6/qwR6IjBhiR3N+YWfoZhkWFM7IARBrppyPI3PNtsmFiSfM2s+bGQtGKtd5wORzoYWy1LNEXQqF/abOXiXjlwXvWszIN75KsoZLcT1cJb5GAQ="}}            }

event: content_block_delta
data: {"type":"content_block_delta","index":23,"delta":{"type":"text_delta","text":"In Swift 6.1 and earlier, when you called"}             }

event: content_block_delta
data: {"type":"content_block_delta","index":23,"delta":{"type":"text_delta","text":" a `nonisolated async` function from the main actor, it would hop to a background"}       }

event: content_block_delta
