event: content_block_delta
data: {"type":"content_block_delta","index":17,"delta":{"type":"text_delta","text":"Delegating initializers are conceptually a good"}             }

event: content_block_delta
data: {"type":"content_block_delta","index":17,"delta":{"type":"text_delta","text":" place to construct a fresh instance of a non-`Sendable` value"}               }

event: content_block_delta
