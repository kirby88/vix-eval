data: {"type":"content_block_delta","index":25,"delta":{"type":"citations_delta","citation":{"type":"web_search_result_location","cited_text":"Swift 6.2 changes the default. Now, nonisolated async functions inherit the caller‚Äôs isolation. If you call them from the main actor, they run on the ...","url":"https://blog.dominicrodemer.com/approachable-concurrency-in-swift-6-2/","title":"Swift 6.2's Approachable Concurrency: What Actually Changes - Dominic Rodemer's Blog","encrypted_index":"EpMBCioIDhgCIiQxOWQzOWVhYS1lZmI0LTQ5ZTAtYWZlOC1hNzM1OTcwMzcxOWESDBHr8Tu6TTzzBLCXkhoMGBI2pj/8qaPuZXNmIjAmUlw3Dgi5hzNEu6OuXFbLHgqdUsgYTmXpITZe5g9d+RkgRUglCgToPpNFeQe7ZekqF6DQzLvwKPSLubTiKbAXa+PeHZPZtHqtGAQ="}}   }

event: content_block_delta
data: {"type":"content_block_delta","index":25,"delta":{"type":"text_delta","text":"Swift 6.2 changes this default."}              }

event: content_block_delta
data: {"type":"content_block_delta","index":25,"delta":{"type":"text_delta","text":" Now, `nonisolated async` functions **inherit the caller's isolation**"}  }

event: content_block_delta
data: {"type":"content_block_delta","index":25,"delta":{"type":"text_delta","text":". If you call them from the main actor, they run on the main actor."}}

