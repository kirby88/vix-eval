latforms this is a typealias for `FileProtectionType`.\n/// On other platforms it is a stub with the same static members.\n#if canImport(Darwin)\npublic typealias DataProtectionClass = FileProtectionType\n#else\npublic struct DataProtectionClass: RawRepresentable, Sendable, Hashable {\n    public let rawValue: String\n    public init(rawValue: String) { self.rawValue = rawValue }\n\n    public static let none = DataProtectionClass(rawValue: \"none\")\n    public static let complete = DataProtectionClass(rawValue: \"NSFileProtectionComplete\")\n    public static let completeUnlessOpen = DataProtectionClass(rawValue: \"NSFileProtectionCompleteUnlessOpen\")\n    public static let completeUntilFirstUserAuthentication =\n        DataProtectionClass(rawValue: \"NSFileProtectionCompleteUntilFirstUserAuthentication\")\n}\n#endif\n"}}]},{"role":"user","content":[{"tool_use_id":"toolu_011kv4eV3Gb6QeNZNBD5L5qs","type":"tool_result","content":"File created successfully at: /workspace/Sources/DiskCache/DataProtectionClass.swift"}]},{"role":"assistant","content":[{"type":"tool_use","id":"toolu_017LG4m8FbBBGhZ9ouPRaxTv","name":"Edit","input":{"replace_all":false,"file_path":"/workspace/Sources/DiskCache/CacheConfiguration.swift","old_string":"    public let dataProtection: FileProtectionType\n    public let baseDirectory: URL\n\n    public init(\n        name: String,\n        maxEntryCount: Int? = nil,\n        maxTotalBytes: Int? = nil,\n        evictionDebounceInterval: Duration = .milliseconds(500),\n        dataProtection: FileProtectionType = .completeUntilFirstUserAuthentication,\n        baseDirectory: URL? = nil","new_string":"    public let dataProtection: DataProtectionClass\n    public let baseDirectory: URL\n\n    public init(\n        name: String,\n        maxEntryCount: Int? = nil,\n        maxTotalBytes: Int? = nil,\n        evictionDebounceInterval: Duration = .milliseconds(500),\n        dataProtection: DataProtectionClass = .completeUntilFirstUserAuthentication