,7:headers;1619:40:4:Date,29:Mon, 06 Apr 2026 08:51:14 GMT,]52:12:Content-Type,32:text/event-stream; charset=utf-8,]31:17:Transfer-Encoding,7:chunked,]28:10:Connection,10:keep-alive,]28:13:Cache-Control,8:no-cache,]52:38:anthropic-ratelimit-input-tokens-limit,7:4000000,]56:42:anthropic-ratelimit-input-tokens-remaining,7:4000000,]66:38:anthropic-ratelimit-input-tokens-reset,20:2026-04-06T08:51:13Z,]52:39:anthropic-ratelimit-output-tokens-limit,6:800000,]56:43:anthropic-ratelimit-output-tokens-remaining,6:800000,]67:39:anthropic-ratelimit-output-tokens-reset,20:2026-04-06T08:51:13Z,]45:34:anthropic-ratelimit-requests-limit,4:4000,]49:38:anthropic-ratelimit-requests-remaining,4:3999,]62:34:anthropic-ratelimit-requests-reset,20:2026-04-06T08:51:13Z,]46:32:anthropic-ratelimit-tokens-limit,7:4800000,]50:36:anthropic-ratelimit-tokens-remaining,7:4800000,]60:32:anthropic-ratelimit-tokens-reset,20:2026-04-06T08:51:13Z,]46:10:request-id,28:req_011CZnEQeFjWNUGsh5EuWNxS,]77:25:strict-transport-security,44:max-age=31536000; includeSubDomains; preload,]69:25:anthropic-organization-id,36:19d39eaa-efb4-49e0-afe8-a7359703719a,]23:6:Server,10:cloudflare,]40:29:x-envoy-upstream-service-time,4:1171,]46:13:server-timing,25:x-originResponse;dur=1172,]29:15:cf-cache-status,7:DYNAMIC,]207:10:set-cookie,188:_cfuvid=dXlJ65.QDwZQZlpL5hVwX6Sr1j5vDFOxKztaMuI3G9A-1775465473.100599-1.0.1.1-H4jRQzV0lb9I94z9o99KLSO4N9ZPjEIsi6SIIqPXQu4; HttpOnly; SameSite=None; Secure; Path=/; Domain=api.anthropic.com,]73:23:Content-Security-Policy,42:default-src 'none'; frame-ancestors 'none',]23:12:X-Robots-Tag,4:none,]33:6:CF-RAY,20:9e7f8ca6d890ade6-DUB,]]12:http_version;8:HTTP/1.1,}7:request;4663:4:path;22:/v1/messages?beta=true,9:authority;0:,6:scheme;5:https,6:method;4:POST,4:port;3:443#4:host;17:api.anthropic.com;13:timestamp_end;18:1775465472.9532022^15:timestamp_start;16:1775465472.95261^8:trailers;0:~7:content;3410:{"model":"claude-haiku-4-5-20251001","messages":[{"role":"user","content":[{"type":"text","text":"# LRU File Cache ‚Äî Swift Spec\n\n## Requirements\n\n- Disk-backed LRU cache for iOS\n- Support multiple independent named caches (e.g. images, videos), each with their own configuration\n- Fast start: cache must be usable immediately after init with no blocking I/O on the hot path\n- LRU order is determined by last-accessed date\n- Eviction runs asynchronously and must not block reads or writes\n- Eviction moves files to the system `tmp/` directory rather than deleting them; file name collisions in `tmp/` must be handled\n- All insertions use atomic writes\n- The index (LRU metadata) is persisted to disk and survives process restarts\n\n## Configuration (per cache)\n\n- Name (used as the on-disk namespace)\n- Max entry count\n- Max total byte size\n- Eviction debounce interval\n- iOS data protection class\n\n## API\n\n| Method | Description |\n|---|---|\n| `add(key, data)` | Insert a new entry; replace if key already exists |\n| `update(key, data)` | Alias for `add`; signals update intent to the caller |\n| `modify(key, data)` | Replace payload for an existing key; error if key is absent |\n| `get(key)` | Return payload and bump last-accessed date; return nil if absent |\n| `promote(key)` | Update last-accessed date without reading the payload; error if key is absent |\n\n## Constraints\n\n- `modify` must fail explicitly if the key does not exist; `add` and `update` must not\n- `get` and `promote` both count as an access and must update LRU order\n- Index persistence triggered by `get`/`promote` should be debounced to avoid write amplification\n- Index persistence triggered by mutations (`add`, `modify`, eviction) must be immediate\n- A cache directory deleted externally must be recreated on next write\n- A corrupted index on init must degrade gracefully to an empty cache, not a crash\n- A file present in the index but missing on disk at `get` time must return nil and self-heal the index"}]}],"system":[{"type":"text","text":"x-anthropic-billing-header: cc_version=2.1.92.83c; cc_entrypoint=cli; cch=688d3;"},{"type":"text","text":"You are Claude Code, Anthropic's official CLI for Claude."},{"type":"text","text":"Generate a concise, sentence-case title (3-7 words) that captures the main topic or goal of this coding session. The title should be clear enough that the user recognizes the session in a list. Use sentence case: capitalize only the first word and proper nouns.\n\nReturn JSON with a single \"title\" field.\n\nGood examples:\n{\"title\": \"Fix login button on mobile\"}\n{\"title\": \"Add OAuth authentication\"}\n{\"title\": \"Debug failing CI tests\"}\n{\"title\": \"Refactor API client error handling\"}\n\nBad (too vague): {\"title\": \"Code changes\"}\nBad (too long): {\"title\": \"Investigate and fix the issue where the login button does not respond on mobile devices\"}\nBad (wrong case): {\"title\": \"Fix Login Button On Mobile\"}"}],"tools":[],"metadata":{"user_id":"{\"device_id\":\"85fe1ca69d83f76ee3f5aedf498cd6009ee4d950524f69ea7521519e2e1a785c\",\"account_uuid\":\"\",\"session_id\":\"81396ac5-5393-4b77-89aa-7320577bcd3a\"}"},"max_tokens":32000,"temperature":1,"output_config":{"format":{"type":"json_schema","schema":{"type":"object","properties":{"title":{"type":"string"}},"required":["title"],"additionalProperties":false}}},"stream":true},7:headers;981:29:6:Accept,16:application/json,]31:13:Authorization,10:[REDACTED],]36:12:Content-Type,16:application/json,]51:10:User-Agent,33:claude-cli/2.1.92 (external, cli),]68:24:X-Claude-Code-Session-Id,36:81396ac5-5393-4b77-89aa-7320577bcd3a,]28:16:X-Stainless-Arch,5:arm64,]25:16:X-Stainless-Lang,2:js,]26:14:X-Stainless-OS,5:Linux,]40:27:X-Stainless-Package-Version,6:0.80.0,]31:23:X-Stainless-Retry-Count,1:0,]30:19:X-Stainless-Runtime,4:node,]41:27:X-Stainless-Runtime-Version,7:v24.3.0,]29:19:X-Stainless-Timeout,3:600,]173:14:anthropic-beta,150:interleaved-thinking-2025-05-14,redact-thinking-2026-02-12,context-management-2025-06-27,prompt-caching-scope-2026-01-05,structured-outputs-2025-12-15,]52:41:anthropic-dangerous-direct-browser-access,4:true,]35:17:anthropic-version,10:2023-06-01,]26:9:x-api-key,10:[REDACTED],]14:5:x-app,3:cli,]28:10:Connection,10:keep-alive,]28:4:Host,17:api.anthropic.com,]46:15:Accept-Encoding,23:gzip, deflate, br, zstd,]25:14:Content-Length,4:3410,]]12:http_version;8:HTTP/1.1,}6:backup;0:~17:timestamp_created;18:1775465472.9527175^7:comment;0:;8:metadata;0:}6:marked;0:;9:is_replay;0:~11:intercepted;5:false!11:server_conn;4099:3:via;0:~19:timestamp_tcp_setup;17:1775465472.985891^7:address;27:17:api.anthropic.com;3:443#]19:timestamp_tls_setup;18:1775465473.0179305^13:timestamp_end;0:~15:timestamp_start;17:1775465472.953822^3:sni;17:api.anthropic.com;11:tls_version;7:TLSv1.3;11:cipher_list;0:]6:cipher;22:TLS_AES_256_GCM_SHA384;11:alpn_offers;0:]4:alpn;0:,16:certificate_list;3569:1318:-----BEGIN CERTIFICATE-----
