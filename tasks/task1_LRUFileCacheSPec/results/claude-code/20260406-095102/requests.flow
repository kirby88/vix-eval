event: content_block_delta
data: {"type":"content_block_delta","index":7,"delta":{"type":"text_delta","text":"Sendability is a contract, initiated"}              }

event: content_block_delta
data: {"type":"content_block_delta","index":7,"delta":{"type":"text_delta","text":" by the type, that the type is safe to be sent between tasks."}     }

event: content_block_delta
data: {"type":"content_block_delta","index":7,"delta":{"type":"text_delta","text":" Structs and enums are automatically `Sendable` if all of their properties are `Sendable`. Since"}   }

event: content_block_delta
data: {"type":"content_block_delta","index":7,"delta":{"type":"text_delta","text":" value types are copied when they are sent between tasks, you can safely send a struct or enum between"}          }

event: content_block_delta
data: {"type":"content_block_delta","index":7,"delta":{"type":"text_delta","text":" tasks without worrying about race conditions."}  }

