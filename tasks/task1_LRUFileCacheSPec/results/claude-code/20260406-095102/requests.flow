data: {"type":"content_block_delta","index":31,"delta":{"type":"citations_delta","citation":{"type":"web_search_result_location","cited_text":"Use actors for repositories instead of Sendable classes. Make repository methods async so they safely cross actor boundaries. Mark all models as Senda...","url":"https://medium.com/@ankuriosdev/swift-concurrency-fixing-sendable-actor-isolation-and-data-race-errors-fc83d2d4e145","title":"Swift Concurrency: Fixing Sendable, Actor Isolation, and Data Race Errors | by Ankur Chauhan | Medium","encrypted_index":"EpMBCioIDhgCIiQxOWQzOWVhYS1lZmI0LTQ5ZTAtYWZlOC1hNzM1OTcwMzcxOWESDO7GuqxjrJksmYDYHRoMY7kX/LP+Tfj7rBMMIjCozTGCy5/vQZNzDzoPlaMFyL59m3xEHo5HEhxDv1EzsJFOh1YtMYbA0uLrATeKbsgqF/VHEq+TPa0O7yWB9AuvsQ0hTWp1lp3KGAQ="}}     }

event: content_block_delta
data: {"type":"content_block_delta","index":31,"delta":{"type":"text_delta","text":"Key guidelines:\n- Use **actors** for repositories instead"}       }

event: content_block_delta
data: {"type":"content_block_delta","index":31,"delta":{"type":"text_delta","text":" of `Sendable` classes.\n- Make repository methods `async` so they safely cross actor boundaries.\n- Mark"}          }

event: content_block_delta
data: {"type":"content_block_delta","index":31,"delta":{"type":"text_delta","text":" all models as `Sendable` (including nested ones).\n- Snapshot"}      }

event: content_block_delta
data: {"type":"content_block_delta","index":31,"delta":{"type":"text_delta","text":" mutable state before sending into a `Task`.\n- Avoid"}}

event: content_block_delta
data: {"type":"content_block_delta","index":31,"delta":{"type":"text_delta","text":" unsafe hacks like `@unchecked Sendable`."}          }

