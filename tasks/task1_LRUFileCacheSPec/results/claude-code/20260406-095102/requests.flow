n        // Spot-check a few entries\n        let r0 = await cache.get(key: \"k0\")\n        let r49 = await cache.get(key: \"k49\")\n        #expect(r0 == Data(\"v0\".utf8))\n        #expect(r49 == Data(\"v49\".utf8))\n    }\n\n    @Test func concurrentGetNoCrash() async throws {\n        let fixture = try TempDirectoryFixture()\n        defer { fixture.tearDown() }\n        let cache = DiskCache(configuration: fixture.makeConfig())\n        try await cache.add(key: \"shared\", data: Data(\"data\".utf8))\n\n        await withTaskGroup(of: Data?.self) { group in\n            for _ in 0..<50 {\n                group.addTask {\n                    await cache.get(key: \"shared\")\n                }\n            }\n            for await result in group {\n                #expect(result == Data(\"data\".utf8) || result == nil)\n            }\n        }\n    }\n\n    @Test func concurrentAddAndGet() async throws {\n        let fixture = try TempDirectoryFixture()\n        defer { fixture.tearDown() }\n        let cache = DiskCache(configuration: fixture.makeConfig())\n\n        await withTaskGroup(of: Void.self) { group in\n            for i in 0..<25 {\n                group.addTask {\n                    try? await cache.add(key: \"k\\(i)\", data: Data(\"v\\(i)\".utf8))\n                }\n                group.addTask {\n                    _ = await cache.get(key: \"k\\(i)\")\n                }\n            }\n        }\n        // No assertions ‚Äî test passes if no crash / data race\n    }\n\n    @Test func rapidAddsRespectCap() async throws {\n        let fixture = try TempDirectoryFixture()\n        defer { fixture.tearDown() }\n        let cache = DiskCache(configuration: fixture.makeConfig(maxEntryCount: 5))\n\n        try await withThrowingTaskGroup(of: Void.self) { group in\n            for i in 0..<30 {\n                group.addTask {\n                    try await cache.add(key: \"k\\(i)\", data: Data(\"v\\(i)\".utf8))\n                }\n            }\n            try await group.waitForAll()\n        }\n\n        // Allow eviction tasks to drain\n        try await Task.sleep(for: .milliseconds(200))\n\n        var count = 0\n        for i in 0..<30 {\n            if await cache.get(key: \"k\\(i)\") != nil { count += 1 }\n        }\n        #expect(count <= 5)\n    }\n}\n"}}]},{"role":"user","content":[{"tool_use_id":"toolu_019X9G78iDudKMfj3KC3Zrxb","type":"tool_result","content":"File created successfully at: /workspace/Tests/DiskCacheTests/ConcurrencyTests.swift"}]},{"role":"assistant","content":[{"type":"tool_use","id":"toolu_01M53ByexPh9ZHg7Nc8kcxh2","name":"Write","input":{"file_path":"/workspace/Tests/DiskCacheTests/EdgeCaseTests.swift","content":"import Foundation\nimport Testing\n@testable import DiskCache\n\n@Suite(\"Edge Cases\")\nstruct EdgeCaseTests {\n    @Test func selfHealMissingFileOnGet() async throws {\n        let fixture = try TempDirectoryFixture()\n        defer { fixture.tearDown() }\n        let cache = DiskCache(configuration: fixture.makeConfig())\n\n        try await cache.add(key: \"k1\", data: Data(\"v\".utf8))\n\n        // Delete the backing file directly\n        let cacheDir = fixture.url.appendingPathComponent(\"test\")\n        let files = try FileManager.default.contentsOfDirectory(atPath: cacheDir.path)\n            .filter { $0 != \"index.json\" && $0 != \"tmp\" }\n        for f in files {\n            try FileManager.default.removeItem(at: cacheDir.appendingPathComponent(f))\n        }\n\n        let result = await cache.get(key: \"k1\")\n        #expect(result == nil)\n    }\n\n    @Test func selfHealPersistsImmediately() async throws {\n        let fixture = try TempDirectoryFixture()\n        defer { fixture.tearDown() }\n        let config = fixture.makeConfig()\n        let cache1 = DiskCache(configuration: config)\n        try await cache1.add(key: \"k1\", data: Data(\"v\".utf8))\n\n        // Delete backing file\n        let cacheDir = fixture.url.appendingPathComponent(\"test\")\n        let files = try FileManager.default.contentsOfDirectory(atPath: cacheDir.path)\n            .filter { $0 != \"index.json\" && $0 != \"tmp\" }\n        for f in files {\n            try FileManager.default.removeItem(at: cacheDir.appendingPathComponent(f))\n        }\n\n        // Trigger self-heal\n        _ = await cache1.get(key: \"k1\")\n\n        // New cache should also not see k1 (index was healed and persisted)\n        let cache2 = DiskCache(configuration: config)\n        let result = await cache2.get(key: \"k1\")\n        #expect(result == nil)\n    }\n\n    @Test func cacheDirRecreatedAfterExternalDelete() async throws {\n        let fixture = try TempDirectoryFixture()\n        defer { fixture.tearDown() }\n        let cache = DiskCache(configuration: fixture.makeConfig())\n\n        try await cache.add(key: \"k1\", data: Data(\"v1\".utf8))\n\n        // Delete entire cache directory\n        let cacheDir = fixture.url.appendingPathComponent(\"test\")\n        try FileManager.default.removeItem(at: cacheDir)\n\n        // Next write should recreate the directory\n        try await cache.add(key: \"k2\", data: Data(\"v2\".utf8))\n        let result = await cache.get(key: \"k2\")\n        #expect(result == Data(\"v2\".utf8))\n    }\n\n    @Test func getAfterExternalCacheDirDeleteReturnsNil() async throws {\n        let fixture = try TempDirectoryFixture()\n        defer { fixture.tearDown() }\n        let cache = DiskCache(configuration: fixture.makeConfig())\n\n        try await cache.add(key: \"k1\", data: Data(\"v\".utf8))\n\n        let cacheDir = fixture.url.appendingPathComponent(\"test\")\n        try FileManager.default.removeItem(at: cacheDir)\n\n        let result = await cache.get(key: \"k1\")\n        #expect(result == nil)\n    }\n\n    @Test func debouncedPersistEventuallyFires() async throws {\n        let fixture = try TempDirectoryFixture()\n        defer { fixture.tearDown() }\n        // 50 ms debounce\n        let cache = DiskCache(configuration: fixture.makeConfig(evictionDebounceInterval: .milliseconds(50)))\n\n        try await cache.add(key: \"k1\", data: Data(\"v\".utf8))\n        // Repeatedly call get to trigger debounce resets\n        for _ in 0..<10 {\n            _ = await cache.get(key: \"k1\")\n        }\n\n        // Wait longer than debounce interval\n        try await Task.sleep(for: .milliseconds(200))\n\n        // Index on disk should reflect the last-accessed update (decodable)\n        let indexURL = fixture.url.appendingPathComponent(\"test/index.json\")\n        let data = try Data(contentsOf: indexURL)\n        let entries = try JSONDecoder().decode([CacheEntry].self, from: data)\n        #expect(entries.contains { $0.key == \"k1\" })\n    }\n\n    @Test func immediateWriteCancelsPendingDebounce() async throws {\n        let fixture = try TempDirectoryFixture()\n        defer { fixture.tearDown() }\n        let cache = DiskCache(configuration: fixture.makeConfig(evictionDebounceInterval: .milliseconds(200)))\n\n        try await cache.add(key: \"k1\", data: Data(\"v1\".utf8))\n        // Trigger debounced persist\n        _ = await cache.get(key: \"k1\")\n\n        // Immediate mutation should cancel the pending debounce and persist now\n        try await cache.add(key: \"k2\", data: Data(\"v2\".utf8))\n\n        let indexURL = fixture.url.appendingPathComponent(\"test/index.json\")\n        let data = try Data(contentsOf: indexURL)\n        let entries = try JSONDecoder().decode([CacheEntry].self, from: data)\n        #expect(entries.contains { $0.key == \"k2\" })\n    }\n}\n"}}]},{"role":"user","content":[{"tool_use_id":"toolu_01M53ByexPh9ZHg7Nc8kcxh2","type":"tool_result","content":"File created successfully at: /workspace/Tests/DiskCacheTests/EdgeCaseTests.swift"}]},{"role":"assistant","content":[{"type":"tool_use","id":"toolu_01Uxugb98njJxGMaqBeYH4Lf","name":"TaskUpdate","input":{"taskId":"3","status":"completed"}}]},{"role":"user","content":[{"tool_