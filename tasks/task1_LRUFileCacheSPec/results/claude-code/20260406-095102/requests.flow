event: content_block_delta
data: {"type":"content_block_delta","index":20,"delta":{"type":"text_delta","text":"\n\nA common pattern (from the Swift Evolution proposal"}            }

event: content_block_delta
data: {"type":"content_block_delta","index":20,"delta":{"type":"text_delta","text":") looks like:\n```swift\nclass NonSendable { init() {}"}}

event: content_block_delta
data: {"type":"content_block_delta","index":20,"delta":{"type":"text_delta","text":" }\n\n@MainActor class IsolatedType {\n    let a"}       }

event: content_block_delta
data: {"type":"content_block_delta","index":20,"delta":{"type":"text_delta","text":": NonSendable\n    // Create off the main thread using nonisolated init"}           }

event: content_block_delta
data: {"type":"content_block_delta","index":20,"delta":{"type":"text_delta","text":"\n    nonisolated init() {\n        a = NonSendable()\n    }\n}\n```"}     }

event: content_block_delta
data: {"type":"content_block_delta","index":20,"delta":{"type":"text_delta","text":"\n"}         }

