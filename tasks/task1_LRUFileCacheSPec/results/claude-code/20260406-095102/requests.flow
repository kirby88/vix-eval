event: content_block_delta
data: {"type":"content_block_delta","index":19,"delta":{"type":"text_delta","text":" property. Afterwards, access to most stored properties within the `init"}  }

event: content_block_delta
data: {"type":"content_block_delta","index":19,"delta":{"type":"text_delta","text":"` is lost, just like for the non-async case"}            }

