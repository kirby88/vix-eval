data: {"type":"content_block_delta","index":29,"delta":{"type":"citations_delta","citation":{"type":"web_search_result_location","cited_text":"@concurrent func processImage(_ data: Data) async -> UIImage? { // Heavy work that should NOT block the main actor let processed = applyFilters(to: da...","url":"https://blog.dominicrodemer.com/approachable-concurrency-in-swift-6-2/","title":"Swift 6.2's Approachable Concurrency: What Actually Changes - Dominic Rodemer's Blog","encrypted_index":"EpMBCioIDhgCIiQxOWQzOWVhYS1lZmI0LTQ5ZTAtYWZlOC1hNzM1OTcwMzcxOWESDB6734Z7gvHN7UmSkhoMXsTnRyNISUcXoo+TIjCbLrM3LLLP1c5q8ZEIolEYgmT3ECnHynvEnWWsdsIpHfOi41zogwd0pweXVTTsH7AqF+W1NdosPTOE3LIA/eSbzn7njMol5pFXGAQ="}}}

event: content_block_delta
data: {"type":"content_block_delta","index":29,"delta":{"type":"text_delta","text":"The new"}   }

event: content_block_delta
data: {"type":"content_block_delta","index":29,"delta":{"type":"text_delta","text":" `@concurrent` attribute can be used to explicitly opt a function into background execution:"}    }

event: content_block_delta
data: {"type":"content_block_delta","index":29,"delta":{"type":"text_delta","text":" `@concurrent func processImage(_ data: Data) async -> UIImage?`"}       }

