event: content_block_delta
data: {"type":"content_block_delta","index":19,"delta":{"type":"text_delta","text":"Calling an isolated method from an"}             }

event: content_block_delta
data: {"type":"content_block_delta","index":19,"delta":{"type":"text_delta","text":" initializer with a `nonisolated self` is permitted,"}         }

event: content_block_delta
data: {"type":"content_block_delta","index":19,"delta":{"type":"text_delta","text":" provided that you can `await` the call. That call"}  }

event: content_block_delta
data: {"type":"content_block_delta","index":19,"delta":{"type":"text_delta","text":" is considered a nonisolated use ‚Äî it's the first"}    }

event: content_block_delta
