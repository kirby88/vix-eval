data: {"type":"content_block_delta","index":27,"delta":{"type":"text_delta","text":"In short: Swift 6.2 runs `nonisolated async` functions"} }

event: content_block_delta
data: {"type":"content_block_delta","index":27,"delta":{"type":"text_delta","text":" on the **caller's actor** by default, unless the function is explicitly"}      }

event: content_block_delta
data: {"type":"content_block_delta","index":27,"delta":{"type":"text_delta","text":" marked `@concurrent`."}          }

