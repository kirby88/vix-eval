event: content_block_delta
data: {"type":"content_block_delta","index":33,"delta":{"type":"text_delta","text":"It's highly recommended to migrate and enable each upcoming Swift 6.2 feature individually"}           }

event: content_block_delta
data: {"type":"content_block_delta","index":33,"delta":{"type":"text_delta","text":" for existing projects. This ensures you're not suddenly introducing"} }

event: content_block_delta
