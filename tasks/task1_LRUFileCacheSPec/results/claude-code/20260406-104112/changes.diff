+++ b/Tests/DiskCacheTests/Helpers/TestCacheFactory.swift
@@ -0,0 +1,49 @@
+import Foundation
+@testable import DiskCache
+
+struct TestCacheFactory {
+    /// Creates a cache backed by a unique temp directory.
+    /// Debounce intervals are set to 0 so eviction and index saves fire immediately in tests.
+    static func make(
+        name: String = UUID().uuidString,
+        maxEntryCount: Int = 100,
+        maxTotalBytes: Int = 10 * 1024 * 1024,
+        evictionDebounce: TimeInterval = 0,
+        indexSaveDebounce: TimeInterval = 0
+    ) async throws -> (DiskCache, URL) {
+        let baseDir = FileManager.default.temporaryDirectory
+            .appendingPathComponent("DiskCacheTests-\(UUID().uuidString)", isDirectory: true)
+        try FileManager.default.createDirectory(at: baseDir, withIntermediateDirectories: true)
+
+        let config = CacheConfiguration(
+            name: name,
+            maxEntryCount: maxEntryCount,
+            maxTotalBytes: maxTotalBytes,
+            evictionDebounceInterval: evictionDebounce,
+            indexSaveDebounceInterval: indexSaveDebounce
+        )
+        let cache = try await DiskCache(configuration: config, baseDirectory: baseDir)
+        return (cache, baseDir)
+    }
+
+    static func cleanup(at url: URL) {
+        try? FileManager.default.removeItem(at: url)
+    }
+
+    /// Reopens a cache from an existing base directory (simulates process restart).
+    static func reopen(
+        name: String,
+        baseDirectory: URL,
+        maxEntryCount: Int = 100,
+        maxTotalBytes: Int = 10 * 1024 * 1024
+    ) async throws -> DiskCache {
+        let config = CacheConfiguration(
+            name: name,
+            maxEntryCount: maxEntryCount,
+            maxTotalBytes: maxTotalBytes,
+            evictionDebounceInterval: 0,
+            indexSaveDebounceInterval: 0
+        )
+        return try await DiskCache(configuration: config, baseDirectory: baseDirectory)
+    }
+}
