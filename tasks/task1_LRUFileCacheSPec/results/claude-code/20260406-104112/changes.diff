--- /dev/null
+++ b/Sources/DiskCache/DiskCache.swift
@@ -0,0 +1,51 @@
+import Foundation
+
+/// A disk-backed LRU file cache. Thread-safe; all methods are `async throws`.
+public struct DiskCache: Sendable {
+    private let actor: CacheActor
+
+    /// Creates a new cache (or opens an existing one) with the given configuration.
+    /// Index is loaded from disk during init; subsequent operations are non-blocking.
+    public init(configuration: CacheConfiguration) async throws {
+        guard let baseDir = FileManager.default
+            .urls(for: .applicationSupportDirectory, in: .userDomainMask).first
+        else {
+            throw CacheError.directoryCreationFailed(
+                underlying: CocoaError(.fileNoSuchFile)
+            )
+        }
+        self.actor = CacheActor(config: configuration, baseDirectory: baseDir)
+    }
+
+    // Internal init for testing with a custom base directory
+    init(configuration: CacheConfiguration, baseDirectory: URL) async throws {
+        self.actor = CacheActor(config: configuration, baseDirectory: baseDirectory)
+    }
+
+    /// Insert a new entry. If the key already exists, it is replaced.
+    public func add(key: String, data: Data) async throws {
+        try await actor.add(key: key, data: data)
+    }
+
+    /// Alias for `add`; signals update intent to the caller.
+    public func update(key: String, data: Data) async throws {
+        try await actor.add(key: key, data: data)
+    }
+
+    /// Replace the payload for an existing key. Throws `CacheError.keyNotFound` if absent.
+    public func modify(key: String, data: Data) async throws {
+        try await actor.modify(key: key, data: data)
+    }
+
+    /// Return the payload for the given key and bump its last-accessed date.
+    /// Returns `nil` if the key is absent or the file has been deleted externally.
+    public func get(key: String) async throws -> Data? {
+        try await actor.get(key: key)
+    }
+
+    /// Update the last-accessed date without reading the payload.
+    /// Throws `CacheError.keyNotFound` if the key is absent.
+    public func promote(key: String) async throws {
+        try await actor.promote(key: key)
+    }
+}
diff --git a/Sources/DiskCache/FileProtectionMapper.swift b/Sources/DiskCache/FileProtectionMapper.swift
new file mode 100644
index 0000000..36ee1cc
--- /dev/null
+++ b/Sources/DiskCache/FileProtectionMapper.swift
@@ -0,0 +1,21 @@
+import Foundation
+
+enum FileProtectionMapper {
+    static func fileAttributes(for cls: DataProtectionClass) -> [FileAttributeKey: Any] {
+#if os(iOS) || os(tvOS) || os(watchOS)
+        switch cls {
+        case .none:
+            return [.protectionKey: FileProtectionType.none]
+        case .complete:
+            return [.protectionKey: FileProtectionType.complete]
+        case .completeUnlessOpen:
+            return [.protectionKey: FileProtectionType.completeUnlessOpen]
+        case .completeUntilFirstUserAuthentication:
+            return [.protectionKey: FileProtectionType.completeUntilFirstUserAuthentication]
+        }
+#else
+        // Data protection is an iOS concept; no-op on macOS/Linux
+        return [:]
+#endif
+    }
+}
diff --git a/Tests/DiskCacheTests/AtomicWriterTests.swift b/Tests/DiskCacheTests/AtomicWriterTests.swift
