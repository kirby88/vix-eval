@@ -0,0 +1,62 @@
+import Testing
+import Foundation
+@testable import DiskCache
+
+@Suite("AtomicWriter")
+struct AtomicWriterTests {
+    @Test func writeProducesFileAtDestination() throws {
+        let dir = FileManager.default.temporaryDirectory
+            .appendingPathComponent(UUID().uuidString)
+        try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+        defer { try? FileManager.default.removeItem(at: dir) }
+
+        let destination = dir.appendingPathComponent("output")
+        let data = Data("atomic content".utf8)
+        try AtomicWriter.write(data, to: destination, protection: .none)
+
+        let result = try Data(contentsOf: destination)
+        #expect(result == data)
+    }
+
+    @Test func writeOverwritesExistingFile() throws {
+        let dir = FileManager.default.temporaryDirectory
+            .appendingPathComponent(UUID().uuidString)
+        try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+        defer { try? FileManager.default.removeItem(at: dir) }
+
+        let destination = dir.appendingPathComponent("output")
+        try AtomicWriter.write(Data("v1".utf8), to: destination, protection: .none)
+        try AtomicWriter.write(Data("v2".utf8), to: destination, protection: .none)
+
+        let result = try Data(contentsOf: destination)
+        #expect(result == Data("v2".utf8))
+    }
+
+    @Test func noTmpFileLeftOnSuccess() throws {
+        let dir = FileManager.default.temporaryDirectory
+            .appendingPathComponent(UUID().uuidString)
+        try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+        defer { try? FileManager.default.removeItem(at: dir) }
+
+        let destination = dir.appendingPathComponent("output")
+        try AtomicWriter.write(Data("x".utf8), to: destination, protection: .none)
+
+        let contents = try FileManager.default.contentsOfDirectory(atPath: dir.path)
+        let tmpFiles = contents.filter { $0.hasSuffix(".tmp") }
+        #expect(tmpFiles.isEmpty, "No .tmp files should remain after successful write")
+    }
+
+    @Test func writeLargeDataSucceeds() throws {
+        let dir = FileManager.default.temporaryDirectory
+            .appendingPathComponent(UUID().uuidString)
+        try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+        defer { try? FileManager.default.removeItem(at: dir) }
+
+        let destination = dir.appendingPathComponent("large")
+        let largeData = Data(repeating: 0xFF, count: 1024 * 1024) // 1 MB
+        try AtomicWriter.write(largeData, to: destination, protection: .none)
+
+        let result = try Data(contentsOf: destination)
+        #expect(result.count == largeData.count)
+    }
+}
diff --git a/Tests/DiskCacheTests/ConcurrencyTests.swift b/Tests/DiskCacheTests/ConcurrencyTests.swift
new file mode 100644
index 0000000..63945d3
--- /dev/null
+++ b/Tests/DiskCacheTests/ConcurrencyTests.swift
@@ -0,0 +1,77 @@
+import Testing
+import Foundation
+@testable import DiskCache
+
+@Suite("Concurrency Safety")
+struct ConcurrencyTests {
+    @Test func concurrentAddsDoNotCorruptIndex() async throws {
+        let (cache, baseDir) = try await TestCacheFactory.make(
+            maxEntryCount: 0,
+            maxTotalBytes: 0
+        )
+        defer { TestCacheFactory.cleanup(at: baseDir) }
+
+        let count = 50
+        try await withThrowingTaskGroup(of: Void.self) { group in
+            for i in 0..<count {
+                group.addTask {
+                    try await cache.add(key: "key-\(i)", data: Data("value-\(i)".utf8))
+                }
+            }
+            try await group.waitForAll()
+        }
+
+        // Verify all entries are accessible
+        var foundCount = 0
+        for i in 0..<count {
+            if try await cache.get(key: "key-\(i)") != nil {
+                foundCount += 1
+            }
+        }
+        #expect(foundCount == count, "All \(count) concurrently inserted entries should be retrievable")
+    }
+
+    @Test func concurrentGetAndAddDoNotProduceTornReads() async throws {
+        let (cache, baseDir) = try await TestCacheFactory.make()
+        defer { TestCacheFactory.cleanup(at: baseDir) }
+
+        let payload = Data(repeating: 0xAB, count: 1024)
+        try await cache.add(key: "shared", data: payload)
+
+        try await withThrowingTaskGroup(of: Void.self) { group in
+            // Writers
+            for _ in 0..<10 {
+                group.addTask {
+                    try await cache.add(key: "shared", data: payload)
+                }
+            }
+            // Readers
+            for _ in 0..<10 {
+                group.addTask {
+                    let result = try await cache.get(key: "shared")
+                    if let data = result {
+                        // Data must be either nil or the correct full payload
+                        #expect(data == payload, "Torn read detected: partial data returned")
+                    }
+                }
+            }
+            try await group.waitForAll()
+        }
+    }
+
+    @Test func concurrentPromoteAndAddDoNotDeadlock() async throws {
+        let (cache, baseDir) = try await TestCacheFactory.make()
+        defer { TestCacheFactory.cleanup(at: baseDir) }
+
+        try await cache.add(key: "k", data: Data("v".utf8))
+
+        try await withThrowingTaskGroup(of: Void.self) { group in
+            for _ in 0..<20 {
+                group.addTask { try await cache.promote(key: "k") }
+                group.addTask { try await cache.add(key: "k", data: Data("v2".utf8)) }
+            }
+            try await group.waitForAll()
+        }
+        // If we reach here without deadlock or crash, the test passes
+    }
+}
