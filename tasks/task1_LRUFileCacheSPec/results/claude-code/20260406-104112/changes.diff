diff --git a/Sources/DiskCache/AtomicWriter.swift b/Sources/DiskCache/AtomicWriter.swift
new file mode 100644
index 0000000..2cd6d66
--- /dev/null
+++ b/Sources/DiskCache/AtomicWriter.swift
@@ -0,0 +1,52 @@
+import Foundation
+#if canImport(Glibc)
+import Glibc
+#elseif canImport(Darwin)
+import Darwin
+#endif
+
+struct AtomicWriter {
+    /// Writes `data` atomically to `destination` using a sibling tmp file + POSIX rename.
+    /// The tmp file is placed in the same directory as `destination` to guarantee
+    /// same-volume semantics for the rename. POSIX rename(2) is atomic and replaces
+    /// any existing file at the destination.
+    static func write(
+        _ data: Data,
+        to destination: URL,
+        protection: DataProtectionClass,
+        fileManager: FileManager = .default
+    ) throws {
+        let dir = destination.deletingLastPathComponent()
+        let tmpURL = dir.appendingPathComponent(UUID().uuidString + ".tmp")
+
+        do {
+            // Write data to tmp file
+            try data.write(to: tmpURL, options: [])
+
+            // Apply data protection attributes before the rename so the file is never
+            // visible at the destination without the correct protection class
+            let attributes = FileProtectionMapper.fileAttributes(for: protection)
+            if !attributes.isEmpty {
+                try fileManager.setAttributes(attributes, ofItemAtPath: tmpURL.path)
+            }
+
+            // POSIX rename(2): atomic even when destination already exists.
+            // Works on both Apple platforms (APFS) and Linux (ext4/tmpfs).
+            let renameResult = tmpURL.withUnsafeFileSystemRepresentation { tmpPath in
+                destination.withUnsafeFileSystemRepresentation { destPath in
+                    rename(tmpPath!, destPath!)
+                }
+            }
+            if renameResult != 0 {
+                let err = POSIXError(POSIXErrorCode(rawValue: errno) ?? .EIO)
+                throw CacheError.atomicWriteFailed(underlying: err)
+            }
+        } catch let cacheError as CacheError {
+            try? fileManager.removeItem(at: tmpURL)
+            throw cacheError
+        } catch {
+            try? fileManager.removeItem(at: tmpURL)
+            throw CacheError.atomicWriteFailed(underlying: error)
+        }
+    }
+}
diff --git a/Sources/DiskCache/CacheActor.swift b/Sources/DiskCache/CacheActor.swift
new file mode 100644
index 0000000..53071f4
--- /dev/null
+++ b/Sources/DiskCache/CacheActor.swift
@@ -0,0 +1,203 @@
+import Crypto
+import Foundation
+
+actor CacheActor {
+    private var index: CacheIndex
+    let config: CacheConfiguration
+    let cacheDir: URL        // .../DiskCache/<name>/entries/
+    let indexURL: URL        // .../DiskCache/<name>/index.json
+    private let evictionDebouncer: Debouncer
+    private let indexSaveDebouncer: Debouncer
+    private let fileManager: FileManager
+
+    init(config: CacheConfiguration, baseDirectory: URL, fileManager: FileManager = .default) {
+        self.config = config
+        self.fileManager = fileManager
+
+        let cacheRoot = baseDirectory
+            .appendingPathComponent("DiskCache", isDirectory: true)
+            .appendingPathComponent(config.name, isDirectory: true)
+
+        self.cacheDir = cacheRoot.appendingPathComponent("entries", isDirectory: true)
+        self.indexURL = cacheRoot.appendingPathComponent("index.json")
+        self.evictionDebouncer = Debouncer(interval: config.evictionDebounceInterval)
+        self.indexSaveDebouncer = Debouncer(interval: config.indexSaveDebounceInterval)
+
+        self.index = Self.loadIndex(from: cacheRoot.appendingPathComponent("index.json"),
+                                   fileManager: fileManager)
+    }
+
+    // MARK: - Public API
+
+    func add(key: String, data: Data) async throws {
+        try await writeEntry(key: key, data: data, requiresExisting: false)
+    }
+
+    func modify(key: String, data: Data) async throws {
+        guard index.entries[key] != nil else {
+            throw CacheError.keyNotFound(key)
+        }
+        try await writeEntry(key: key, data: data, requiresExisting: true)
+    }
+
+    func get(key: String) async throws -> Data? {
+        guard let entry = index.entries[key] else { return nil }
+
+        let fileURL = cacheDir.appendingPathComponent(entry.filename)
+        let data: Data
+        do {
+            data = try Data(contentsOf: fileURL)
+        } catch let error as NSError where error.domain == NSCocoaErrorDomain &&
+            (error.code == NSFileReadNoSuchFileError || error.code == NSFileNoSuchFileError) {
+            // Self-heal: remove phantom entry from index
+            index.remove(key: key)
+            try await persistIndex(immediate: true)
+            return nil
+        } catch {
+            throw CacheError.fileSystemError(underlying: error)
+        }
+
+        index.touch(key: key, date: Date())
+        await indexSaveDebouncer.schedule { [weak self] in
+            guard let self else { return }
+            try? await self.persistIndex(immediate: false)
+        }
+        return data
+    }
+
+    func promote(key: String) async throws {
+        guard index.entries[key] != nil else {
+            throw CacheError.keyNotFound(key)
+        }
+        index.touch(key: key, date: Date())
+        await indexSaveDebouncer.schedule { [weak self] in
+            guard let self else { return }
+            try? await self.persistIndex(immediate: false)
+        }
+    }
+
+    // MARK: - Private helpers
+
+    private func writeEntry(key: String, data: Data, requiresExisting: Bool) async throws {
+        try await ensureDirectoryExists()
+
+        let (filename, fullHash) = Self.deriveFilename(for: key)
+        let fileURL = cacheDir.appendingPathComponent(filename)
+        let now = Date()
+
+        try AtomicWriter.write(data, to: fileURL, protection: config.dataProtectionClass,
+                               fileManager: fileManager)
+
+        let existingEntry = index.entries[key]
+        let entry = CacheEntry(
+            key: key,
+            filename: filename,
+            fullHash: fullHash,
+            byteSize: data.count,
+            lastAccessedDate: now,
+            insertedDate: existingEntry?.insertedDate ?? now
+        )
+        index.insert(entry)
+
+        await indexSaveDebouncer.cancel()
+        try await persistIndex(immediate: true)
+
+        await evictionDebouncer.schedule { [weak self] in
+            guard let self else { return }
+            await self.runEviction()
+        }
+    }
+
+    private func runEviction() async {
+        guard index.needsEviction(config: config) else { return }
+
+        let sorted = index.entriesSortedByLRU()
+        var toEvict: [CacheEntry] = []
+
+        var simulatedCount = index.entries.count
+        var simulatedBytes = index.totalBytes
+
+        for entry in sorted {
+            let countOk = config.maxEntryCount == 0 || simulatedCount <= config.maxEntryCount
+            let bytesOk = config.maxTotalBytes == 0 || simulatedBytes <= config.maxTotalBytes
+            if countOk && bytesOk { break }
+            toEvict.append(entry)
+            simulatedCount -= 1
+            simulatedBytes -= entry.byteSize
+        }
+
+        for entry in toEvict {
+            moveToTmp(entry: entry)
+            index.remove(key: entry.key)
+        }
+
+        if !toEvict.isEmpty {
+            try? await persistIndex(immediate: true)
+        }
+    }
+
+    private func moveToTmp(entry: CacheEntry) {
+        let source = cacheDir.appendingPathComponent(entry.filename)
+        let destination = FileManager.default.temporaryDirectory
+            .appendingPathComponent("\(entry.filename)-\(UUID().uuidString)")
+        do {
+            try fileManager.moveItem(at: source, to: destination)
+        } catch let error as NSError
+            where error.domain == NSCocoaErrorDomain &&
+                  (error.code == NSFileNoSuchFileError || error.code == NSFileReadNoSuchFileError) {
+            // File was already deleted externally; ignore
+        } catch {
+            // Move to tmp failed; attempt deletion as fallback
+            try? fileManager.removeItem(at: source)
+        }
+    }
+
+    func persistIndex(immediate: Bool) async throws {
+        let snapshot = CacheIndexSnapshot(from: index)
+        let encoder = JSONEncoder()
+        encoder.dateEncodingStrategy = .secondsSince1970
+        let data = try encoder.encode(snapshot)
+
+        let indexDir = indexURL.deletingLastPathComponent()
+        if !fileManager.fileExists(atPath: indexDir.path) {
+            try fileManager.createDirectory(at: indexDir, withIntermediateDirectories: true)
+        }
+
+        try AtomicWriter.write(data, to: indexURL, protection: config.dataProtectionClass,
+                               fileManager: fileManager)
+    }
+
+    private func ensureDirectoryExists() async throws {
+        guard !fileManager.fileExists(atPath: cacheDir.path) else { return }
+        let attributes = FileProtectionMapper.fileAttributes(for: config.dataProtectionClass)
+        do {
+            try fileManager.createDirectory(at: cacheDir, withIntermediateDirectories: true,
+                                            attributes: attributes.isEmpty ? nil : attributes)
+        } catch {
+            throw CacheError.directoryCreationFailed(underlying: error)
+        }
+    }
+
+    // MARK: - Static helpers
+
+    private static func loadIndex(from url: URL, fileManager: FileManager) -> CacheIndex {
+        guard fileManager.fileExists(atPath: url.path),
+              let data = try? Data(contentsOf: url) else {
+            return CacheIndex()
+        }
+        let decoder = JSONDecoder()
+        decoder.dateDecodingStrategy = .secondsSince1970
+        guard let snapshot = try? decoder.decode(CacheIndexSnapshot.self, from: data),
+              let index = snapshot.toIndex() else {
+            return CacheIndex()
+        }
+        return index
+    }
+
+    static func deriveFilename(for key: String) -> (filename: String, fullHash: String) {
+        let digest = SHA256.hash(data: Data(key.utf8))
+        let fullHash = digest.map { String(format: "%02x", $0) }.joined()
+        let filename = String(fullHash.prefix(16))
+        return (filename, fullHash)
+    }
+}
