diff --git a/Sources/DiskCache/CacheIndex.swift b/Sources/DiskCache/CacheIndex.swift
new file mode 100644
index 0000000..bb329a1
--- /dev/null
+++ b/Sources/DiskCache/CacheIndex.swift
@@ -0,0 +1,56 @@
+import Foundation
+
+struct CacheIndex: Sendable {
+    private(set) var entries: [String: CacheEntry] = [:]
+    private(set) var totalBytes: Int = 0
+
+    mutating func insert(_ entry: CacheEntry) {
+        if let existing = entries[entry.key] {
+            totalBytes -= existing.byteSize
+        }
+        entries[entry.key] = entry
+        totalBytes += entry.byteSize
+    }
+
+    @discardableResult
+    mutating func remove(key: String) -> CacheEntry? {
+        guard let entry = entries.removeValue(forKey: key) else { return nil }
+        totalBytes -= entry.byteSize
+        return entry
+    }
+
+    mutating func touch(key: String, date: Date) {
+        entries[key]?.lastAccessedDate = date
+    }
+
+    func entriesSortedByLRU() -> [CacheEntry] {
+        entries.values.sorted { $0.lastAccessedDate < $1.lastAccessedDate }
+    }
+
+    func needsEviction(config: CacheConfiguration) -> Bool {
+        if config.maxEntryCount > 0, entries.count > config.maxEntryCount { return true }
+        if config.maxTotalBytes > 0, totalBytes > config.maxTotalBytes { return true }
+        return false
+    }
+}
+
+// MARK: - Codable snapshot
+
+struct CacheIndexSnapshot: Codable {
+    let version: Int
+    let entries: [CacheEntry]
+
+    init(from index: CacheIndex) {
+        self.version = 1
+        self.entries = Array(index.entries.values)
+    }
+
+    func toIndex() -> CacheIndex? {
+        guard version == 1 else { return nil }
+        var index = CacheIndex()
+        for entry in entries {
+            index.insert(entry)
+        }
+        return index
+    }
+}
