+import Foundation
+
+public enum DataProtectionClass: Sendable {
+    case none
+    case complete
+    case completeUnlessOpen
+    case completeUntilFirstUserAuthentication
+}
+
+public struct CacheConfiguration: Sendable {
+    public let name: String
+    public let maxEntryCount: Int
+    public let maxTotalBytes: Int
+    public let evictionDebounceInterval: TimeInterval
+    public let indexSaveDebounceInterval: TimeInterval
+    public let dataProtectionClass: DataProtectionClass
+
+    public init(
+        name: String,
+        maxEntryCount: Int = 1000,
+        maxTotalBytes: Int = 500 * 1024 * 1024,
+        evictionDebounceInterval: TimeInterval = 2.0,
+        indexSaveDebounceInterval: TimeInterval = 5.0,
+        dataProtectionClass: DataProtectionClass = .completeUnlessOpen
+    ) {
+        self.name = name
+        self.maxEntryCount = maxEntryCount
+        self.maxTotalBytes = maxTotalBytes
+        self.evictionDebounceInterval = evictionDebounceInterval
+        self.indexSaveDebounceInterval = indexSaveDebounceInterval
+        self.dataProtectionClass = dataProtectionClass
+    }
+}
