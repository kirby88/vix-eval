+import Testing
+import Foundation
+@testable import DiskCache
+
+@Suite("Index Persistence")
+struct PersistenceTests {
+    @Test func indexSurvivesRestart() async throws {
+        let cacheName = UUID().uuidString
+        let (cache, baseDir) = try await TestCacheFactory.make(name: cacheName)
+        defer { TestCacheFactory.cleanup(at: baseDir) }
+
+        try await cache.add(key: "a", data: Data("aaa".utf8))
+        try await cache.add(key: "b", data: Data("bbb".utf8))
+        try await cache.add(key: "c", data: Data("ccc".utf8))
+
+        // Reopen simulates a process restart
+        let cache2 = try await TestCacheFactory.reopen(name: cacheName, baseDirectory: baseDir)
+
+        #expect(try await cache2.get(key: "a") == Data("aaa".utf8))
+        #expect(try await cache2.get(key: "b") == Data("bbb".utf8))
+        #expect(try await cache2.get(key: "c") == Data("ccc".utf8))
+    }
+
+    @Test func corruptedIndexDegradesToEmptyCache() async throws {
+        let cacheName = UUID().uuidString
+        let (cache, baseDir) = try await TestCacheFactory.make(name: cacheName)
+        defer { TestCacheFactory.cleanup(at: baseDir) }
+
+        try await cache.add(key: "a", data: Data("aaa".utf8))
+
+        // Overwrite the index with garbage
+        let indexURL = baseDir
+            .appendingPathComponent("DiskCache")
+            .appendingPathComponent(cacheName)
+            .appendingPathComponent("index.json")
+        try Data("not valid json!!!".utf8).write(to: indexURL)
+
+        // Reinit should not crash; should start with empty index
+        let cache2 = try await TestCacheFactory.reopen(name: cacheName, baseDirectory: baseDir)
+        let result = try await cache2.get(key: "a")
+        #expect(result == nil, "Corrupted index should degrade to empty cache")
+    }
+
+    @Test func missingIndexDegradesToEmptyCache() async throws {
+        let cacheName = UUID().uuidString
+        let baseDir = FileManager.default.temporaryDirectory
+            .appendingPathComponent("DiskCacheTests-\(UUID().uuidString)")
+        defer { TestCacheFactory.cleanup(at: baseDir) }
+
+        // Create cache from a directory with no existing index
+        let cache = try await TestCacheFactory.reopen(name: cacheName, baseDirectory: baseDir)
+        let result = try await cache.get(key: "anything")
+        #expect(result == nil)
+    }
+
+    @Test func lruOrderRestoredFromPersistedIndex() async throws {
+        let cacheName = UUID().uuidString
+        let (cache, baseDir) = try await TestCacheFactory.make(
+            name: cacheName,
+            maxEntryCount: 2,
+            maxTotalBytes: 0
+        )
+        defer { TestCacheFactory.cleanup(at: baseDir) }
+
+        try await cache.add(key: "lru", data: Data("v".utf8))
+        try await Task.sleep(nanoseconds: 1_000_000)
+        try await cache.add(key: "mru", data: Data("v".utf8))
+
+        // Reopen with maxEntryCount=2 still
+        let cache2 = try await TestCacheFactory.reopen(
+            name: cacheName,
+            baseDirectory: baseDir,
+            maxEntryCount: 2
+        )
+
+        // Adding a third entry should evict "lru" (its lastAccessedDate was smaller)
+        try await Task.sleep(nanoseconds: 1_000_000)
+        try await cache2.add(key: "new", data: Data("v".utf8))
+        try await Task.sleep(nanoseconds: 50_000_000)
+
+        #expect(try await cache2.get(key: "lru") == nil, "LRU should be evicted after restart")
+        #expect(try await cache2.get(key: "mru") != nil, "MRU should still be present after restart")
+    }
+}
