@@ -0,0 +1,97 @@
+import Testing
+import Foundation
+@testable import DiskCache
+
+@Suite("LRU Eviction")
+struct EvictionTests {
+    @Test func evictsLRUEntryWhenCountExceeded() async throws {
+        // maxEntryCount=2; inserting 3 should evict the LRU (first-inserted, never accessed)
+        let (cache, baseDir) = try await TestCacheFactory.make(maxEntryCount: 2, maxTotalBytes: 0)
+        defer { TestCacheFactory.cleanup(at: baseDir) }
+
+        try await cache.add(key: "lru", data: Data("lru".utf8))
+        try await Task.sleep(nanoseconds: 1_000_000)
+        try await cache.add(key: "mid", data: Data("mid".utf8))
+        try await Task.sleep(nanoseconds: 1_000_000)
+        try await cache.add(key: "mru", data: Data("mru".utf8))
+
+        // Give eviction task a moment to complete (debounce=0 means it fires immediately but still async)
+        try await Task.sleep(nanoseconds: 50_000_000)
+
+        let lruResult = try await cache.get(key: "lru")
+        #expect(lruResult == nil, "LRU entry should have been evicted")
+
+        let mruResult = try await cache.get(key: "mru")
+        #expect(mruResult != nil, "MRU entry should still be present")
+    }
+
+    @Test func evictsLRUEntryWhenBytesExceeded() async throws {
+        // maxTotalBytes=10; each entry is 5 bytes; inserting 3 should evict the first
+        let (cache, baseDir) = try await TestCacheFactory.make(maxEntryCount: 0, maxTotalBytes: 10)
+        defer { TestCacheFactory.cleanup(at: baseDir) }
+
+        try await cache.add(key: "lru", data: Data("hello".utf8)) // 5 bytes
+        try await Task.sleep(nanoseconds: 1_000_000)
+        try await cache.add(key: "mid", data: Data("world".utf8)) // 5 bytes — now at limit
+        try await Task.sleep(nanoseconds: 1_000_000)
+        try await cache.add(key: "mru", data: Data("extra".utf8)) // 5 bytes — exceeds limit
+
+        try await Task.sleep(nanoseconds: 50_000_000)
+
+        let lruResult = try await cache.get(key: "lru")
+        #expect(lruResult == nil, "LRU entry should have been evicted to satisfy byte limit")
+    }
+
+    @Test func evictedFilesMovedToTmp() async throws {
+        let (cache, baseDir) = try await TestCacheFactory.make(maxEntryCount: 1, maxTotalBytes: 0)
+        defer { TestCacheFactory.cleanup(at: baseDir) }
+
+        let tmpDir = FileManager.default.temporaryDirectory
+        let before = (try? FileManager.default.contentsOfDirectory(atPath: tmpDir.path)) ?? []
+
+        try await cache.add(key: "lru", data: Data("lru".utf8))
+        try await Task.sleep(nanoseconds: 1_000_000)
+        try await cache.add(key: "mru", data: Data("mru".utf8))
+
+        try await Task.sleep(nanoseconds: 50_000_000)
+
+        let after = (try? FileManager.default.contentsOfDirectory(atPath: tmpDir.path)) ?? []
+        let (filename, _) = CacheActor.deriveFilename(for: "lru")
+        let movedFiles = after.filter { $0.hasPrefix(filename) && !before.contains($0) }
+        #expect(!movedFiles.isEmpty, "Evicted file should appear in tmp/ directory")
+    }
+
+    @Test func doesNotEvictMostRecentlyUsedEntry() async throws {
+        let (cache, baseDir) = try await TestCacheFactory.make(maxEntryCount: 2, maxTotalBytes: 0)
+        defer { TestCacheFactory.cleanup(at: baseDir) }
+
+        try await cache.add(key: "older", data: Data("v".utf8))
+        try await Task.sleep(nanoseconds: 1_000_000)
+        try await cache.add(key: "newer", data: Data("v".utf8))
+
+        // Promote "older" so it becomes the MRU
+        try await cache.promote(key: "older")
+        try await Task.sleep(nanoseconds: 1_000_000)
+
+        // Now insert a third entry — "newer" should be evicted (it's now LRU)
+        try await cache.add(key: "third", data: Data("v".utf8))
+
+        try await Task.sleep(nanoseconds: 50_000_000)
+
+        #expect(try await cache.get(key: "older") != nil, "Promoted entry should not be evicted")
+        #expect(try await cache.get(key: "newer") == nil, "Non-promoted entry should be evicted")
+    }
+
+    @Test func afterEvictionGetOnEvictedKeyReturnsNil() async throws {
+        let (cache, baseDir) = try await TestCacheFactory.make(maxEntryCount: 1, maxTotalBytes: 0)
+        defer { TestCacheFactory.cleanup(at: baseDir) }
+
+        try await cache.add(key: "lru", data: Data("v".utf8))
+        try await Task.sleep(nanoseconds: 1_000_000)
+        try await cache.add(key: "mru", data: Data("v".utf8))
+        try await Task.sleep(nanoseconds: 50_000_000)
+
+        let result = try await cache.get(key: "lru")
+        #expect(result == nil)
+    }
+}
diff --git a/Tests/DiskCacheTests/Helpers/TestCacheFactory.swift b/Tests/DiskCacheTests/Helpers/TestCacheFactory.swift
new file mode 100644
