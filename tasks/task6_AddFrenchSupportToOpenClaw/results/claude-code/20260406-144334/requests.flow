\t    chat: \"Sesi√≥n de chat directa con la puerta de enlace para intervenciones r√°pidas.\",\n52\t    config: \"Editar ~/.openclaw/openclaw.json de forma segura.\",\n53\t    debug: \"Instant√°neas de la puerta de enlace, eventos y llamadas RPC manuales.\",\n54\t    logs: \"Seguimiento en vivo de los registros de la puerta de enlace.\",\n55\t  },\n56\t  overview: {\n57\t    access: {\n58\t      title: \"Acceso a la puerta de enlace\",\n59\t      subtitle: \"D√≥nde se conecta el panel y c√≥mo se autentica.\",\n60\t      wsUrl: \"URL de WebSocket\",\n61\t      token: \"Token de la puerta de enlace\",\n62\t      password: \"Contrase√±a (no se guarda)\", // pragma: allowlist secret\n63\t      sessionKey: \"Clave de sesi√≥n predeterminada\",\n64\t      language: \"Idioma\",\n65\t      connectHint: \"Haz clic en Conectar para aplicar los cambios de conexi√≥n.\",\n66\t      trustedProxy: \"Autenticado mediante proxy de confianza.\",\n67\t    },\n68\t    snapshot: {\n69\t      title: \"Instant√°nea\",\n70\t      subtitle: \"Informaci√≥n m√°s reciente del saludo con la puerta de enlace.\",\n71\t      status: \"Estado\",\n72\t      uptime: \"Tiempo de actividad\",\n73\t      tickInterval: \"Intervalo de tick\",\n74\t      lastChannelsRefresh: \"√öltima actualizaci√≥n de canales\",\n75\t      channelsHint: \"Usa Canales para vincular WhatsApp, Telegram, Discord, Signal o iMessage.\",\n76\t    },\n77\t    stats: {\n78\t      instances: \"Instancias\",\n79\t      instancesHint: \"Balizas de presencia en los √∫ltimos 5 minutos.\",\n80\t      sessions: \"Sesiones\",\n81\t      sessionsHint: \"Claves de sesi√≥n recientes rastreadas por la puerta de enlace.\",\n82\t      cron: \"Cron\",\n83\t      cronNext: \"Pr√≥ximo despertar {time}\",\n84\t    },\n85\t    notes: {\n86\t      title: \"Notas\",\n87\t      subtitle: \"Recordatorios r√°pidos para configuraciones de control remoto.\",\n88\t      tailscaleTitle: \"Tailscale serve\",\n89\t      tailscaleText:\n90\t        \"Prefiere el