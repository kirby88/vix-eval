,7:headers;1618:40:4:Date,29:Mon, 06 Apr 2026 13:46:36 GMT,]52:12:Content-Type,32:text/event-stream; charset=utf-8,]31:17:Transfer-Encoding,7:chunked,]28:10:Connection,10:keep-alive,]28:13:Cache-Control,8:no-cache,]52:38:anthropic-ratelimit-input-tokens-limit,7:4000000,]56:42:anthropic-ratelimit-input-tokens-remaining,7:4000000,]66:38:anthropic-ratelimit-input-tokens-reset,20:2026-04-06T13:46:35Z,]52:39:anthropic-ratelimit-output-tokens-limit,6:800000,]56:43:anthropic-ratelimit-output-tokens-remaining,6:800000,]67:39:anthropic-ratelimit-output-tokens-reset,20:2026-04-06T13:46:35Z,]45:34:anthropic-ratelimit-requests-limit,4:4000,]49:38:anthropic-ratelimit-requests-remaining,4:3999,]62:34:anthropic-ratelimit-requests-reset,20:2026-04-06T13:46:35Z,]46:32:anthropic-ratelimit-tokens-limit,7:4800000,]50:36:anthropic-ratelimit-tokens-remaining,7:4800000,]60:32:anthropic-ratelimit-tokens-reset,20:2026-04-06T13:46:35Z,]46:10:request-id,28:req_011CZncw1PsD8cTAUdbsPB2i,]77:25:strict-transport-security,44:max-age=31536000; includeSubDomains; preload,]69:25:anthropic-organization-id,36:19d39eaa-efb4-49e0-afe8-a7359703719a,]23:6:Server,10:cloudflare,]39:29:x-envoy-upstream-service-time,3:824,]45:13:server-timing,24:x-originResponse;dur=826,]29:15:cf-cache-status,7:DYNAMIC,]208:10:set-cookie,189:_cfuvid=Vg.Eg2z0CPcaIBjqT3TJ.Vp1CNHBa5IIZMxrMby5cG0-1775483195.0923235-1.0.1.1-bzEyTd2XrYIVcymcEiOFMKzE4BsnCsXXua2OaxXnY3Y; HttpOnly; SameSite=None; Secure; Path=/; Domain=api.anthropic.com,]73:23:Content-Security-Policy,42:default-src 'none'; frame-ancestors 'none',]23:12:X-Robots-Tag,4:none,]33:6:CF-RAY,20:9e813d515cbb61f5-DUB,]]12:http_version;8:HTTP/1.1,}7:request;3109:4:path;22:/v1/messages?beta=true,9:authority;0:,6:scheme;5:https,6:method;4:POST,4:port;3:443#4:host;17:api.anthropic.com;13:timestamp_end;18:1775483194.8462071^15:timestamp_start;18:1775483194.8456013^8:trailers;0:~7:content;1854:{"model":"claude-haiku-4-5-20251001","messages":[{"role":"user","content":[{"type":"text","text":"Add French language support, as requested in issue #3460. Explore the codebase to find how existing languages and localization are handled, then add complete French (fr) translations following the same patterns. Make sure any existing tests still pass after your changes. Create a PR-ready branch with your work.\ncf. https://github.com/openclaw/openclaw/issues/3460"}]}],"system":[{"type":"text","text":"x-anthropic-billing-header: cc_version=2.1.92.bd1; cc_entrypoint=cli; cch=96264;"},{"type":"text","text":"You are Claude Code, Anthropic's official CLI for Claude."},{"type":"text","text":"Generate a concise, sentence-case title (3-7 words) that captures the main topic or goal of this coding session. The title should be clear enough that the user recognizes the session in a list. Use sentence case: capitalize only the first word and proper nouns.\n\nReturn JSON with a single \"title\" field.\n\nGood examples:\n{\"title\": \"Fix login button on mobile\"}\n{\"title\": \"Add OAuth authentication\"}\n{\"title\": \"Debug failing CI tests\"}\n{\"title\": \"Refactor API client error handling\"}\n\nBad (too vague): {\"title\": \"Code changes\"}\nBad (too long): {\"title\": \"Investigate and fix the issue where the login button does not respond on mobile devices\"}\nBad (wrong case): {\"title\": \"Fix Login Button On Mobile\"}"}],"tools":[],"metadata":{"user_id":"{\"device_id\":\"20ee6186e278bc5d5a300a3de33bfb8cbb756cee46e6012016d43acea591404c\",\"account_uuid\":\"\",\"session_id\":\"5d91c901-f1cd-41a3-a6eb-f44b103432c0\"}"},"max_tokens":32000,"temperature":1,"output_config":{"format":{"type":"json_schema","schema":{"type":"object","properties":{"title":{"type":"string"}},"required":["title"],"additionalProperties":false}}},"stream":true},7:headers;981:29:6:Accept,16:application/json,]31:13:Authorization,10:[REDACTED],]36:12:Content-Type,16:application/json,]51:10:User-Agent,33:claude-cli/2.1.92 (external, cli),]68:24:X-Claude-Code-Session-Id,36:5d91c901-f1cd-41a3-a6eb-f44b103432c0,]28:16:X-Stainless-Arch,5:arm64,]25:16:X-Stainless-Lang,2:js,]26:14:X-Stainless-OS,5:Linux,]40:27:X-Stainless-Package-Version,6:0.80.0,]31:23:X-Stainless-Retry-Count,1:0,]30:19:X-Stainless-Runtime,4:node,]41:27:X-Stainless-Runtime-Version,7:v24.3.0,]29:19:X-Stainless-Timeout,3:600,]173:14:anthropic-beta,150:interleaved-thinking-2025-05-14,redact-thinking-2026-02-12,context-management-2025-06-27,prompt-caching-scope-2026-01-05,structured-outputs-2025-12-15,]52:41:anthropic-dangerous-direct-browser-access,4:true,]35:17:anthropic-version,10:2023-06-01,]26:9:x-api-key,10:[REDACTED],]14:5:x-app,3:cli,]28:10:Connection,10:keep-alive,]28:4:Host,17:api.anthropic.com,]46:15:Accept-Encoding,23:gzip, deflate, br, zstd,]25:14:Content-Length,4:1854,]]12:http_version;8:HTTP/1.1,}6:backup;0:~17:timestamp_created;18:1775483194.8457172^7:comment;0:;8:metadata;0:}6:marked;0:;9:is_replay;0:~11:intercepted;5:false!11:server_conn;4099:3:via;0:~19:timestamp_tcp_setup;18:1775483194.9050496^7:address;27:17:api.anthropic.com;3:443#]19:timestamp_tls_setup;16:1775483194.96472^13:timestamp_end;0:~15:timestamp_start;18:1775483194.8467126^3:sni;17:api.anthropic.com;11:tls_version;7:TLSv1.3;11:cipher_list;0:]6:cipher;22:TLS_AES_256_GCM_SHA384;11:alpn_offers;0:]4:alpn;0:,16:certificate_list;3569:1318:-----BEGIN CERTIFICATE-----
