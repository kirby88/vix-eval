      everyAmountPlaceholder: \"30\",\n      timezoneOptional: \"Fuseau horaire (optionnel)\",\n      timezonePlaceholder: \"America/Los_Angeles\",\n      timezoneHelp:\n        \"Choisissez un fuseau horaire courant ou saisissez n'importe quel fuseau IANA valide.\",\n      jitterHelp:\n        \"Besoin de gigue ? Utilisez Avanc√© ‚Üí Fen√™tre d'√©chelonnement / Unit√© d'√©chelonnement.\",\n      execution: \"Ex√©cution\",\n      executionSub: \"Choisissez quand se r√©veiller et ce que cette t√¢che doit faire.\",\n      session: \"Session\",\n      main: \"Principale\",\n      isolated: \"Isol√©e\",\n      sessionHelp:\n        \"Principale publie un √©v√©nement syst√®me. Isol√©e ex√©cute un tour d√©di√© de l'agent.\",\n      wakeMode: \"Mode de r√©veil\",\n      now: \"Maintenant\",\n      nextHeartbeat: \"Prochain battement\",\n      wakeModeHelp:\n        \"Maintenant se d√©clenche imm√©diatement. Prochain battement attend le prochain cycle.\",\n      payloadKind: \"Que doit s'ex√©cuter ?\",\n      systemEvent: \"Publier un message sur la ligne temporelle principale\",\n      agentTurn: \"Ex√©cuter une t√¢che de l'assistant (isol√©e)\",\n      systemEventHelp:\n        \"Envoie votre texte √† la ligne temporelle principale de la passerelle (id√©al pour les rappels/d√©clencheurs).\",\n      agentTurnHelp:\n        \"Lance une ex√©cution de l'assistant dans sa propre session en utilisant votre invite.\",\n      timeoutSeconds: \"D√©lai d'attente (secondes)\",\n      timeoutPlaceholder: \"Optionnel, ex. 90\",\n      timeoutHelp:\n        \"Optionnel. Laissez vide pour utiliser le comportement de d√©lai d'attente par d√©faut de la passerelle pour cette ex√©cution.\",\n      mainTimelineMessage: \"Message de la ligne temporelle principale\",\n      assistantTaskPrompt: \"Invite de t√¢che de l'assistant\",\n      deliverySection: \"Livraison\",\n      deliverySub: \"Choisissez o√π les r√©sum√©s d'ex√©cution sont envoy√©s.\",\n      resultDelivery: \"Livraison des r√©su