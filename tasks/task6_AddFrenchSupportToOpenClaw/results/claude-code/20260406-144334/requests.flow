s"}},{"type":"tool_use","id":"toolu_018dps9zSshGLgqMyD8j2UaC","name":"Read","input":{"file_path":"/workspace/ui/src/i18n/lib/types.ts"}},{"type":"tool_use","id":"toolu_01KQbLfUxhHUKxUBrFmkw3hj","name":"Read","input":{"file_path":"/workspace/ui/src/i18n/lib/registry.ts"}},{"type":"tool_use","id":"toolu_01NpV99QsZfRqpcedSeE4Vfi","name":"Read","input":{"file_path":"/workspace/ui/src/i18n/lib/translate.ts"}},{"type":"tool_use","id":"toolu_014B5H1FqdnTNHfSm3FHQx7u","name":"Read","input":{"file_path":"/workspace/ui/src/i18n/locales/en.ts"}}]},{"role":"user","content":[{"tool_use_id":"toolu_01BUVH6QAhztJVG34D5ZX826","type":"tool_result","content":"1\texport * from \"./lib/types.ts\";\n2\texport * from \"./lib/translate.ts\";\n3\texport * from \"./lib/lit-controller.ts\";\n4\t"},{"tool_use_id":"toolu_01KQbLfUxhHUKxUBrFmkw3hj","type":"tool_result","content":"1\timport type { Locale, TranslationMap } from \"./types.ts\";\n2\t\n3\ttype LazyLocale = Exclude<Locale, \"en\">;\n4\ttype LocaleModule = Record<string, TranslationMap>;\n5\t\n6\ttype LazyLocaleRegistration = {\n7\t  exportName: string;\n8\t  loader: () => Promise<LocaleModule>;\n9\t};\n10\t\n11\texport const DEFAULT_LOCALE: Locale = \"en\";\n12\t\n13\tconst LAZY_LOCALES: readonly LazyLocale[] = [\"zh-CN\", \"zh-TW\", \"pt-BR\", \"de\", \"es\"];\n14\t\n15\tconst LAZY_LOCALE_REGISTRY: Record<LazyLocale, LazyLocaleRegistration> = {\n16\t  \"zh-CN\": {\n17\t    exportName: \"zh_CN\",\n18\t    loader: () => import(\"../locales/zh-CN.ts\"),\n19\t  },\n20\t  \"zh-TW\": {\n21\t    exportName: \"zh_TW\",\n22\t    loader: () => import(\"../locales/zh-TW.ts\"),\n23\t  },\n24\t  \"pt-BR\": {\n25\t    exportName: \"pt_BR\",\n26\t    loader: () => import(\"../locales/pt-BR.ts\"),\n27\t  },\n28\t  de: {\n29\t    exportName: \"de\",\n30\t    loader: () => import(\"../locales/de.ts\"),\n31\t  },\n32\t  es: {\n33\t    exportName: \"es\",\n34\t    loader: () => import(\"../locales/es.ts\"),\n35\t  },\n36\t};\n37\t\n38\texport const SUPPORTED_LOCALES: ReadonlyArray<Locale> = [DEFAULT_LOCALE, ...LAZY_LOCALES];\n39\t\n40\texport function isSupportedLocale(value: string | null | undefined): value is Locale {\n41\t  return value !== null && value !== undefined && SUPPORTED_LOCALES.includes(value as Locale);\n42\t}\n43\t\n44\tfunction isLazyLocale(locale: Locale): locale is LazyLocale {\n45\t  return LAZY_LOCALES.includes(locale as LazyLocale);\n46\t}\n47\t\n48\texport function resolveNavigatorLocale(navLang: string): Locale {\n49\t  if (navLang.startsWith(\"zh\")) {\n50\t    return navLang === \"zh-TW\" || navLang === \"zh-HK\" ? \"zh-TW\" : \"zh-CN\";\n51\t  }\n52\t  if (navLang.startsWith(\"pt\")) {\n53\t    return \"pt-BR\";\n54\t  }\n55\t  if (navLang.startsWith(\"de\")) {\n56\t    return \"de\";\n57\t  }\n58\t  if (navLang.startsWith(\"es\")) {\n59\t    return \"es\";\n60\t  }\n61\t  return DEFAULT_LOCALE;\n62\t}\n63\t\n64\texport async function loadLazyLocaleTranslation(locale: Locale): Promise<TranslationMap | null> {\n65\t  if (!isLazyLocale(locale)) {\n66\t    return null;\n67\t  }\n68\t  const registration = LAZY_LOCALE_REGISTRY[locale];\n69\t  const module = await registration.loader();\n70\t  return module[registration.exportName] ?? null;\n71\t}\n72\t"},{"tool_use_id":"toolu_014B5H1FqdnTNHfSm3FHQx7u","type":"tool_result","content":"1\timport type { TranslationMap } from \"../lib/types.ts\";\n2\t\n3\texport const en: TranslationMap = {\n4\t  common: {\n5\t    health: \"Health\",\n6\t    ok: \"OK\",\n7\t    online: \"Online\",\n8\t    offline: \"Offline\",\n9\t    connect: \"Connect\",\n10\t    refresh: \"Refresh\",\n11\t    enabled: \"Enabled\",\n12\t    disabled: \"Disabled\",\n13\t    na: \"n/a\",\n14\t    version: \"Version\",\n15\t    docs: \"Docs\",\n16\t    theme: \"Theme\",\n17\t    resources: \"Resources\",\n18\t    search: \"Search\",\n19\t  },\n20\t  nav: {\n21\t    chat: \"Chat\",\n22\t    control: \"Control\",\n23\t    agent: \"Agent\",\n24\t    settings: \"Settings\",\n25\t    expand: \"Expand sidebar\",\n26\t    collapse: \"Collapse sidebar\",\n27\t    resize: \"Resize sidebar\",\n28\t  },\n29\t  tabs: {\n30\t    agents: \"Agents\",\n31\t    overview: \"Overview\",\n32\t    channels: \"Channels\",\n33\t    instances: \"Instances\",\n34\t    sessions: \"Sessions\",\n35\t    usage: \"Usage\",\n36\t    cron: \"Cron Jobs\",\n37\t    skills: \"Skills\",\n38\t    nodes: \"Nodes\",\n39\t    chat: \"Chat\",\n40\t    config: \"Config\",\n41\t    communications: \"Communications\",\n42\t    appearance: \"Appearance\",\n43\t    automation: \"Automation\",\n44\t    infrastructure: \"Infrastructure\",\n45\t    aiAgents: \"AI & Agents\",\n46\t    debug: \"Debug\",\n47\t    logs: \"Logs\",\n48\t  },\n49\t  subtitles: {\n50\t    agents: \"Workspaces, tools, identities.\",\n51\t    overview: \"Status, entry points, health.\",\n52\t    channels: \"Channels and settings.\",\n53\t    instances: \"Connected clients and nodes.\",\n54\t    sessions: \"Active sessions and defaults.\",\n55\t    usage: \"API usage and costs.\",\n56\t    cron: \"Wakeups and recurring runs.\",\n57\t    skills: \"Skills and API keys.\",\n58\t    nodes: \"Paired devices and commands.\",\n59\t    chat: \"Gateway chat for quick interventions.\",\n60\t    config: \"Edit openclaw.json.\",\n61\t    communications: \"Channels, messages, and audio settings.\",\n62\t    appearance: \"Theme, UI, and setup wizard settings.\",\n63\t    automation: \"Commands, hooks, cron, and plugins.\",\n64\t    infrastructure: \"Gateway, web, browser, and media settings.\",\n65\t    aiAgents: \"Agents, models, skills, tools, memory, session.\",\n66\t    debug: \"Snapshots, events, RPC.\",\n67\t    logs: \"Live gateway logs.\",\n68\t  },\n69\t  overview: {\n70\t    access: {\n71\t      title: \"Gateway Access\",\n72\t      subtitle: \"Where the dashboard connects and how it authenticates.\",\n73\t      wsUrl: \"WebSocket URL\",\n74\t      token: \"Gateway Token\",\n75\t      password: \"Password (not stored)\",