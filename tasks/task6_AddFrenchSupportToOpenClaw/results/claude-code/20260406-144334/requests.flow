2\t    connection: {\n123\t      title: \"How to connect\",\n124\t      step1: \"Start the gateway on your host machine:\",\n125\t      step2: \"Get a tokenized dashboard URL:\",\n126\t      step3: \"Paste the WebSocket URL and token above, or open the tokenized URL directly.\",\n127\t      step4: \"Or generate a reusable token:\",\n128\t      docsHint: \"For remote access, Tailscale Serve is recommended. \",\n129\t      docsLink: \"Read the docs ‚Üí\",\n130\t    },\n131\t    cards: {\n132\t      cost: \"Cost\",\n133\t      skills: \"Skills\",\n134\t      recentSessions: \"Recent Sessions\",\n135\t    },\n136\t    attention: {\n137\t      title: \"Attention\",\n138\t    },\n139\t    eventLog: {\n140\t      title: \"Event Log\",\n141\t    },\n142\t    logTail: {\n143\t      title: \"Gateway Logs\",\n144\t    },\n145\t    quickActions: {\n146\t      newSession: \"New Session\",\n147\t      automation: \"Automation\",\n148\t      refreshAll: \"Refresh All\",\n149\t      terminal: \"Terminal\",\n150\t    },\n151\t    palette: {\n152\t      placeholder: \"Type a command‚Ä¶\",\n153\t      noResults: \"No results\",\n154\t    },\n155\t  },\n156\t  login: {\n157\t    subtitle: \"Gateway Dashboard\",\n158\t    passwordPlaceholder: \"optional\",\n159\t  },\n160\t  chat: {\n161\t    disconnected: \"Disconnected from gateway.\",\n162\t    refreshTitle: \"Refresh chat data\",\n163\t    thinkingToggle: \"Toggle assistant thinking/working output\",\n164\t    toolCallsToggle: \"Toggle tool calls and tool results\",\n165\t    focusToggle: \"Toggle focus mode (hide sidebar + page header)\",\n166\t    hideCronSessions: \"Hide cron sessions\",\n167\t    showCronSessions: \"Show cron sessions\",\n168\t    showCronSessionsHidden: \"Show cron sessions ({count} hidden)\",\n169\t    onboardingDisabled: \"Disabled during setup\",\n170\t  },\n171\t  languages: {\n172\t    en: \"English\",\n173\t    zhCN: \"ÁÆÄ‰Ωì‰∏≠Êñá (Simplified Chinese)\",\n174\t    zhTW: \"ÁπÅÈ´î‰∏≠Êñá (Traditional Chinese)\",\n175\t    ptBR: \"Portugu√™s (Brazilian Portuguese)\",\n176\t    de: \"Deutsch (German)\",\n177\t    es: \"Espa√±ol (Spanish)\",\n178\t  },\n179\t  cron: {\n180\t    summary: {\n181\t      enabled: \"Enabled\",\n182\t      yes: \"Yes\",\n183\t      no: \"No\",\n184\t      jobs: \"Jobs\",\n185\t      nextWake: \"Next wake\",\n186\t      refreshing: \"Refreshing...\",\n187\t      refresh: \"Refresh\",\n188\t    },\n189\t    jobs: {\n190\t      title: \"Jobs\",\n191\t      subtitle: \"All scheduled jobs stored in the gateway.\",\n192\t      shownOf: \"{shown} shown of {total}\",\n193\t      searchJobs: \"Search jobs\",\n194\t      searchPlaceholder: \"Name, description, or agent\",\n195\t      enabled: \"Enabled\",\n196\t      schedule: \"Schedule\",\n197\t      lastRun: \"Last run\",\n198\t      all: \"All\",\n199\t      sort: \"Sort\",\n200\t      nextRun: \"Next run\",\n201\t      recentlyUpdated: \"Recently updated\",\n202\t      name: \"Name\",\n203\t      direction: \"Direction\",\n204\t      ascending: \"Ascending\",\n205\t      descending: \"Descending\",\n206\t      reset: \"Reset\",\n207\t      noMatching: \"No matching jobs.\",\n208\t      loading: \"Loading...\",\n209\t      loadMore: \"Load more jobs\",\n210\t    },\n211\t    runs: {\n212\t      title: \"Run history\",\n213\t      subtitleAll: \"Latest runs across all jobs.\",\n214\t      subtitleJob: \"Latest runs for {title}.\",\n215\t      scope: \"Scope\",\n216\t      allJobs: \"All jobs\",\n217\t      selectedJob: \"Selected job\",\n218\t      searchRuns: \"Search runs\",\n219\t      searchPlaceholder: \"Summary, error, or job\",\n220\t      newestFirst: \"Newest first\",\n221\t      oldestFirst: \"Oldest first\",\n222\t      status: \"Status\",\n223\t      delivery: \"Delivery\",\n224\t      clear: \"Clear\",\n225\t      allStatuses: \"All statuses\",\n226\t      allDelivery: \"All delivery\",\n227\t      selectJobHint: \"Select a job to inspect run history.\",\n228\t      noMatching: \"No matching runs.\",\n229\t      loadMore: \"Load more runs\",\n230\t      runStatusOk: \"OK\",\n231\t      runStatusError: \"Error\",\n232\t      runStatusSkipped: \"Skipped\",\n233\t      runStatusUnknown: \"Unknown\",\n234\t      deliveryDelivered: \"Delivered\",\n235\t      deliveryNotDelivered: \"Not delivered\",\n236\t      deliveryUnknown: \"Unknown\",\n237\t      deliveryNotRequested: \"Not requested\",\n238\t    },\n239\t    form: {\n240\t      editJob: \"Edit Job\",\n241\t      newJob: \"New Job\",\n242\t      updateSubtitle: \"Update the selected scheduled job.\",\n243\t      createSubtitle: \"Create a scheduled wakeup or agent run.\",\n244\t      required: \"Required\",\n245\t      requiredSr: \"required\",\n246\t      basics: \"Basics\",\n247\t      basicsSub: \"Name it, choose the assistant, and set enabled state.\",\n248\t      fieldName: \"Name\",\n249\t      description: \"Description\",\n250\t      agentId: \"Agent ID\",\n251\t      namePlaceholder: \"Morning brief\",\n252\t      descriptionPlaceholder: \"Optional context for this job\",\n253\t      agentPlaceholder: \"main or ops\",\n254\t      agentHelp: \"Start typing to pick a known agent, or enter a custom one.\",\n255\t      schedule: \"Schedule\",\n256\t      scheduleSub: \"Control when this job runs.\",\n257\t      every: \"Every\",\n258\t      at: \"At\",\n259\t      cronOption: \"Cron\",\n260\t      runAt: \"Run at\",\n261\t      unit: \"Unit\",\n262\t      minutes: \"Minutes\",\n263\t      hours: \"Hours\",\n264\t      days: \"Days\",\n265\t      expression: \"Expression\",\n266\t      expressionPlaceholder: \"0 7 * * *\",\n267\t      everyAmountPlaceholder: \"30\",\n268\t      timezoneOptional: \"Timezone (optional)\",\n269\t      timezonePlaceholder: \"America/Los_Angeles\",\n270\t      timezoneHelp: \"Pick a common timezone or enter any valid IANA timezone.\",\n271\t      jitterHelp: \"Need jitter? Use Advanced ‚Üí Stagger window / Stagger unit.\",\n272\t      execution: \"Execution\",\n273\t      executionSub: \"Choose when to wake, and what this job should do.\",\n274\t      session: \"Session\",\n275\t      main: \"Main\",\n276\t      isolated: \"Isolated\",\n277\t      sessionHelp: \"Main posts a system event. Isolated runs a dedicated agent turn.\",\n278\t      wakeMode: \"Wake mode\",\n279\t      now: \"Now\",\n280\t      nextHeartbeat: \"Next heartbeat\",\n281\t      wakeModeHelp: \"Now triggers immediately. Next heartbeat waits for the next cycle.\",\n282\t      payloadKind: \"What should run?\",\n283\t      systemEvent: \"Post message to main timeline\",\n284\t      agentTurn: \"Run assistant task (isolated)\",\n285\t      systemEventHelp:\n286\t        \"Sends your text to the gateway main timeline (good for reminders/triggers).\",\n287\t      agentTurnHelp: \"Starts an assistant run in its own session using your prompt.\",\n288\t      timeoutSeconds: \"Timeout (seconds)\",\n289\t      timeoutPlaceholder: \"Optional, e.g. 90\",\n290\t      timeoutHelp:\n291\t        \"Optional. Leave blank to use the gateway default timeout behavior for this run.\",\n292\t      mainTimelineMessage: \"Main timeline message\",\n293\t      assistantTaskPrompt: \"Assistant task prompt\",\n294\t      deliverySection: \"Delivery\",\n295\t      deliverySub: \"Choose where run summaries are sent.\",\n296\t      resultDelivery: \"Result delivery\",\n297\t      announceDefault: \"Announce summary (default)\",\n298\t      webhookPost: \"Webhook POST\",\n299\t      noneInternal: \"None (internal)\",\n300\t      deliveryHelp: \"Announce posts a summary to chat. None keeps execution internal.\",\n301\t      webhookUrl: \"Webhook URL\",\n302\t      channel: \"Channel\",\n303\t      webhookPlaceholder: \"https://example.com/cron\",\n304\t      channelHelp: \"Choose which connected channel receives the summary.\",\n305\t      webhookHelp: \"Send run summaries to a webhook endpoint.\",\n306\t      to: \"To\",\n307\t      toPlaceholder: \"+1555... or chat id\",\n308\t      toHelp: \"Optional recipient override (chat id, phone, or user id).\",\n309\t      advanced: \"Advanced\",\n310\t      advancedHelp:\n311\t        \"Optional overrides for delivery guarantees, schedule jitter, and model controls.\",\n312\t      deleteAfterRun: \"Delete after run\",\n313\t      deleteAfterRunHelp: \"Best for one-shot reminders that should auto-clean up.\",\n314\t      clearAgentOverride: \"Clear agent override\",\n315\t      clearAgentHelp: \"Force this job to use the gateway default assistant.\",\n316\t      exactTiming: \"Exact timing (no stagger)\",\n317\t      exactTimingHelp: \"Run on exact cron boundaries with no spread.\",\n318\t      staggerWindow: \"Stagger window\",\n319\t      staggerUnit: \"Stagger unit\",\n320\t      staggerPlaceholder: \"30\",\n321\t      seconds: \"Seconds\",\n322\t      model: \"Model\",\n323\t      modelPlaceholder: \"openai/gpt-5.2\",\n324\t      modelHelp: \"Start typing to pick a known model, or enter a custom one.\",\n325\t      thinking: \"Thinking\",\n326\t      thinkingPlaceholder: \"low\",\n327\t      thinkingHelp: \"Use a suggested level or enter a provider-specific value.\",\n328\t      bestEffortDelivery: \"Best effort delivery\",\n329\t      bestEffortHelp: \"Do not fail the job if delivery itself fails.\",\n330\t      cantAddYet: \"Can't add job yet\",\n331\t      fillRequired: \"Fill the required fields below to enable submit.\",\n332\t      fixFields: \"Fix {count} field to continue.\",\n333\t      fixFieldsPlural: \"Fix {count} fields to continue.\",\n334\t      saving: \"Saving...\",\n335\t      saveChanges: \"Save changes\",\n336\t      addJob: \"Add job\",\n337\t      cancel: \"Cancel\",\n338\t    },\n339\t    jobList: {\n340\t      allJobs: \"all jobs\",\n341\t      selectJob: \"(select a job)\",\n342\t      enabled: \"enabled\",\n343\t      disabled: \"disabled\",\n344\t      edit: \"Edit\",\n345\t      clone: \"Clone\",\n346\t      disable: \"Disable\",\n347\t      enable: \"Enable\",\n348\t      run: \"Run\",\n349\t      history: \"History\",\n350\t      remove: \"Remove\",\n351\t    },\n352\t    jobDetail: {\n353\t      system: \"System\",\n354\t      prompt: \"Prompt\",\n355\t      delivery: \"Delivery\",\n356\t      agent: \"Agent\",\n357\t    },\n358\t    jobState: {\n359\t      status: \"Status\",\n360\t      next: \"Next\",\n361\t      last: \"Last\",\n362\t    },\n363\t    runEntry: {\n364\t      noSummary: \"No summary.\",\n365\t      runAt: \"Run at\",\n366\t      openRunChat: \"Open run chat\",\n367\t      next: \"Next {rel}\",\n368\t      due: \"Due {rel}\",\n369\t    },\n370\t    errors: {\n371\t      nameRequired: \"Name is required.\",\n372\t      scheduleAtInvalid: \"Enter a valid date/time.\",\n373\t      everyAmountInvalid: \"Interval must be greater than 0.\",\n374\t      cronExprRequired: \"Cron expression is required.\",\n375\t      staggerAmountInvalid: \"Stagger must be greater than 0.\",\n376\t      systemTextRequired: \"System text is required.\",\n377\t      agentMessageRequired: \"Agent message is required.\",\n378\t      timeoutInvalid: \"If set, timeout must be greater than 0 seconds.\",\n379\t      webhookUrlRequired: \"Webhook URL is required.\",\n380\t      webhookUrlInvalid: \"Webhook URL must start with http:// or https://.\",\n381\t      invalidRunTime: \"Invalid run time.\",\n382\t      invalidIntervalAmount: \"Invalid interval amount.\",\n383\t      cronExprRequiredShort: \"Cron expression required.\",\n384\t      invalidStaggerAmount: \"Invalid stagger amount.\",\n385\t      systemEventTextRequired: \"System event text required.\",\n386\t      agentMessageRequiredShort: \"Agent message required.\",\n387\t      nameRequiredShort: \"Name required.\",\n388\t    },\n389\t  },\n390\t};\n391\t"},{"tool_use_id":"toolu_018dps9zSshGLgqMyD8j2UaC","type":"tool_result","content":"1\texport type TranslationMap = { [key: string]: string | TranslationMap };\n2\t\n3\texport type Locale = \"en\" | \"zh-CN\" | \"zh-TW\" | \"pt-BR\" | \"de\" | \"es\";\n4\t\n5\texport interface I18nConfig {\n6\t  locale: Locale;\n7\t  fallbackLocale: Locale;\n8\t  translations: Record<Locale, TranslationMap>;\n9\t}\n10\t"},{"tool_use_id":"toolu_01NpV99QsZfRqpcedSeE4Vfi","type":"tool_result","content":"1\timport { getSafeLocalStorage } from \"../../local-storage.ts\";\n2\timport { en } from \"../locales/en.ts\";\n3\timport {\n4\t  DEFAULT_LOCALE,\n5\t  SUPPORTED_LOCALES,\n6\t  isSupportedLocale,\n7\t  loadLazyLocaleTranslation,\n8\t  resolveNavigatorLocale,\n9\t} from \"./registry.ts\";\n10\timport type { Locale, TranslationMap } from \"./types.ts\";\n11\t\n12\ttype Subscriber = (locale: Locale) => void;\n13\t\n14\texport { SUPPORTED_LOCALES, isSupportedLocale };\n15\t\n16\tclass I18nManager {\n17\t  private locale: Locale = DEFAULT_LOCALE;\n18\t  private translations: Partial<Record<Locale, TranslationMap>> = { [DEFAULT_LOCALE]: en };\n19\t  private subscribers: Set<Subscriber> = new Set();\n20\t\n21\t  constructor() {\n22\t    this.loadLocale();\n23\t  }\n24\t\n25\t  private readStoredLocale(): string | null {\n26\t    const storage = getSafeLocalStorage();\n27\t    if (!storage) {\n28\t      return null;\n29\t    }\n30\t    try {\n31\t      return storage.getItem(\"openclaw.i18n.locale\");\n32\t    } catch {\n33\t      return null;\n34\t    }\n35\t  }\n36\t\n37\t  private persistLocale(locale: Locale) {\n38\t    const storage = getSafeLocalStorage();\n39\t    if (!storage) {\n40\t      return;\n41\t    }\n42\t    try {\n43\t      storage.setItem(\"openclaw.i18n.locale\", locale);\n44\t    } catch {\n45\t      // Ignore storage write failures in private/blocked contexts.\n46\t    }\n47\t  }\n48\t\n49\t  private resolveInitialLocale(): Locale {\n50\t    const saved = this.readStoredLocale();\n51\t    if (isSupportedLocale(saved)) {\n52\t      return saved;\n53\t    }\n54\t    const language =\n55\t      typeof globalThis.navigator?.language === \"string\" ? globalThis.navigator.language : null;\n56\t    return resolveNavigatorLocale(language ?? \"\");\n57\t  }\n58\t\n59\t  private loadLocale() {\n60\t    const initialLocale = this.resolveInitialLocale();\n61\t    if (initialLocale === DEFAULT_LOCALE) {\n62\t      this.locale = DEFAULT_LOCALE;\n63\t      return;\n64\t    }\n65\t    // Use the normal locale setter so startup locale loading follows the same\n66\t    // translation-loading + notify path as manual locale changes.\n67\t    void this.setLocale(initialLocale);\n68\t  }\n69\t\n70\t  public getLocale(): Locale {\n71\t    return this.locale;\n72\t  }\n73\t\n74\t  public async setLocale(locale: Locale) {\n75\t    const needsTranslationLoad = locale !== DEFAULT_LOCALE && !this.translations[locale];\n76\t    if (this.locale === locale && !needsTranslationLoad) {\n77\t      return;\n78\t    }\n79\t\n80\t    if (needsTranslationLoad) {\n81\t      try {\n82\t        const translation = await loadLazyLocaleTranslation(locale);\n83\t        if (!translation) {\n84\t          return;\n85\t        }\n86\t        this.translations[locale] = translation;\n87\t      } catch (e) {\n88\t        console.error(`Failed to load locale: ${locale}`, e);\n89\t        return;\n90\t      }\n91\t    }\n92\t\n93\t    this.locale = locale;\n94\t    this.persistLocale(locale);\n95\t    this.notify();\n96\t  }\n97\t\n98\t  public registerTranslation(locale: Locale, map: TranslationMap) {\n99\t    this.translations[locale] = map;\n100\t  }\n101\t\n102\t  public subscribe(sub: Subscriber) {\n103\t    this.subscribers.add(sub);\n104\t    return () => this.subscribers.delete(sub);\n105\t  }\n106\t\n107\t  private notify() {\n108\t    this.subscribers.forEach((sub) => sub(this.locale));\n109\t  }\n110\t\n111\t  public t(key: string, params?: Record<string, string>): string {\n112\t    const keys = key.split(\".\");\n113\t    let value: unknown = this.translations[this.locale] || this.translations[DEFAULT_LOCALE];\n114\t\n115\t    for (const k of keys) {\n116\t      if (value && typeof value === \"object\") {\n117\t        value = (value as Record<string, unknown>)[k];\n118\t      } else {\n119\t        value = undefined;\n120\t        break;\n121\t      }\n122\t    }\n123\t\n124\t    // Fallback to English.\n125\t    if (value === undefined && this.locale !== DEFAULT_LOCALE) {\n126\t      value = this.translations[DEFAULT_LOCALE];\n127\t      for (const k of keys) {\n128\t        if (value && typeof value === \"object\") {\n129\t          value = (value as Record<string, unknown>)[k];\n130\t        } else {\n131\t          value = undefined;\n132\t          break;\n133\t        }\n134\t      }\n135\t    }\n136\t\n137\t    if (typeof value !== \"string\") {\n138\t      return key;\n139\t    }\n140\t\n141\t    if (params) {\n142\t      return value.replace(/\\{(\\w+)\\}/g, (_, k) => params[k] || `{${k}}`);\n143\t    }\n144\t\n145\t    return value;\n146\t  }\n147\t}\n148\t\n149\texport const i18n = new I18nManager();\n150\texport const t = (key: string, params?: Record<string, string>) => i18n.t(key, params);\n151\n\n<system-reminder>\nThe task tools haven't been used recently. If you're working on tasks that would benefit from tracking progress, consider using TaskCreate to add new tasks and TaskUpdate to update task status (set to in_progress when starting, completed when done). Also consider cleaning up the task list if it has become stale. Only use these if relevant to the current work. This is just a gentle reminder - ignore if not applicable. Make sure that you NEVER mention this reminder to the user\n\n</system-reminder>"}]},{"role":"assistant","content":[{"type":"text","text":"Now let me check the other locale files and the lit-controller:"},{"type":"tool_use","id":"toolu_013gKvcHYPjzRKRLY86mBbG9","name":"Read","input":{"file_path":"/workspace/ui/src/i18n/locales/zh-CN.ts","limit":100}},{"type":"tool_use","id":"toolu_01JTzMZNTqmr3SeXy3RbmLeY","name":"Read","input":{"file_path":"/workspace/ui/src/i18n/lib/lit-controller.ts"}},{"type":"tool_use","id":"toolu_01XoZ4a