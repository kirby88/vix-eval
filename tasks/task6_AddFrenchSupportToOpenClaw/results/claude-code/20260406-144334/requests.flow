hannels: \"G√©rer les canaux et les param√®tres.\",\n    instances: \"Balises de pr√©sence des clients et n≈ìuds connect√©s.\",\n    sessions: \"Inspecter les sessions actives et ajuster les valeurs par d√©faut.\",\n    usage: \"Surveiller l'utilisation de l'API et les co√ªts.\",\n    cron: \"Planifier des r√©veils et des ex√©cutions r√©currentes d'agents.\",\n    skills: \"G√©rer la disponibilit√© des comp√©tences et l'injection de cl√©s API.\",\n    nodes: \"Appareils appari√©s, capacit√©s et exposition des commandes.\",\n    chat: \"Session de chat directe avec la passerelle pour des interventions rapides.\",\n    config: \"Modifier ~/.openclaw/openclaw.json en toute s√©curit√©.\",\n    debug: \"Instantan√©s de la passerelle, √©v√©nements et appels RPC manuels.\",\n    logs: \"Suivi en direct des journaux de la passerelle.\",\n  },\n  overview: {\n    access: {\n      title: \"Acc√®s √† la passerelle\",\n      subtitle: \"O√π le tableau de bord se connecte et comment il s'authentifie.\",\n      wsUrl: \"URL WebSocket\",\n      token: \"Jeton de la passerelle\",\n      password: \"Mot de passe (non stock√©)\", // pragma: allowlist secret\n      sessionKey: \"Cl√© de session par d√©faut\",\n      language: \"Langue\",\n      connectHint: \"Cliquez sur Connecter pour appliquer les modifications de connexion.\",\n      trustedProxy: \"Authentifi√© via un proxy de confiance.\",\n    },\n    snapshot: {\n      title: \"Instantan√©\",\n      subtitle: \"Informations les plus r√©centes de la n√©gociation avec la passerelle.\",\n      status: \"Statut\",\n      uptime: \"Temps de fonctionnement\",\n      tickInterval: \"Intervalle de tick\",\n      lastChannelsRefresh: \"Derni√®re actualisation des canaux\",\n      channelsHint:\n        \"Utilisez Canaux pour lier WhatsApp, Telegram, Discord, Signal ou iMessage.\",\n    },\n    stats: {\n      instances: \"Instances\",\n      instancesHint: \"Balises de pr√©sence au cours des 5 derni√®res minutes.\",\n      sessions: \"Sessions\",\n      sessionsHint: \"Cl√©s de session r√©centes suivies par la passerelle.\",\n      cron: \"Cron\",\n      cronNext: \"Prochain r√©veil {time}\",\n    },\n    notes: {\n      title: \"Notes\",\n      subtitle: \"Rappels rapides pour les configurations de contr√¥le √† distance.\",\n      tailscaleTitle: \"Tailscale serve\",\n      tailscaleText:\n        \"Pr√©f√©rez le mode serve pour maintenir la passerelle en loopback avec l'authentification tailnet.\",\n      sessionTitle: \"Hygi√®ne de session\",\n      sessionText: \"Utilisez /new ou sessions.patch pour r√©initialiser le contexte.\",\n      cronTitle: \"Rappels Cron\",\n      cronText: \"Utilisez des sessions isol√©es pour les ex√©cutions r√©currentes.\",\n    },\n    auth: {\n      required:\n        \"Cette passerelle n√©cessite une authentification. Ajoutez un jeton ou un mot de passe, puis cliquez sur Connecter.\",\n      failed:\n        \"√âchec de l'authentification. Recopiez une URL avec jeton via {command}, ou mettez √† jour le jeton, puis cliquez sur Connecter.\",\n    },\n    pairing: {\n      hint: \"Cet appareil n√©cessite l'approbation d'appariement de l'h√¥te de la passerelle.\",\n      mobileHint:\n        \"Sur mobile ? Copiez l'URL compl√®te (y compris #token=...) depuis openclaw dashboard --no-open sur votre bureau.\",\n    },\n    insecure: {\n      hint: \"Cette page est en HTTP, donc le navigateur bloque l'identit√© de l'appareil. Utilisez HTTPS (Tailscale Serve) ou ouvrez {url} sur l'h√¥te de la passerelle.\",\n      stayHttp: \"Si vous devez rester en HTTP, d√©finissez {config} (jeton uniquement).\",\n    },\n  },\n  chat: {\n    disconnected: \"D√©connect√© de la passerelle.\",\n    refreshTitle: \"Actualiser les donn√©es du chat\",\n    thinkingToggle: \"Activer/d√©sactiver la sortie de r√©flexion/travail de l'assistant\",\n    focusToggle: \"Activer/d√©sactiver le mode focus (masquer la barre lat√©rale + l'en-t√™te)\",\n    hideCronSessions: \"Masquer les sessions cron\"