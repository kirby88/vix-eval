d: \"Deshabilitado durante el inicio guiado\",\n121\t  },\n122\t  languages: {\n123\t    en: \"Ingl√©s (English)\",\n124\t    zhCN: \"Chino simplificado (ÁÆÄ‰Ωì‰∏≠Êñá)\",\n125\t    zhTW: \"Chino tradicional (ÁπÅÈ´î‰∏≠Êñá)\",\n126\t    ptBR: \"Portugu√©s brasile√±o (Portugu√™s)\",\n127\t    de: \"Deutsch (Alem√°n)\",\n128\t    es: \"Espa√±ol\",\n129\t  },\n130\t  cron: {\n131\t    summary: {\n132\t      enabled: \"Habilitado\",\n133\t      yes: \"S√≠\",\n134\t      no: \"No\",\n135\t      jobs: \"Tareas\",\n136\t      nextWake: \"Pr√≥xima activaci√≥n\",\n137\t      refreshing: \"Actualizando...\",\n138\t      refresh: \"Actualizar\",\n139\t    },\n140\t    jobs: {\n141\t      title: \"Tareas\",\n142\t      subtitle: \"Todas las tareas programadas almacenadas en la puerta de enlace.\",\n143\t      shownOf: \"{shown} mostradas de {total}\",\n144\t      searchJobs: \"Buscar tareas\",\n145\t      searchPlaceholder: \"Nombre, descripci√≥n o agente\",\n146\t      enabled: \"Habilitado\",\n147\t      schedule: \"Programaci√≥n\",\n148\t      lastRun: \"√öltima ejecuci√≥n\",\n149\t      all: \"Todas\",\n150\t      sort: \"Ordenar\",\n151\t      nextRun: \"Pr√≥xima ejecuci√≥n\",\n152\t      recentlyUpdated: \"Actualizadas recientemente\",\n153\t      name: \"Nombre\",\n154\t      direction: \"Direcci√≥n\",\n155\t      ascending: \"Ascendente\",\n156\t      descending: \"Descendente\",\n157\t      reset: \"Restablecer\",\n158\t      noMatching: \"No hay tareas coincidentes.\",\n159\t      loading: \"Cargando...\",\n160\t      loadMore: \"Cargar m√°s tareas\",\n161\t    },\n162\t    runs: {\n163\t      title: \"Historial de ejecuciones\",\n164\t      subtitleAll: \"√öltimas ejecuciones de todas las tareas.\",\n165\t      subtitleJob: \"√öltimas ejecuciones de {title}.\",\n166\t      scope: \"Alcance\",\n167\t      allJobs: \"Todas las tareas\",\n168\t      selectedJob: \"Tarea seleccionada\",\n169\t      searchRuns: \"Buscar ejecuciones\",\n170\t      searchPlaceholder: \"Resume