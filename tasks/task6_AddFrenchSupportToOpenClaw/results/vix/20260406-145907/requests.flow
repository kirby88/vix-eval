   passwordPlaceholder: \"optional\",\n  159\t  },\n  160\t  chat: {\n  161\t    disconnected: \"Disconnected from gateway.\",\n  162\t    refreshTitle: \"Refresh chat data\",\n  163\t    thinkingToggle: \"Toggle assistant thinking/working output\",\n  164\t    toolCallsToggle: \"Toggle tool calls and tool results\",\n  165\t    focusToggle: \"Toggle focus mode (hide sidebar + page header)\",\n  166\t    hideCronSessions: \"Hide cron sessions\",\n  167\t    showCronSessions: \"Show cron sessions\",\n  168\t    showCronSessionsHidden: \"Show cron sessions ({count} hidden)\",\n  169\t    onboardingDisabled: \"Disabled during setup\",\n  170\t  },\n  171\t  languages: {\n  172\t    en: \"English\",\n  173\t    zhCN: \"简体中文 (Simplified Chinese)\",\n  174\t    zhTW: \"繁體中文 (Traditional Chinese)\",\n  175\t    ptBR: \"Português (Brazilian Portuguese)\",\n  176\t    de: \"Deutsch (German)\",\n  177\t    es: \"Español (Spanish)\",\n  178\t  },\n  179\t  cron: {\n  180\t    summary: {\n  181\t      enabled: \"Enabled\",\n  182\t      yes: \"Yes\",\n  183\t      no: \"No\",\n  184\t      jobs: \"Jobs\",\n  185\t      nextWake: \"Next wake\",\n  186\t      refreshing: \"Refreshing...\",\n  187\t      refresh: \"Refresh\",\n  188\t    },\n  189\t    jobs: {\n  190\t      title: \"Jobs\",\n  191\t      subtitle: \"All scheduled jobs stored in the gateway.\",\n  192\t      shownOf: \"{shown} shown of {total}\",\n  193\t      searchJobs: \"Search jobs\",\n  194\t      searchPlaceholder: \"Name, description, or agent\",\n  195\t      enabled: \"Enabled\",\n  196\t      schedule: \"Schedule\",\n  197\t      lastRun: \"Last run\",\n  198\t      all: \"All\",\n  199\t      sort: \"Sort\",\n  200\t      nextRun: \"Next run\",\n  201\t      recentlyUpdated: \"Recently updated\",\n  202\t      name: \"Name\",\n  203\t      direction: \"Direction\",\n  204\t      ascending: \"Ascending\",\n  205\t      descending: \"Descending\",\n  206\t      reset: \"Reset\",\n  207\t      noMatching: \