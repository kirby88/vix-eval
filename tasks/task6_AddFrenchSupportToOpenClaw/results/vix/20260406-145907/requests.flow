nales para garantías de entrega, variación de programación y controles del modelo.\",\n  267\t      deleteAfterRun: \"Eliminar después de ejecutar\",\n  268\t      deleteAfterRunHelp:\n  269\t        \"Ideal para recordatorios de un solo uso que deben limpiarse automáticamente.\",\n  270\t      clearAgentOverride: \"Limpiar anulación de agente\",\n  271\t      clearAgentHelp:\n  272\t        \"Forza a esta tarea a usar el asistente predeterminado de la puerta de enlace.\",\n  273\t      exactTiming: \"Tiempo exacto (sin escalonamiento)\",\n  274\t      exactTimingHelp: \"Ejecutar en límites exactos de cron sin dispersión.\",\n  275\t      staggerWindow: \"Ventana de escalonamiento\",\n  276\t      staggerUnit: \"Unidad de escalonamiento\",\n  277\t      staggerPlaceholder: \"30\",\n  278\t      seconds: \"Segundos\",\n  279\t      model: \"Modelo\",\n  280\t      modelPlaceholder: \"openai/gpt-5.2\",\n  281\t      modelHelp:\n  282\t        \"Comienza a escribir para seleccionar un modelo conocido o ingresa uno personalizado.\",\n  283\t      thinking: \"Pensamiento\",\n  284\t      thinkingPlaceholder: \"bajo\",\n  285\t      thinkingHelp: \"Usa un nivel sugerido o ingresa un valor específico del proveedor.\",\n  286\t      bestEffortDelivery: \"Entrega de mejor esfuerzo\",\n  287\t      bestEffortHelp: \"No fallar la tarea si la entrega misma falla.\",\n  288\t      cantAddYet: \"Aún no se puede agregar la tarea\",\n  289\t      fillRequired: \"Completa los campos requeridos a continuación para habilitar el envío.\",\n  290\t      fixFields: \"Corrige {count} campo para continuar.\",\n  291\t      fixFieldsPlural: \"Corrige {count} campos para continuar.\",\n  292\t      saving: \"Guardando...\",\n  293\t      saveChanges: \"Guardar cambios\",\n  294\t      addJob: \"Agregar tarea\",\n  295\t      cancel: \"Cancelar\",\n  296\t    },\n  297\t    jobList: {\n  298\t      allJobs: \"todas las tareas\",\n  299\t      selectJob: \"(selecciona una tarea)\",\n  300\t      enabled: \"habilitada\",\n  301\t      disabled: \"deshabilitada\",\n  302\t      edit: \"Editar\",\n  303\t      clone: \"Clonar\",\n  304\t      disable: \"Deshabilitar\",\n  305\t      enable: \"Habilitar\",\n  306\t      run: \"Ejecutar\",\n  307\t      history: \"Historial\",\n  308\t      remove: \"Eliminar\",\n  309\t    },\n  310\t    jobDetail: {\n  311\t      system: \"Sistema\",\n  312\t      prompt: \"Indicación\",\n  313\t      delivery: \"Entrega\",\n  314\t      agent: \"Agente\",\n  315\t    },\n  316\t    jobState: {\n  317\t      status: \"Estado\",\n  318\t      next: \"Próxima\",\n  319\t      last: \"Última\",\n  320\t    },\n  321\t    runEntry: {\n  322\t      noSummary: \"Sin resumen.\",\n  323\t      runAt: \"Ejecutada a las\",\n  324\t      openRunChat: \"Abrir chat de ejecución\",\n  325\t      next: \"Próxima {rel}\",\n  326\t      due: \"Programada {rel}\",\n  327\t    },\n  328\t    errors: {\n  329\t      nameRequired: \"El nombre es requerido.\",\n  330\t      scheduleAtInvalid: \"Ingresa una fecha/hora válida.\",\n  331\t      everyAmountInvalid: \"El intervalo debe ser mayor a 0.\",\n  332\t      cronExprRequired: \"La expresión Cron es requerida.\",\n  333\t      staggerAmountInvalid: \"El escalonamiento debe ser mayor a 0.\",\n  334\t      systemTextRequired: \"El texto del sistema es requerido.\",\n  335\t      agentMessageRequired: \"El mensaje del agente es requerido.\",\n  336\t      timeoutInvalid: \"Si se establece, el tiempo de espera debe ser mayor a 0 segundos.\",\n  337\t      webhookUrlRequired: \"La URL del webhook es requerida.\",\n  338\t      webhookUrlInvalid: \"La URL del webhook debe comenzar con http:// o https://.\",\n  339\t      invalidRunTime: \"Tiempo de ejecución inválido.\",\n  340\t      invalidIntervalAmount: \"Cantidad de intervalo inválida.\",\n  341\t      cronExprRequiredShort: \"Expresión Cron requerida.\",\n  342\t      invalidStaggerAmount: \"Cantidad de escalonamiento inválida.\",\n  343\t      systemEventTextRequired: \"Texto de evento del sistema requerido.\",\n  344\t      agentMessageRequiredShort: \"Mensaje del agente requerido.\",\n  345\t      nameRequiredShort: \"Nombre requerido.\",\n  346\t    },\n  347\t  },\n  348\t};\n  349\t","type":"text"}],"type":"tool_result"}],"role":"user"},{"content":[{"id":"toolu_01UyU5ZVkzsc6DRy6TwdXTx5","input":{"path":"/workspace/ui/src/i18n/lib/types.ts","reason":"Need to see current Locale type union to update it"},"name":"read_file","type":"tool_use"},{"id":"toolu_01LQe744QC3Wic4WFwsjKSm2","input":{"path":"/workspace/ui/src/i18n/lib/registry.ts","reason":"Need to see current registry structure to add fr entries"},"name":"read_file","type":"tool_use"}],"role":"assistant"},{"content":[{"tool_use_id":"toolu_01UyU5ZVkzsc6DRy6TwdXTx5","is_error":false,"content":[{"text":"    1\texport type TranslationMap = { [key: string]: string | TranslationMap };\n    2\t\n    3\texport type Locale = \"en\" | \"zh-CN\" | \"zh-TW\" | \"pt-BR\" | \"de\" | \"es\";\n    4\t\n    5\texport interface I18nConfig {\n    6\t  locale: Locale;\n    7\t  fallbackLocale: Locale;\n    8\t  translations: Record\u003cLocale, TranslationMap\u003e;\n    9\t}\n   10\t","type":"text"}],"type":"tool_result"},{"tool_use_id":"toolu_01LQe744QC3Wic4WFwsjKSm2","is_error":false,"content":[{"text":"    1\timport type { Locale, TranslationMap } from \"./types.ts\";\n    2\t\n    3\ttype LazyLocale = Exclude\u003cLocale, \"en\"\u003e;\n    4\ttype LocaleModule = Record\u003cstring, TranslationMap\u003e;\n    5\t\n    6\ttype LazyLocaleRegistration = {\n    7\t  exportName: string;\n    8\t  loader: () =\u003e Promise\u003cLocaleModule\u003e;\n    9\t};\n   10\t\n   11\texport const DEFAULT_LOCALE: Locale = \"en\";\n   12\t\n   13\tconst LAZY_LOCALES: readonly LazyLocale[] = [\"zh-CN\", \"zh-TW\", \"pt-BR\", \"de\", \"es\"];\n   14\t\n   15\tconst LAZY_LOCALE_REGISTRY: Record\u003cLazyLocale, LazyLocaleRegistration\u003e = {\n   16\t  \"zh-CN\": {\n   17\t    exportName: \"zh_CN\",\n   18\t    loader: () =\u003e import(\"../locales/zh-CN.ts\"),\n   19\t  },\n   20\t  \"zh-TW\": {\n   21\t    exportName: \"zh_TW\",\n   22\t    loader: () =\u003e import(\"../locales/zh-TW.ts\"),\n   23\t  },\n   24\t  \"pt-BR\": {\n   25\t    exportName: \"pt_BR\",\n   26\t    loader: () =\u003e import(\"../locales/pt-BR.ts\"),\n   27\t  },\n   28\t  de: {\n   29\t    exportName: \"de\",\n   30\t    loader: () =\u003e import(\"../locales/de.ts\"),\n   31\t  },\n   32\t  es: {\n   33\t    exportName: \"es\",\n   34\t    loader: () =\u003e import(\"../locales/es.ts\"),\n   35\t  },\n   36\t};\n   37\t\n   38\texport const SUPPORTED_LOCALES: ReadonlyArray\u003cLocale\u003e = [DEFAULT_LOCALE, ...LAZY_LOCALES];\n   39\t\n   40\texport function isSupportedLocale(value: string | null | undefined): value is Locale {\n   41\t  return value !== null \u0026\u0026 value !== undefined \u0026\u0026 SUPPORTED_LOCALES.includes(value as Locale);\n   42\t}\n   43\t\n   44\tfunction isLazyLocale(locale: Locale): locale is LazyLocale {\n   45\t  return LAZY_LOCALES.includes(locale as LazyLocale);\n   46\t}\n   47\t\n   48\texport function resolveNavigatorLocale(navLang: string): Locale {\n   49\t  if (navLang.startsWith(\"zh\")) {\n   50\t    return navLang === \"zh-TW\" || navLang === \"zh-HK\" ? \"zh-TW\" : \"zh-CN\";\n   51\t  }\n   52\t  if (navLang.startsWith(\"pt\")) {\n   53\t    return \"pt-BR\";\n   54\t  }\n   55\t  if (navLang.startsWith(\"de\")) {\n   56\t    return \"de\";\n   57\t  }\n   58\t  if (navLang.startsWith(\"es\")) {\n   59\t    return \"es\";\n   60\t  }\n   61\t  return DEFAULT_LOCALE;\n   62\t}\n   63\t\n   64\texport async function loadLazyLocaleTranslation(locale: Locale): Promise\u003cTranslationMap | null\u003e {\n   65\t  if (!isLazyLocale(locale)) {\n   66\t    return null;\n   67\t  }\n   68\t  const registration = LAZY_LOCALE_REGISTRY[locale];\n   69\t  const module = await registration.loader();\n   70\t  return module[registration.exportName] ?? null;\n   71\t}\n   72\t","type":"text"}],"type":"tool_result"}],"role":"user"},{"content":[{"id":"toolu_01C28gViUG3UMkbRx4uh6zV1","input":{"path":"/workspace/src/i18n/registry.test.ts","reason":"Need to see current test assertions to update them correctly"},"name":"read_file","type":"tool_use"},{"id":"toolu_01T5oyyHQDt4BvgaRe1Yh5MH","input":{"path":"/workspace/ui/src/i18n/locales/de.ts","reason":"Need to see de.ts languages section to add fr entry"},"name":"read_file","type":"tool_use"}],"role":"assistant"},{"content":[{"tool_use_id":"toolu_01C28gViUG3UMkbRx4uh6zV1","is_error":false,"content":[{"text":"    1\timport { describe, expect, it } from \"vitest\";\n    2\timport {\n    3\t  DEFAULT_LOCALE,\n    4\t  SUPPORTED_LOCALES,\n    5\t  loadLazyLocaleTranslation,\n    6\t  resolveNavigatorLocale,\n    7\t} from \"../../ui/src/i18n/lib/registry.ts\";\n    8\timport type { TranslationMap } from \"../../ui/src/i18n/lib/types.ts\";\n    9\t\n   10\tfunction getNestedTranslation(map: TranslationMap | null, ...path: string[]): string | undefined {\n   11\t  let value: string | TranslationMap | undefined = map ?? undefined;\n   12\t  for (const key of path) {\n   13\t    if (value === undefined || typeof value === \"string\") {\n   14\t      return undefined;\n   15\t    }\n   16\t    value = value[key];\n   17\t  }\n   18\t  return typeof value === \"string\" ? value : undefined;\n   19\t}\n   20\t\n   21\tdescribe(\"ui i18n locale registry\", () =\u003e {\n   22\t  it(\"lists supported locales\", () =\u003e {\n   23\t    expect(SUPPORTED_LOCALES).toEqual([\"en\", \"zh-CN\", \"zh-TW\", \"pt-BR\", \"de\", \"es\"]);\n   24\t    expect(DEFAULT_LOCALE).toBe(\"en\");\n   25\t  });\n   26\t\n   27\t  it(\"resolves browser locale fallbacks\", () =\u003e {\n   28\t    expect(resolveNavigatorLocale(\"de-DE\")).toBe(\"de\");\n   29\t    expect(resolveNavigatorLocale(\"es-ES\")).toBe(\"es\");\n   30\t    expect(resolveNavigatorLocale(\"es-MX\")).toBe(\"es\");\n   31\t    expect(resolveNavigatorLocale(\"pt-PT\")).toBe(\"pt-BR\");\n   32\t    expect(resolveNavigatorLocale(\"zh-HK\")).toBe(\"zh-TW\");\n   33\t    expect(resolveNavigatorLocale(\"en-US\")).toBe(\"en\");\n   34\t  });\n   35\t\n   36\t  it(\"loads lazy locale translations from the registry\", async () =\u003e {\n   37\t    const de = await loadLazyLocaleTranslation(\"de\");\n   38\t    const es = await loadLazyLocaleTranslation(\"es\");\n   39\t    const ptBR = await loadLazyLocaleTranslation(\"pt-BR\");\n   40\t    const zhCN = await loadLazyLocaleTranslation(\"zh-CN\");\n   41\t\n   42\t    expect(getNestedTranslation(de, \"common\", \"health\")).toBe(\"Status\");\n   43\t    expect(getNestedTranslation(es, \"common\", \"health\")).toBe(\"Estado\");\n   44\t    expect(getNestedTranslation(es, \"languages\", \"de\")).toBe(\"Deutsch (Alemán)\");\n   45\t    expect(getNestedTranslation(ptBR, \"languages\", \"es\")).toBe(\"Español (Espanhol)\");\n   46\t    expect(getNestedTranslation(zhCN, \"common\", \"health\")).toBe(\"\\u5065\\u5eb7\\u72b6\\u51b5\");\n   47\t    expect(await loadLazyLocaleTranslation(\"en\")).toBeNull();\n   48\t  });\n   49\t});\n   50\t","type":"text"}],"type":"tool_result"},{"tool_use_id":"toolu_01T5oyyHQDt4BvgaRe1Yh5MH","is_error":false,"content":[{"text":"    1\timport type { TranslationMap } from \"../lib/types.ts\";\n    2\t\n    3\texport const de: TranslationMap = {\n    4\t  common: {\n    5\t    version: \"Version\",\n    6\t    health: \"Status\",\n    7\t    ok: \"OK\",\n    8\t    online: \"Online\",\n    9\t    offline: \"Offline\",\n   10\t    connect: \"Verbinden\",\n   11\t    refresh: \"Aktualisieren\",\n   12\t    enabled: \"Aktiviert\",\n   13\t    disabled: \"Deaktiviert\",\n   14\t    na: \"k. A.\",\n   15\t    docs: \"Dokumentation\",\n   16\t    resources: \"Ressourcen\",\n   17\t  },\n   18\t  nav: {\n   19\t    chat: \"Chat\",\n   20\t    control: \"Steuerung\",\n   21\t    agent: \"Agent\",\n   22\t    setting