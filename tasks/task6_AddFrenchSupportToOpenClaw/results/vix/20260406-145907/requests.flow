oardingDisabled: \"Desativado durante a integração\",\n  170\t  },\n  171\t  languages: {\n  172\t    en: \"English\",\n  173\t    zhCN: \"简体中文 (Chinês Simplificado)\",\n  174\t    zhTW: \"繁體中文 (Chinês Tradicional)\",\n  175\t    ptBR: \"Português (Português Brasileiro)\",\n  176\t    de: \"Deutsch (Alemão)\",\n  177\t    es: \"Español (Espanhol)\",\n  178\t  },\n  179\t};\n  180\t","type":"text"}],"type":"tool_result"},{"tool_use_id":"toolu_016xhCKLUaCg7KaHaphvFbzq","is_error":false,"content":[{"text":"    1\timport type { TranslationMap } from \"../lib/types.ts\";\n    2\t\n    3\texport const zh_CN: TranslationMap = {\n    4\t  common: {\n    5\t    health: \"健康状况\",\n    6\t    ok: \"正常\",\n    7\t    online: \"在线\",\n    8\t    offline: \"离线\",\n    9\t    connect: \"连接\",\n   10\t    refresh: \"刷新\",\n   11\t    enabled: \"已启用\",\n   12\t    disabled: \"已禁用\",\n   13\t    na: \"不适用\",\n   14\t    version: \"版本\",\n   15\t    docs: \"文档\",\n   16\t    resources: \"资源\",\n   17\t    search: \"搜索\",\n   18\t  },\n   19\t  nav: {\n   20\t    chat: \"聊天\",\n   21\t    control: \"控制\",\n   22\t    agent: \"代理\",\n   23\t    settings: \"设置\",\n   24\t    expand: \"展开侧边栏\",\n   25\t    collapse: \"折叠侧边栏\",\n   26\t    resize: \"调整侧边栏大小\",\n   27\t  },\n   28\t  tabs: {\n   29\t    agents: \"代理\",\n   30\t    overview: \"概览\",\n   31\t    channels: \"频道\",\n   32\t    instances: \"实例\",\n   33\t    sessions: \"会话\",\n   34\t    usage: \"使用情况\",\n   35\t    cron: \"定时任务\",\n   36\t    skills: \"技能\",\n   37\t    nodes: \"节点\",\n   38\t    chat: \"聊天\",\n   39\t    config: \"配置\",\n   40\t    communications: \"通信\",\n   41\t    appearance: \"外观与设置\",\n   42\t    automation: \"自动化\",\n   43\t    infrastructure: \"基础设施\",\n   44\t    aiAgents: \"AI 与代理\",\n   45\t    debug: \"调试\",\n   46\t    logs: \"日志\",\n   47\t  },\n   48\t  subtitles: {\n   49\t    agents: \"工作区、工具、身份。\",\n   50\t    overview: \"状态、入口点、健康。\",\n   51\t    channels: \"频道和设置。\",\n   52\t    instances: \"已连接客户端和节点。\",\n   53\t    sessions: \"活动会话和默认设置。\",\n   54\t    usage: \"API 使用情况和成本。\",\n   55\t    cron: \"唤醒和重复运行。\",\n   56\t    skills: \"技能和 API 密钥。\",\n   57\t    nodes: \"配对设备和命令。\",\n   58\t    chat: \"网关聊天，快速干预。\",\n   59\t    config: \"编辑 openclaw.json。\",\n   60\t    communications: \"频道、消息和音频设置。\",\n   61\t    appearance: \"主题、界面和设置向导设置。\",\n   62\t    automation: \"命令、钩子、定时任务和插件设置。\",\n   63\t    infrastructure: \"网关、Web、浏览器和媒体设置。\",\n   64\t    aiAgents: \"代理、模型、技能、工具、记忆和会话设置。\",\n   65\t    debug: \"快照、事件、RPC。\",\n   66\t    logs: \"实时网关日志。\",\n   67\t  },\n   68\t  overview: {\n   69\t    access: {\n   70\t      title: \"网关访问\",\n   71\t      subtitle: \"仪表板连接的位置及其身份验证方式。\",\n   72\t      wsUrl: \"WebSocket URL\",\n   73\t      token: \"网关令牌\",\n   74\t      password: \"密码 (不存储)\",\n   75\t      sessionKey: \"默认会话密钥\",\n   76\t      language: \"语言\",\n   77\t      connectHint: \"点击连接以应用连接更改。\",\n   78\t      trustedProxy: \"通过受信任代理认证。\",\n   79\t    },\n   80\t    snapshot: {\n   81\t      title: \"快照\",\n   82\t      subtitle: \"最新的网关握手信息。\",\n   83\t      status: \"状态\",\n   84\t      uptime: \"运行时间\",\n   85\t      tickInterval: \"刻度间隔\",\n   86\t      lastChannelsRefresh: \"最后频道刷新\",\n   87\t      channelsHint: \"使用频道链接 WhatsApp、Telegram、Discord、Signal 或 iMessage。\",\n   88\t    },\n   89\t    stats: {\n   90\t      instances: \"实例\",\n   91\t      instancesHint: \"过去 5 分钟内的在线信号。\",\n   92\t      sessions: \"会话\",\n   93\t      sessionsHint: \"网关跟踪的最近会话密钥。\",\n   94\t      cron: \"定时任务\",\n   95\t      cronNext: \"下次唤醒 {time}\",\n   96\t    },\n   97\t    notes: {\n   98\t      title: \"备注\",\n   99\t      subtitle: \"远程控制设置的快速提醒。\",\n  100\t      tailscaleTitle: \"Tailscale serve\",\n  101\t      tailscaleText: \"首选 serve 模式以通过 tailnet 身份验证将网关保持在回环地址。\",\n  102\t      sessionTitle: \"会话清理\",\n  103\t      sessionText: \"使用 /new 或 sessions.patch 重置上下文。\",\n  104\t      cronTitle: \"定时任务提醒\",\n  105\t      cronText: \"为重复运行使用隔离的会话。\",\n  106\t    },\n  107\t    auth: {\n  108\t      required: \"此网关需要身份验证。添加令牌或密码，然后点击连接。\",\n  109\t      failed: \"身份验证失败。请使用 {command} 重新复制令牌化 URL，或更新令牌，然后点击连接。\",\n  110\t    },\n  111\t    pairing: {\n  112\t      hint: \"此设备需要网关主机的配对批准。\",\n  113\t      mobileHint:\n  114\t        \"在手机上？从桌面运行 openclaw dashboard --no-open 复制完整 URL（包括 #token=...）。\",\n  115\t    },\n  116\t    insecure: {\n  117\t      hint: \"此页面为 HTTP，因此浏览器阻止设备标识。请使用 HTTPS (Tailscale Serve) 或在网关主机上打开 {url}。\",\n  118\t      stayHttp: \"如果您必须保持 HTTP，请设置 {config} (仅限令牌)。\",\n  119\t    },\n  120\t    connection: {\n  121\t      title: \"如何连接\",\n  122\t      step1: \"在主机上启动网关：\",\n  123\t      step2: \"获取带令牌的仪表盘 URL：\",\n  124\t      step3: \"将 WebSocket URL 和令牌粘贴到上方，或直接打开带令牌的 URL。\",\n  125\t      step4: \"或生成可重复使用的令牌：\",\n  126\t      docsHint: \"如需远程访问，建议使用 Tailscale Serve。\",\n  127\t      docsLink: \"查看文档 →\",\n  128\t    },\n  129\t    cards: {\n  130\t      cost: \"费用\",\n  131\t      skills: \"技能\",\n  132\t      recentSessions: \"最近会话\",\n  133\t    },\n  134\t    attention: {\n  135\t      title: \"注意事项\",\n  136\t    },\n  137\t    eventLog: {\n  138\t      title: \"事件日志\",\n  139\t    },\n  140\t    logTail: {\n  141\t      title: \"网关日志\",\n  142\t    },\n  143\t    quickActions: {\n  144\t      newSession: \"新建会话\",\n  145\t      automation: \"自动化\",\n  146\t      refreshAll: \"全部刷新\",\n  147\t      terminal: \"终端\",\n  148\t    },\n  149\t    palette: {\n  150\t      placeholder: \"输入命令…\",\n  151\t      noResults: \"无结果\",\n  152\t    },\n  153\t  },\n  154\t  login: {\n  155\t    subtitle: \"网关仪表盘\",\n  156\t    passwordPlaceholder: \"可选\",\n  157\t  },\n  158\t  chat: {\n  159\t    disconnected: \"已断开与网关的连接。\",\n  160\t    refreshTitle: \"刷新聊天数据\",\n  161\t    thinkingToggle: \"切换助手思考/工作输出\",\n  162\t    focusToggle: \"切换专注模式 (隐藏侧边栏 + 页面页眉)\",\n  163\t    hideCronSessions: \"隐藏定时任务会话\",\n  164\t    showCronSessions: \"显示定时任务会话\",\n  165\t    showCronSessionsHidden: \"显示定时任务会话 (已隐藏 {count} 个)\",\n  166\t    onboardingDisabled: \"引导期间禁用\",\n  167\t  },\n  168\t  languages: {\n  169\t    en: \"English\",\n  170\t    zhCN: \"简体中文 (简体中文)\",\n  171\t    zhTW: \"繁體中文 (繁体中文)\",\n  172\t    ptBR: \"Português (巴西葡萄牙语)\",\n  173\t    de: \"Deutsch (德语)\",\n  174\t    es: \"Español (西班牙语)\",\n  175\t  },\n  176\t  cron: {\n  177\t    summary: {\n  178\t      enabled: \"已启用\",\n  179\t      yes: \"是\",\n  180\t      no: \"否\",\n  181\t      jobs: \"任务数\",\n  182\t      nextWake: \"下次唤醒\",\n  183\t      refreshing: \"刷新中...\",\n  184\t      refresh: \"刷新\",\n  185\t    },\n  186\t    jobs: {\n  187\t      title: \"任务列表\",\n  188\t      subtitle: \"网关中存储的所有定时任务。\",\n  189\t      shownOf: \"显示 {shown} / 共 {total}\",\n  190\t      searchJobs: \"搜索任务\",\n  191\t      searchPlaceholder: \"名称、描述或代理\",\n  192\t      enabled: \"启用状态\",\n  193\t      all: \"全部\",\n  194\t      sort: \"排序\",\n  195\t      nextRun: \"下次运行\",\n  196\t      recentlyUpdated: \"最近更新\",\n  197\t      name: \"名称\",\n  198\t      direction: \"方向\",\n  199\t      ascending: \"升序\",\n  200\t      descending: \"降序\",\n  201\t      noMatching: \"没有匹配的任务。\",\n  202\t      loading: \"加载中...\",\n  203\t      loadMore: \"加载更多任务\",\n  204\t    },\n  205\t    runs: {\n  206\t      title: \"运行历史\",\n  207\t      subtitleAll: \"所有任务的最新运行记录。\",\n  208\t      subtitleJob: \"{title} 的最新运行记录。\",\n  209\t      scope: \"范围\",\n  210\t      allJobs: \"所有任务\",\n  211\t      selectedJob: \"已选任务\",\n  212\t      searchRuns: \"搜索运行\",\n  213\t      searchPlaceholder: \"摘要、错误或任务\",\n  214\t      newestFirst: \"最新优先\",\n  215\t      oldestFirst: \"最早优先\",\n  216\t      status: \"状态\",\n  217\t      delivery: \"投递\",\n  218\t      clear: \"清除\",\n  219\t      allStatuses: \"全部状态\",\n  220\t      allDelivery: \"全部投递\",\n  221\t      selectJobHint: \"请选择一个任务以查看运行历史。\",\n  222\t      noMatching: \"没有匹配的运行记录。\",\n  223\t      loadMore: \"加载更多运行\",\n  224\t      runStatusOk: \"成功\",\n  225\t      runStatusError: \"错误\",\n  226\t      runStatusSkipped: \"已跳过\",\n  227\t      runStatusUnknown: \"未知\",\n  228\t      deliveryDelivered: \"已投递\",\n  229\t      deliveryNotDelivered: \"未投递\",\n  230\t      deliveryUnknown: \"未知\",\n  231\t      deliveryNotRequested: \"未请求\",\n  232\t    },\n  233\t    form: {\n  234\t      editJob: \"编辑任务\",\n  235\t      newJob: \"新建任务\",\n  236\t      updateSubtitle: \"更新所选定时任务。\",\n  237\t      createSubtitle: \"创建定时唤醒或代理运行。\",\n  238\t      required: \"必填\",\n  239\t      requiredSr: \"必填\",\n  240\t      basics: \"基本信息\",\n  241\t      basicsSub: \"命名、选择助手并设置启用状态。\",\n  242\t      fieldName: \"名称\",\n  243\t      description: \"描述\",\n  244\t      agentId: \"代理 ID\",\n  245\t      namePlaceholder: \"晨间简报\",\n  246\t      descriptionPlaceholder: \"此任务的可选说明\",\n  247\t      agentPlaceholder: \"main 或 ops\",\n  248\t      agentHelp: \"输入以选择已知代理，或输入自定义 ID。\",\n  249\t      schedule: \"调度\",\n  250\t      scheduleSub: \"控制任务运行时间。\",\n  251\t      every: \"每隔\",\n  252\t      at: \"指定时间\",\n  253\t      cronOption: \"Cron\",\n  254\t      runAt: \"运行时间\",\n  255\t      unit: \"单位\",\n  256\t      minutes: \"分钟\",\n  257\t      hours: \"小时\",\n  258\t      days: \"天\",\n  259\t      expression: \"表达式\",\n  260\t      expressionPlaceholder: \"0 7 * * *\",\n  261\t      everyAmountPlaceholder: \"30\",\n  262\t      timezoneOptional: \"时区（可选）\",\n  263\t      timezonePlaceholder: \"America/Los_Angeles\",\n  264\t      timezoneHelp: \"选择常用时区或输入有效的 IANA 时区。\",\n  265\t      jitterHelp: \"需要抖动？使用高级 → 抖动窗口 / 抖动单位。\",\n  266\t      execution: \"执行\",\n  267\t      executionSub: \"选择唤醒时机和任务执行内容。\",\n  268\t      session: \"会话\",\n  269\t      main: \"主会话\",\n  270\t      isolated: \"隔离会话\",\n  271\t      sessionHelp: \"主会话发布系统事件。隔离会话运行独立的代理轮次。\",\n  272\t      wakeMode: \"唤醒模式\",\n  273\t      now: \"立即\",\n  274\t      nextHeartbeat: \"下次心跳\",\n  275\t      wakeModeHelp: \"立即模式立即触发。下次心跳等待下一个周期。\",\n  276\t      payloadKind: \"执行内容\",\n  277\t      systemEvent: \"发布消息到主时间线\"