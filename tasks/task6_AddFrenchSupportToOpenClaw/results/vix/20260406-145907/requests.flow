",\n  261\t      unit: \"Unit\",\n  262\t      minutes: \"Minutes\",\n  263\t      hours: \"Hours\",\n  264\t      days: \"Days\",\n  265\t      expression: \"Expression\",\n  266\t      expressionPlaceholder: \"0 7 * * *\",\n  267\t      everyAmountPlaceholder: \"30\",\n  268\t      timezoneOptional: \"Timezone (optional)\",\n  269\t      timezonePlaceholder: \"America/Los_Angeles\",\n  270\t      timezoneHelp: \"Pick a common timezone or enter any valid IANA timezone.\",\n  271\t      jitterHelp: \"Need jitter? Use Advanced → Stagger window / Stagger unit.\",\n  272\t      execution: \"Execution\",\n  273\t      executionSub: \"Choose when to wake, and what this job should do.\",\n  274\t      session: \"Session\",\n  275\t      main: \"Main\",\n  276\t      isolated: \"Isolated\",\n  277\t      sessionHelp: \"Main posts a system event. Isolated runs a dedicated agent turn.\",\n  278\t      wakeMode: \"Wake mode\",\n  279\t      now: \"Now\",\n  280\t      nextHeartbeat: \"Next heartbeat\",\n  281\t      wakeModeHelp: \"Now triggers immediately. Next heartbeat waits for the next cycle.\",\n  282\t      payloadKind: \"What should run?\",\n  283\t      systemEvent: \"Post message to main timeline\",\n  284\t      agentTurn: \"Run assistant task (isolated)\",\n  285\t      systemEventHelp:\n  286\t        \"Sends your text to the gateway main timeline (good for reminders/triggers).\",\n  287\t      agentTurnHelp: \"Starts an assistant run in its own session using your prompt.\",\n  288\t      timeoutSeconds: \"Timeout (seconds)\",\n  289\t      timeoutPlaceholder: \"Optional, e.g. 90\",\n  290\t      timeoutHelp:\n  291\t        \"Optional. Leave blank to use the gateway default timeout behavior for this run.\",\n  292\t      mainTimelineMessage: \"Main timeline message\",\n  293\t      assistantTaskPrompt: \"Assistant task prompt\",\n  294\t      deliverySection: \"Delivery\",\n  295\t      deliverySub: \"Choose where run summaries are sent.\",\n  296\t      resultDelivery: \"Result delivery\",\n  297\t      announceDefault: \"Announce summary (default)\",\n  298\t      webhookPost: \"Webhook POST\",\n  299\t      noneInternal: \"None (internal)\",\n  300\t      deliveryHelp: \"Announce posts a summary to chat. None keeps execution internal.\",\n  301\t      webhookUrl: \"Webhook URL\",\n  302\t      channel: \"Channel\",\n  303\t      webhookPlaceholder: \"https://example.com/cron\",\n  304\t      channelHelp: \"Choose which connected channel receives the summary.\",\n  305\t      webhookHelp: \"Send run summaries to a webhook endpoint.\",\n  306\t      to: \"To\",\n  307\t      toPlaceholder: \"+1555... or chat id\",\n  308\t      toHelp: \"Optional recipient override (chat id, phone, or user id).\",\n  309\t      advanced: \"Advanced\",\n  310\t      advancedHelp:\n  311\t        \"Optional overrides for delivery guarantees, schedule jitter, and model controls.\",\n  312\t      deleteAfterRun: \"Delete after run\",\n  313\t      deleteAfterRunHelp: \"Best for one-shot reminders that should auto-clean up.\",\n  314\t      clearAgentOverride: \"Clear agent override\",\n  315\t      clearAgentHelp: \"Force this job to use the gateway default assistant.\",\n  316\t      exactTiming: \"Exact timing (no stagger)\",\n  317\t      exactTimingHelp: \"Run on exact cron boundaries with no spread.\",\n  318\t      staggerWindow: \"Stagger window\",\n  319\t      staggerUnit: \"Stagger unit\",\n  320\t      staggerPlaceholder: \"30\",\n  321\t      seconds: \"Seconds\",\n  322\t      model: \"Model\",\n  323\t      modelPlaceholder: \"openai/gpt-5.2\",\n  324\t      modelHelp: \"Start typing to pick a known model, or enter a custom one.\",\n  325\t      thinking: \"Thinking\",\n  326\t      thinkingPlaceholder: \"low\",\n  327\t      thinkingHelp: \"Use a suggested level or enter a provider-specific value.\",\n  328\t      bestEffortDelivery: \"Best effort delivery\",\n  329\t      bestEffortHelp: \"Do not fail the job if delivery itself fails.\",\n  330\t      cantAddYet: \"Can't add job yet\",\n  331\t      fillRequired: \"Fill the required fields below to enable submit.\",\n  332\t      fixFields: \"Fix {count} field to continue.\",\n  333\t      fixFieldsPlural: \"Fix {count} fields to continue.\",\n  334\t      saving: \"Saving...\",\n  335\t      saveChanges: \"Save changes\",\n  336\t      addJob: \"Add job\",\n  337\t      cancel: \"Cancel\",\n  338\t    },\n  339\t    jobList: {\n  340\t      allJobs: \"all jobs\",\n  341\t      selectJob: \"(select a job)\",\n  342\t      enabled: \"enabled\",\n  343\t      disabled: \"disabled\",\n  344\t      edit: \"Edit\",\n  345\t      clone: \"Clone\",\n  346\t      disable: \"Disable\",\n  347\t      enable: \"Enable\",\n  348\t      run: \"Run\",\n  349\t      history: \"History\",\n  350\t      remove: \"Remove\",\n  351\t    },\n  352\t    jobDetail: {\n  353\t      system: \"System\",\n  354\t      prompt: \"Prompt\",\n  355\t      delivery: \"Delivery\",\n  356\t      agent: \"Agent\",\n  357\t    },\n  358\t    jobState: {\n  359\t      status: \"Status\",\n  360\t      next: \"Next\",\n  361\t      last: \"Last\",\n  362\t    },\n  363\t    runEntry: {\n  364\t      noSummary: \"No summary.\",\n  365\t      runAt: \"Run at\",\n  366\t      openRunChat: \"Open run chat\",\n  367\t      next: \"Next {rel}\",\n  368\t      due: \"Due {rel}\",\n  369\t    },\n  370\t    errors: {\n  371\t      nameRequired: \"Name is required.\",\n  372\t      scheduleAtInvalid: \"Enter a valid date/time.\",\n  373\t      everyAmountInvalid: \"Interval must be greater than 0.\",\n  374\t      cronExprRequired: \"Cron expression is required.\",\n  375\t      staggerAmountInvalid: \"Stagger must be greater than 0.\",\n  376\t      systemTextRequired: \"System text is required.\",\n  377\t      agentMessageRequired: \"Agent message is required.\",\n  378\t      timeoutInvalid: \"If set, timeout must be greater than 0 seconds.\",\n  379\t      webhookUrlRequired: \"Webhook URL is required.\",\n  380\t      webhookUrlInvalid: \"Webhook URL must start with http:// or https://.\",\n  381\t      invalidRunTime: \"Invalid run time.\",\n  382\t      invalidIntervalAmount: \"Invalid interval amount.\",\n  383\t      cronExprRequiredShort: \"Cron expression required.\",\n  384\t      invalidStaggerAmount: \"Invalid stagger amount.\",\n  385\t      systemEventTextRequired: \"System event text required.\",\n  386\t      agentMessageRequiredShort: \"Agent message required.\",\n  387\t      nameRequiredShort: \"Name required.\",\n  388\t    },\n  389\t  },\n  390\t};\n  391\t","type":"text"}],"type":"tool_result"},{"tool_use_id":"toolu_01DTMw22X3ry64F1GJPpsVhn","is_error":false,"content":[{"text":"    1\timport type { TranslationMap } from \"../lib/types.ts\";\n    2\t\n    3\texport const es: TranslationMap = {\n    4\t  common: {\n    5\t    version: \"Versión\",\n    6\t    health: \"Estado\",\n    7\t    ok: \"Correcto\",\n    8\t    online: \"En línea\",\n    9\t    offline: \"Desconectado\",\n   10\t    connect: \"Conectar\",\n   11\t    refresh: \"Actualizar\",\n   12\t    enabled: \"Habilitado\",\n   13\t    disabled: \"Deshabilitado\",\n   14\t    na: \"n/a\",\n   15\t    docs: \"Docs\",\n   16\t    resources: \"Recursos\",\n   17\t  },\n   18\t  nav: {\n   19\t    chat: \"Chat\",\n   20\t    control: \"Control\",\n   21\t    agent: \"Agente\",\n   22\t    settings: \"Ajustes\",\n   23\t    expand: \"Expandir barra lateral\",\n   24\t    collapse: \"Contraer barra lateral\",\n   25\t  },\n   26\t  tabs: {\n   27\t    agents: \"Agentes\",\n   28\t    overview: \"Resumen\",\n   29\t    channels: \"Canales\",\n   30\t    instances: \"Instancias\",\n   31\t    sessions: \"Sesiones\",\n   32\t    usage: \"Uso\",\n   33\t    cron: \"Tareas Cron\",\n   34\t    skills: \"Habilidades\",\n   35\t    nodes: \"Nodos\",\n   36\t    chat: \"Chat\",\n   37\t    config: \"Configuración\",\n   38\t    debug: \"Depuración\",\n   39\t    logs: \"Registros\",\n   40\t  },\n   41\t  subtitles: {\n   42\t    agents: \"Gestionar espacios de trabajo, herramientas e identidades de agentes.\",\n   43\t    overview: \"Estado de la puerta de enlace, puntos de entrada y lectura rápida de salud.\",\n   44\t    channels: \"Gestionar canales y ajustes.\",\n   45\t    instances: \"Balizas de presencia de clientes y nodos conectados.\",\n   46\t    sessions: \"Inspeccionar sesiones activas y ajustar valores predeterminados por sesión.\",\n   47\t    usage: \"Monitorear uso de API y costes.\",\n   48\t    cron: \"Programar despertares y ejecuciones recurrentes de agentes.\",\n   49\t    skills: \"Gestionar disponibilidad de habilidades e inyección de claves API.\",\n   50\t    nodes: \"Dispositivos emparejados, capacidades y exposición de comandos.\",\n   51\t    chat: \"Sesión de chat directa con la puerta de enlace para intervenciones rápidas.\",\n   52\t    config: \"Editar ~/.openclaw/openclaw.json de forma segura.\",\n   53\t    debug: \"Instantáneas de la puerta de enlace, eventos y llamadas RPC manuales.\",\n   54\t    logs: \"Seguimiento en vivo de los registros de la puerta de enlace.\",\n   55\t  },\n   56\t  overview: {\n   57\t    access: {\n   58\t      title: \"Acceso a la puerta de enlace\",\n   59\t      subtitle: \"Dónde se conecta el panel y cómo se autentica.\",\n   60\t      wsUrl: \"URL de WebSocket\",\n   61\t      token: \"Token de la puerta de enlace\",\n   62\t      password: \"Contraseña (no se guarda)\", // pragma: allowlist secret\n   63\t      sessionKey: \"Clave de sesión predeterminada\",\n   64\t      language: \"Idioma\",\n   65\t      connectHint: \"Haz clic en Conectar para aplicar los cambios de conexión.\",\n   66\t      trustedProxy: \"Autenticado mediante proxy de confianza.\",\n   67\t    },\n   68\t    snapshot: {\n   69\t      title: \"Instantánea\",\n   70\t      subtitle: \"Información más reciente del saludo con la puerta de enlace.\",\n   71\t      status: \"Estado\",\n   72\t      uptime: \"Tiempo de actividad\",\n   73\t      tickInterval: \"Intervalo de tick\",\n   74\t      lastChannelsRefresh: \"Última actualización de canales\",\n   75\t      channelsHint: \"Usa Canales para vincular WhatsApp, Telegram, Discord, Signal o iMessage.\",\n   76\t    },\n   77\t    stats: {\n   78\t      instances: \"Instancias\",\n   79\t      instancesHint: \"Balizas de presencia en los últimos 5 minutos.\",\n   80\t      sessions: \"Sesiones\",\n   81\t      sessionsHint: \"Claves de sesión recientes rastreadas por la puerta de enlace.\",\n   82\t      cron: \"Cron\",\n   83\t      cronNext: \"Próximo despertar {time}\",\n   84\t    },\n   85\t    notes: {\n   86\t      title: \"Notas\",\n   87\t      subtitle: \"Recordatorios rápidos para configuraciones de control remoto.\",\n   88\t      tailscaleTitle: \"Tailscale serve\",\n   89\t      tailscaleText:\n   90\t        \"Prefiere el modo serve para mantener la puerta de enlace en loopback con autenticación tailnet.\",\n   91\t      sessionTitle: \"Higiene de sesión\",\n   92\t      sessionText: \"Usa /new o sessions.patch para reiniciar el contexto.\",\n   93\t      cronTitle: \"Recordatorios de Cron\",\n   94\t      cronText: \"Usa sesiones aisladas para ejecuciones recurrentes.\",\n   95\t    },\n   96\t    auth: {\n   97\t      required:\n   98\t        \"Esta puerta de enlace requiere autenticación. Añade un token o contraseña y haz clic en Conectar.\",\n   99\t      failed:\n  100\t        \"Autenticación fallida. Vuelve a copiar una URL con token mediante {command}, o actualiza el token y haz clic en Conectar.\",\n  101\t    },\n  102\t    pairing: {\n  103\t      hint: \"Este dispositivo necesita aprobación de emparejamiento del host de la puerta de enlace.\",\n  104\t      mobileHint:\n  105\t        \"¿En el móvil? Copia la URL completa (incluyendo #token=...) desde openclaw dashboard --no-open en tu escritorio.\",\n  106\t    },\n  107\t    insecure: {\n  108\t      hint: \"Esta página es H