,\n      refreshing: \"Actualisation...\",\n      refresh: \"Actualiser\",\n    },\n    jobs: {\n      title: \"T√¢ches\",\n      subtitle: \"Toutes les t√¢ches planifi√©es stock√©es dans la passerelle.\",\n      shownOf: \"{shown} affich√©es sur {total}\",\n      searchJobs: \"Rechercher des t√¢ches\",\n      searchPlaceholder: \"Nom, description ou agent\",\n      enabled: \"Activ√©\",\n      schedule: \"Planification\",\n      lastRun: \"Derni√®re ex√©cution\",\n      all: \"Toutes\",\n      sort: \"Trier\",\n      nextRun: \"Prochaine ex√©cution\",\n      recentlyUpdated: \"R√©cemment mises √† jour\",\n      name: \"Nom\",\n      direction: \"Direction\",\n      ascending: \"Croissant\",\n      descending: \"D√©croissant\",\n      reset: \"R√©initialiser\",\n      noMatching: \"Aucune t√¢che correspondante.\",\n      loading: \"Chargement...\",\n      loadMore: \"Charger plus de t√¢ches\",\n    },\n    runs: {\n      title: \"Historique des ex√©cutions\",\n      subtitleAll: \"Derni√®res ex√©cutions de toutes les t√¢ches.\",\n      subtitleJob: \"Derni√®res ex√©cutions pour {title}.\",\n      scope: \"Port√©e\",\n      allJobs: \"Toutes les t√¢ches\",\n      selectedJob: \"T√¢che s√©lectionn√©e\",\n      searchRuns: \"Rechercher des ex√©cutions\",\n      searchPlaceholder: \"R√©sum√©, erreur ou t√¢che\",\n      newestFirst: \"Les plus r√©centes d'abord\",\n      oldestFirst: \"Les plus anciennes d'abord\",\n      status: \"Statut\",\n      delivery: \"Livraison\",\n      clear: \"Effacer\",\n      allStatuses: \"Tous les statuts\",\n      allDelivery: \"Toutes les livraisons\",\n      selectJobHint: \"S√©lectionnez une t√¢che pour inspecter l'historique des ex√©cutions.\",\n      noMatching: \"Aucune ex√©cution correspondante.\",\n      loadMore: \"Charger plus d'ex√©cutions\",\n      runStatusOk: \"OK\",\n      runStatusError: \"Erreur\",\n      runStatusSkipped: \"Ignor√©e\",\n      runStatusUnknown: \"Inconnu\",\n      deliveryDelivered: \"Livr√©\",\n      de