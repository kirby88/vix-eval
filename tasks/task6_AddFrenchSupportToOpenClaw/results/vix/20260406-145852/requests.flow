emente\",\n  153\t      name: \"Nombre\",\n  154\t      direction: \"Direcci√≥n\",\n  155\t      ascending: \"Ascendente\",\n  156\t      descending: \"Descendente\",\n  157\t      reset: \"Restablecer\",\n  158\t      noMatching: \"No hay tareas coincidentes.\",\n  159\t      loading: \"Cargando...\",\n  160\t      loadMore: \"Cargar m√°s tareas\",\n  161\t    },\n  162\t    runs: {\n  163\t      title: \"Historial de ejecuciones\",\n  164\t      subtitleAll: \"√öltimas ejecuciones de todas las tareas.\",\n  165\t      subtitleJob: \"√öltimas ejecuciones de {title}.\",\n  166\t      scope: \"Alcance\",\n  167\t      allJobs: \"Todas las tareas\",\n  168\t      selectedJob: \"Tarea seleccionada\",\n  169\t      searchRuns: \"Buscar ejecuciones\",\n  170\t      searchPlaceholder: \"Resumen, error o tarea\",\n  171\t      newestFirst: \"M√°s recientes primero\",\n  172\t      oldestFirst: \"M√°s antiguas primero\",\n  173\t      status: \"Estado\",\n  174\t      delivery: \"Entrega\",\n  175\t      clear: \"Limpiar\",\n  176\t      allStatuses: \"Todos los estados\",\n  177\t      allDelivery: \"Todas las entregas\",\n  178\t      selectJobHint: \"Selecciona una tarea para ver su historial de ejecuciones.\",\n  179\t      noMatching: \"No hay ejecuciones coincidentes.\",\n  180\t      loadMore: \"Cargar m√°s ejecuciones\",\n  181\t      runStatusOk: \"OK\",\n  182\t      runStatusError: \"Error\",\n  183\t      runStatusSkipped: \"Omitida\",\n  184\t      runStatusUnknown: \"Desconocido\",\n  185\t      deliveryDelivered: \"Entregado\",\n  186\t      deliveryNotDelivered: \"No entregado\",\n  187\t      deliveryUnknown: \"Desconocido\",\n  188\t      deliveryNotRequested: \"No solicitado\",\n  189\t    },\n  190\t    form: {\n  191\t      editJob: \"Editar tarea\",\n  192\t      newJob: \"Nueva tarea\",\n  193\t      updateSubtitle: \"Actualiza la tarea programada seleccionada.\",\n  194\t      createSubtitle: \"Crea una activaci√≥n programada o ejecuci√≥n de agente.\