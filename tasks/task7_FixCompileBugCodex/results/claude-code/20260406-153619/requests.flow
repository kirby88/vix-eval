or_dir.join(\"utils.c\").display()\n31\t    );\n32\t\n33\t    let target_os = env::var(\"CARGO_CFG_TARGET_OS\").unwrap_or_default();\n34\t    if target_os != \"linux\" {\n35\t        return;\n36\t    }\n37\t\n38\t    if let Err(err) = try_build_vendored_bwrap() {\n39\t        panic!(\"failed to compile vendored bubblewrap for Linux target: {err}\");\n40\t    }\n41\t}\n42\t\n43\tfn try_build_vendored_bwrap() -> Result<(), String> {\n44\t    let manifest_dir =\n45\t        PathBuf::from(env::var(\"CARGO_MANIFEST_DIR\").map_err(|err| err.to_string())?);\n46\t    let out_dir = PathBuf::from(env::var(\"OUT_DIR\").map_err(|err| err.to_string())?);\n47\t    let src_dir = resolve_bwrap_source_dir(&manifest_dir)?;\n48\t    let libcap = pkg_config::Config::new()\n49\t        .probe(\"libcap\")\n50\t        .map_err(|err| format!(\"libcap not available via pkg-config: {err}\"))?;\n51\t\n52\t    let config_h = out_dir.join(\"config.h\");\n53\t    std::fs::write(\n54\t        &config_h,\n55\t        r#\"#pragma once\n56\t#define PACKAGE_STRING \"bubblewrap built at codex build-time\"\n57\t\"#,\n58\t    )\n59\t    .map_err(|err| format!(\"failed to write {}: {err}\", config_h.display()))?;\n60\t\n61\t    let mut build = cc::Build::new();\n62\t    build\n63\t        .file(src_dir.join(\"bubblewrap.c\"))\n64\t        .file(src_dir.join(\"bind-mount.c\"))\n65\t        .file(src_dir.join(\"network.c\"))\n66\t        .file(src_dir.join(\"utils.c\"))\n67\t        .include(&out_dir)\n68\t        .include(&src_dir)\n69\t        .define(\"_GNU_SOURCE\", None)\n70\t        // Rename `main` so we can call it via FFI.\n71\t        .define(\"main\", Some(\"bwrap_main\"));\n72\t    for include_path in libcap.include_paths {\n73\t        // Use -idirafter so target sysroot headers win (musl cross builds),\n74\t        // while still allowing libcap headers from the host toolchain.\n75\t        build.flag(format!(\"-idirafter{}\", include_path.display()));\n76\t    }\n77\t\n78\t    build.compile